# Particle library. Arrays passed in are the caller's, so writes show up
# after the call. A scalar-or-array argument uses the number, or the cell at
# the current index when the argument is an array. Pass "none" where the
# Python command omitted an optional array or speed limit.

def verlet(v_x, v_y, v_ox, v_oy, v_active, v_ax, v_ay, v_damp, v_count) {
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_cx = v_x[v_i]
            v_cy = v_y[v_i]
            v_vx = (v_cx - v_ox[v_i]) * v_damp
            v_vy = (v_cy - v_oy[v_i]) * v_damp
            v_ox[v_i] = v_cx
            v_oy[v_i] = v_cy
            v_ax_i = v_ax
            if is_array(v_ax) then
                v_ax_i = v_ax[v_i]
            endif
            v_ay_i = v_ay
            if is_array(v_ay) then
                v_ay_i = v_ay[v_i]
            endif
            v_x[v_i] = v_cx + v_vx + v_ax_i
            v_y[v_i] = v_cy + v_vy + v_ay_i
        endif
    endfor v_i
}

def constrain_distances(v_x, v_y, v_active, v_from, v_to, v_rest, v_stiff, v_iters, v_tension, v_count, v_links, v_min) {
    if is_array(v_tension) then
        for v_link in (0, v_links - 1, 1)
            v_tension[v_link] = 0
        endfor v_link
    endif
    for v_pass in (1, int(v_iters), 1)
        for v_link in (0, v_links - 1, 1)
            v_i = int(v_from[v_link])
            v_j = int(v_to[v_link])
            v_move_i = v_active[v_i] != 0
            v_move_j = v_active[v_j] != 0
            if v_move_i or v_move_j then
                v_dx = v_x[v_j] - v_x[v_i]
                v_dy = v_y[v_j] - v_y[v_i]
                v_dsq = v_dx * v_dx + v_dy * v_dy
                v_min2 = v_min * v_min
                if v_dsq > v_min2 and v_dsq > 0.000000000001 then
                    v_dist = sqrt(v_dsq)
                    v_rest_i = v_rest
                    if is_array(v_rest) then
                        v_rest_i = v_rest[v_link]
                    endif
                    v_stiff_i = v_stiff
                    if is_array(v_stiff) then
                        v_stiff_i = v_stiff[v_link]
                    endif
                    v_ext = v_dist - v_rest_i
                    v_corr = v_ext / v_dist * v_stiff_i
                    v_mx = v_dx * v_corr
                    v_my = v_dy * v_corr
                    if v_move_i then
                        v_x[v_i] = v_x[v_i] + v_mx
                        v_y[v_i] = v_y[v_i] + v_my
                    endif
                    if v_move_j then
                        v_x[v_j] = v_x[v_j] - v_mx
                        v_y[v_j] = v_y[v_j] - v_my
                    endif
                    if is_array(v_tension) then
                        v_tension[v_link] = abs(v_ext)
                    endif
                endif
            endif
        endfor v_link
    endfor v_pass
}

def integrate(v_x, v_y, v_vx, v_vy, v_active, v_ax, v_ay, v_damp, v_sleep, v_count, v_mode, v_max, v_scale) {
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_ax_i = v_ax
            if is_array(v_ax) then
                v_ax_i = v_ax[v_i]
            endif
            v_ay_i = v_ay
            if is_array(v_ay) then
                v_ay_i = v_ay[v_i]
            endif
            v_vx[v_i] = v_vx[v_i] + v_ax_i
            v_vy[v_i] = v_vy[v_i] + v_ay_i
            if v_mode == "pre_move" then
                v_vx[v_i] = v_vx[v_i] * v_damp
                v_vy[v_i] = v_vy[v_i] * v_damp
            else
                v_x[v_i] = v_x[v_i] + v_vx[v_i] * v_scale
                v_y[v_i] = v_y[v_i] + v_vy[v_i] * v_scale
                v_vx[v_i] = v_vx[v_i] * v_damp
                v_vy[v_i] = v_vy[v_i] * v_damp
            endif
            if v_max != "none" then
                v_limit = v_max
                if is_array(v_max) then
                    v_limit = v_max[v_i]
                endif
                if v_vx[v_i] > v_limit then
                    v_vx[v_i] = v_limit
                endif
                if v_vx[v_i] < 0 - v_limit then
                    v_vx[v_i] = 0 - v_limit
                endif
                if v_vy[v_i] > v_limit then
                    v_vy[v_i] = v_limit
                endif
                if v_vy[v_i] < 0 - v_limit then
                    v_vy[v_i] = 0 - v_limit
                endif
            endif
            if v_mode == "pre_move" then
                v_x[v_i] = v_x[v_i] + v_vx[v_i] * v_scale
                v_y[v_i] = v_y[v_i] + v_vy[v_i] * v_scale
            endif
            if abs(v_vx[v_i]) < v_sleep then
                v_vx[v_i] = 0
            endif
            if abs(v_vy[v_i]) < v_sleep then
                v_vy[v_i] = 0
            endif
        endif
    endfor v_i
}

def apply_attractors(v_x, v_y, v_ax, v_ay, v_active, v_atx, v_aty, v_astr, v_pstr, v_falloff, v_soft, v_max, v_count, v_attractors, v_swirl) {
    v_soft2 = v_soft * v_soft
    v_exp = (v_falloff + 1) * 0.5
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_ps = v_pstr
            if is_array(v_pstr) then
                v_ps = v_pstr[v_i]
            endif
            for v_j in (0, v_attractors - 1, 1)
                v_dx = v_atx[v_j] - v_x[v_i]
                v_dy = v_aty[v_j] - v_y[v_i]
                v_dsq = v_dx * v_dx + v_dy * v_dy + v_soft2
                if v_dsq > 0.000000000001 then
                    v_astr_j = v_astr
                    if is_array(v_astr) then
                        v_astr_j = v_astr[v_j]
                    endif
                    v_scale = v_ps * v_astr_j / (v_dsq ** v_exp)
                    v_ax[v_i] = v_ax[v_i] + v_dx * v_scale
                    v_ay[v_i] = v_ay[v_i] + v_dy * v_scale
                    if v_swirl != 0 then
                        v_ax[v_i] = v_ax[v_i] - v_dy * v_scale * v_swirl
                        v_ay[v_i] = v_ay[v_i] + v_dx * v_scale * v_swirl
                    endif
                endif
            endfor v_j
            v_limit = v_max
            if is_array(v_max) then
                v_limit = v_max[v_i]
            endif
            v_msq = v_ax[v_i] * v_ax[v_i] + v_ay[v_i] * v_ay[v_i]
            if v_msq > v_limit * v_limit and v_msq > 0 then
                v_scale = v_limit / sqrt(v_msq)
                v_ax[v_i] = v_ax[v_i] * v_scale
                v_ay[v_i] = v_ay[v_i] * v_scale
            endif
        endif
    endfor v_i
}

def apply_springs(v_x, v_y, v_fx, v_fy, v_active, v_from, v_to, v_rest, v_stiff, v_tension, v_count, v_links) {
    if is_array(v_tension) then
        for v_link in (0, v_links - 1, 1)
            v_tension[v_link] = 0
        endfor v_link
    endif
    for v_link in (0, v_links - 1, 1)
        v_i = int(v_from[v_link])
        v_j = int(v_to[v_link])
        v_move_i = v_active[v_i] != 0
        v_move_j = v_active[v_j] != 0
        if v_move_i or v_move_j then
            v_dx = v_x[v_j] - v_x[v_i]
            v_dy = v_y[v_j] - v_y[v_i]
            v_dsq = v_dx * v_dx + v_dy * v_dy
            if v_dsq > 0.000000000001 then
                v_dist = sqrt(v_dsq)
                v_rest_i = v_rest
                if is_array(v_rest) then
                    v_rest_i = v_rest[v_link]
                endif
                v_stiff_i = v_stiff
                if is_array(v_stiff) then
                    v_stiff_i = v_stiff[v_link]
                endif
                v_force = v_stiff_i * (v_dist - v_rest_i)
                v_scale = v_force / v_dist
                v_mx = v_dx * v_scale
                v_my = v_dy * v_scale
                if v_move_i then
                    v_fx[v_i] = v_fx[v_i] + v_mx
                    v_fy[v_i] = v_fy[v_i] + v_my
                endif
                if v_move_j then
                    v_fx[v_j] = v_fx[v_j] - v_mx
                    v_fy[v_j] = v_fy[v_j] - v_my
                endif
                if is_array(v_tension) then
                    v_tension[v_link] = abs(v_force)
                endif
            endif
        endif
    endfor v_link
}

def flock(v_x, v_y, v_vx, v_vy, v_ax, v_ay, v_active, v_sep, v_near, v_sep_w, v_align_w, v_coh_w, v_max_speed, v_max_force, v_width, v_height, v_count) {
    v_sep2 = v_sep * v_sep
    v_near2 = v_near * v_near
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_sx = 0
            v_sy = 0
            v_lx = 0
            v_ly = 0
            v_cx = 0
            v_cy = 0
            v_sn = 0
            v_nn = 0
            for v_j in (0, v_count - 1, 1)
                if v_i != v_j and v_active[v_j] != 0 then
                    v_dx = v_x[v_j] - v_x[v_i]
                    v_dy = v_y[v_j] - v_y[v_i]
                    if v_width > 0 then
                        if v_dx > v_width * 0.5 then
                            v_dx = v_dx - v_width
                        endif
                        if v_dx < 0 - v_width * 0.5 then
                            v_dx = v_dx + v_width
                        endif
                    endif
                    if v_height > 0 then
                        if v_dy > v_height * 0.5 then
                            v_dy = v_dy - v_height
                        endif
                        if v_dy < 0 - v_height * 0.5 then
                            v_dy = v_dy + v_height
                        endif
                    endif
                    v_dsq = v_dx * v_dx + v_dy * v_dy
                    if v_dsq > 0.000000000001 then
                        if v_dsq < v_sep2 or v_dsq < v_near2 then
                            if v_dsq < v_sep2 then
                                v_inv = 1 / sqrt(v_dsq)
                                v_sx = v_sx - v_dx * v_inv
                                v_sy = v_sy - v_dy * v_inv
                                v_sn = v_sn + 1
                            endif
                            if v_dsq < v_near2 then
                                v_lx = v_lx + v_vx[v_j]
                                v_ly = v_ly + v_vy[v_j]
                                v_cx = v_cx + v_dx
                                v_cy = v_cy + v_dy
                                v_nn = v_nn + 1
                            endif
                        endif
                    endif
                endif
            endfor v_j
            v_tx = 0
            v_ty = 0
            if v_sn != 0 then
                v_dx = v_sx / v_sn
                v_dy = v_sy / v_sn
                v_msq = v_dx * v_dx + v_dy * v_dy
                v_fx = 0
                v_fy = 0
                if v_msq > 0.000000000001 then
                    v_scale = v_max_speed / sqrt(v_msq)
                    v_fx = v_dx * v_scale - v_vx[v_i]
                    v_fy = v_dy * v_scale - v_vy[v_i]
                    v_fsq = v_fx * v_fx + v_fy * v_fy
                    if v_fsq > v_max_force * v_max_force and v_fsq > 0 then
                        v_scale = v_max_force / sqrt(v_fsq)
                        v_fx = v_fx * v_scale
                        v_fy = v_fy * v_scale
                    endif
                endif
                v_tx = v_tx + v_fx * v_sep_w
                v_ty = v_ty + v_fy * v_sep_w
            endif
            if v_nn != 0 then
                v_dx = v_lx / v_nn
                v_dy = v_ly / v_nn
                v_msq = v_dx * v_dx + v_dy * v_dy
                v_fx = 0
                v_fy = 0
                if v_msq > 0.000000000001 then
                    v_scale = v_max_speed / sqrt(v_msq)
                    v_fx = v_dx * v_scale - v_vx[v_i]
                    v_fy = v_dy * v_scale - v_vy[v_i]
                    v_fsq = v_fx * v_fx + v_fy * v_fy
                    if v_fsq > v_max_force * v_max_force and v_fsq > 0 then
                        v_scale = v_max_force / sqrt(v_fsq)
                        v_fx = v_fx * v_scale
                        v_fy = v_fy * v_scale
                    endif
                endif
                v_tx = v_tx + v_fx * v_align_w
                v_ty = v_ty + v_fy * v_align_w
                v_dx = v_cx / v_nn
                v_dy = v_cy / v_nn
                v_msq = v_dx * v_dx + v_dy * v_dy
                v_fx = 0
                v_fy = 0
                if v_msq > 0.000000000001 then
                    v_scale = v_max_speed / sqrt(v_msq)
                    v_fx = v_dx * v_scale - v_vx[v_i]
                    v_fy = v_dy * v_scale - v_vy[v_i]
                    v_fsq = v_fx * v_fx + v_fy * v_fy
                    if v_fsq > v_max_force * v_max_force and v_fsq > 0 then
                        v_scale = v_max_force / sqrt(v_fsq)
                        v_fx = v_fx * v_scale
                        v_fy = v_fy * v_scale
                    endif
                endif
                v_tx = v_tx + v_fx * v_coh_w
                v_ty = v_ty + v_fy * v_coh_w
            endif
            v_ax[v_i] = v_ax[v_i] + v_tx
            v_ay[v_i] = v_ay[v_i] + v_ty
        endif
    endfor v_i
}

def collide_bounds(v_x, v_y, v_vx, v_vy, v_active, v_left, v_right, v_top, v_bottom, v_rest, v_radius, v_hit, v_count) {
    if is_array(v_hit) then
        for v_i in (0, v_count - 1, 1)
            v_hit[v_i] = 0
        endfor v_i
    endif
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_bounce = v_rest
            if is_array(v_rest) then
                v_bounce = v_rest[v_i]
            endif
            v_r = v_radius
            if is_array(v_radius) then
                v_r = v_radius[v_i]
            endif
            v_lo_x = v_left + v_r
            v_hi_x = v_right - v_r
            v_lo_y = v_top + v_r
            v_hi_y = v_bottom - v_r
            if v_hi_x < v_lo_x then
                v_lo_x = (v_left + v_right) * 0.5
                v_hi_x = v_lo_x
            endif
            if v_hi_y < v_lo_y then
                v_lo_y = (v_top + v_bottom) * 0.5
                v_hi_y = v_lo_y
            endif
            v_hit_i = 0
            if v_x[v_i] < v_lo_x then
                v_x[v_i] = v_lo_x
                v_vx[v_i] = abs(v_vx[v_i]) * v_bounce
                v_hit_i = 1
            else
                if v_x[v_i] > v_hi_x then
                    v_x[v_i] = v_hi_x
                    v_vx[v_i] = 0 - abs(v_vx[v_i]) * v_bounce
                    v_hit_i = 1
                endif
            endif
            if v_y[v_i] < v_lo_y then
                v_y[v_i] = v_lo_y
                v_vy[v_i] = abs(v_vy[v_i]) * v_bounce
                v_hit_i = 1
            else
                if v_y[v_i] > v_hi_y then
                    v_y[v_i] = v_hi_y
                    v_vy[v_i] = 0 - abs(v_vy[v_i]) * v_bounce
                    v_hit_i = 1
                endif
            endif
            if v_hit_i != 0 and is_array(v_hit) then
                v_hit[v_i] = 1
            endif
        endif
    endfor v_i
}

def collide_circle_bounds(v_x, v_y, v_vx, v_vy, v_active, v_cx, v_cy, v_outer, v_rest, v_radius, v_omega, v_grip, v_hit, v_count) {
    if is_array(v_hit) then
        for v_i in (0, v_count - 1, 1)
            v_hit[v_i] = 0
        endfor v_i
    endif
    v_bound = v_outer
    if v_bound < 0 then
        v_bound = 0
    endif
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_bounce = v_rest
            if is_array(v_rest) then
                v_bounce = v_rest[v_i]
            endif
            v_r = v_radius
            if is_array(v_radius) then
                v_r = v_radius[v_i]
            endif
            v_limit = v_bound - v_r
            if v_limit < 0 then
                v_limit = 0
            endif
            v_rx = v_x[v_i] - v_cx
            v_ry = v_y[v_i] - v_cy
            v_dsq = v_rx * v_rx + v_ry * v_ry
            if v_dsq > v_limit * v_limit then
                if v_dsq <= 0.000000000001 then
                    v_nx = 1
                    v_ny = 0
                else
                    v_dist = sqrt(v_dsq)
                    v_nx = v_rx / v_dist
                    v_ny = v_ry / v_dist
                endif
                v_x[v_i] = v_cx + v_nx * v_limit
                v_y[v_i] = v_cy + v_ny * v_limit
                v_normal = v_vx[v_i] * v_nx + v_vy[v_i] * v_ny
                if v_normal > 0 then
                    v_vx[v_i] = v_vx[v_i] - v_nx * v_normal * (1 + v_bounce)
                    v_vy[v_i] = v_vy[v_i] - v_ny * v_normal * (1 + v_bounce)
                endif
                if v_grip != 0 and v_omega != 0 then
                    v_tx = 0 - v_ny
                    v_ty = v_nx
                    v_tangent = v_vx[v_i] * v_tx + v_vy[v_i] * v_ty
                    v_delta = (v_omega * v_limit - v_tangent) * v_grip
                    v_vx[v_i] = v_vx[v_i] + v_tx * v_delta
                    v_vy[v_i] = v_vy[v_i] + v_ty * v_delta
                endif
                if is_array(v_hit) then
                    v_hit[v_i] = 1
                endif
            endif
        endif
    endfor v_i
}

def collide_circles(v_x, v_y, v_vx, v_vy, v_active, v_radius, v_mass, v_rest, v_hit, v_count) {
    if is_array(v_hit) then
        for v_i in (0, v_count - 1, 1)
            v_hit[v_i] = 0
        endfor v_i
    endif
    v_go = 1
    if not is_array(v_mass) and v_mass <= 0 then
        v_go = 0
    endif
    if v_go then
        for v_i in (0, v_count - 2, 1)
            v_use_i = v_active[v_i] != 0
            if v_use_i and is_array(v_mass) and v_mass[v_i] <= 0 then
                v_use_i = 0
            endif
            if v_use_i then
                v_ri = v_radius
                if is_array(v_radius) then
                    v_ri = v_radius[v_i]
                endif
                v_bi = v_rest
                if is_array(v_rest) then
                    v_bi = v_rest[v_i]
                endif
                v_inv_i = 0
                if is_array(v_mass) then
                    v_inv_i = 1 / v_mass[v_i]
                else
                    v_inv_i = 1 / v_mass
                endif
                v_speed_i = abs(v_vx[v_i]) + abs(v_vy[v_i])
                for v_j in (v_i + 1, v_count - 1, 1)
                    v_use_j = v_active[v_j] != 0
                    if v_use_j and is_array(v_mass) and v_mass[v_j] <= 0 then
                        v_use_j = 0
                    endif
                    if v_use_j then
                        v_rj = v_radius
                        if is_array(v_radius) then
                            v_rj = v_radius[v_j]
                        endif
                        v_min = v_ri + v_rj
                        v_dx = v_x[v_j] - v_x[v_i]
                        v_dy = v_y[v_j] - v_y[v_i]
                        if v_dx < v_min and v_dx > 0 - v_min and v_dy < v_min and v_dy > 0 - v_min then
                            v_dsq = v_dx * v_dx + v_dy * v_dy
                            if v_dsq < v_min * v_min then
                                if is_array(v_hit) then
                                    v_hit[v_i] = 1
                                    v_hit[v_j] = 1
                                endif
                                if v_dsq <= 0.000000000001 then
                                    v_nx = 1
                                    v_ny = 0
                                    v_dist = 0
                                else
                                    v_dist = sqrt(v_dsq)
                                    v_nx = v_dx / v_dist
                                    v_ny = v_dy / v_dist
                                endif
                                v_overlap = v_min - v_dist
                                if is_array(v_mass) then
                                    v_inv_j = 1 / v_mass[v_j]
                                else
                                    v_inv_j = 1 / v_mass
                                endif
                                v_inv_sum = v_inv_i + v_inv_j
                                if v_inv_sum > 0 then
                                    v_corr_i = v_overlap * (v_inv_i / v_inv_sum)
                                    v_corr_j = v_overlap * (v_inv_j / v_inv_sum)
                                    v_x[v_i] = v_x[v_i] - v_nx * v_corr_i
                                    v_y[v_i] = v_y[v_i] - v_ny * v_corr_i
                                    v_x[v_j] = v_x[v_j] + v_nx * v_corr_j
                                    v_y[v_j] = v_y[v_j] + v_ny * v_corr_j
                                    if v_speed_i + abs(v_vx[v_j]) + abs(v_vy[v_j]) != 0 then
                                        v_rel = (v_vx[v_j] - v_vx[v_i]) * v_nx + (v_vy[v_j] - v_vy[v_i]) * v_ny
                                        if v_rel < 0 then
                                            v_bj = v_rest
                                            if is_array(v_rest) then
                                                v_bj = v_rest[v_j]
                                            endif
                                            v_bounce = v_bi
                                            if v_bj < v_bi then
                                                v_bounce = v_bj
                                            endif
                                            v_impulse = 0 - (1 + v_bounce) * v_rel / v_inv_sum
                                            v_vx[v_i] = v_vx[v_i] - v_impulse * v_inv_i * v_nx
                                            v_vy[v_i] = v_vy[v_i] - v_impulse * v_inv_i * v_ny
                                            v_vx[v_j] = v_vx[v_j] + v_impulse * v_inv_j * v_nx
                                            v_vy[v_j] = v_vy[v_j] + v_impulse * v_inv_j * v_ny
                                        endif
                                    endif
                                endif
                            endif
                        endif
                    endif
                endfor v_j
            endif
        endfor v_i
    endif
}

def collide_static_circles(v_x, v_y, v_vx, v_vy, v_active, v_ox, v_oy, v_radius, v_oradius, v_rest, v_hit, v_count, v_obstacles, v_response) {
    if is_array(v_hit) then
        for v_i in (0, v_count - 1, 1)
            v_hit[v_i] = 0
        endfor v_i
    endif
    for v_i in (0, v_count - 1, 1)
        if v_active[v_i] != 0 then
            v_bounce = v_rest
            if is_array(v_rest) then
                v_bounce = v_rest[v_i]
            endif
            v_pr = v_radius
            if is_array(v_radius) then
                v_pr = v_radius[v_i]
            endif
            for v_j in (0, v_obstacles - 1, 1)
                v_or = v_oradius
                if is_array(v_oradius) then
                    v_or = v_oradius[v_j]
                endif
                v_min = v_pr + v_or
                v_dx = v_x[v_i] - v_ox[v_j]
                v_dy = v_y[v_i] - v_oy[v_j]
                if abs(v_dx) < v_min and abs(v_dy) < v_min then
                    v_dsq = v_dx * v_dx + v_dy * v_dy
                    if v_dsq < v_min * v_min then
                        if is_array(v_hit) then
                            v_hit[v_i] = 1
                        endif
                        if v_dsq <= 0.000000000001 then
                            v_speed = sqrt(v_vx[v_i] * v_vx[v_i] + v_vy[v_i] * v_vy[v_i])
                            if v_speed > 0.000000000001 then
                                v_nx = 0 - v_vx[v_i] / v_speed
                                v_ny = 0 - v_vy[v_i] / v_speed
                            else
                                v_nx = 1
                                v_ny = 0
                            endif
                        else
                            v_dist = sqrt(v_dsq)
                            v_nx = v_dx / v_dist
                            v_ny = v_dy / v_dist
                        endif
                        v_x[v_i] = v_ox[v_j] + v_nx * v_min
                        v_y[v_i] = v_oy[v_j] + v_ny * v_min
                        v_normal = v_vx[v_i] * v_nx + v_vy[v_i] * v_ny
                        if v_response == "reflect" then
                            v_vx[v_i] = (v_vx[v_i] - 2 * v_normal * v_nx) * v_bounce
                            v_vy[v_i] = (v_vy[v_i] - 2 * v_normal * v_ny) * v_bounce
                        else
                            if v_normal < 0 then
                                v_vx[v_i] = v_vx[v_i] - v_nx * v_normal * (1 + v_bounce)
                                v_vy[v_i] = v_vy[v_i] - v_ny * v_normal * (1 + v_bounce)
                            endif
                        endif
                    endif
                endif
            endfor v_j
        endif
    endfor v_i
}
