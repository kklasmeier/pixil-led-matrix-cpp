# Ink in water. Reads and writes the script's own arrays and colors, and
# plots each living drop. Call it inside a frame.

def step {
    v_any_alive = 0
    for v_i in (0, v_num_particles - 1, 1)
        if v_alive[v_i] > 0 then
            v_dx = v_px[v_i] - v_drop_x
            v_dy = v_py[v_i] - v_drop_y
            v_ivx = v_vx[v_i] * 0.98 + v_curve_x[v_i] + v_drift_x
            v_ivy = v_vy[v_i] * 0.98 + v_curve_y[v_i] + v_drift_y
            if v_swirl_active >= 1 then
                v_ivx = v_ivx + v_dy * v_swirl_strength * v_swirl_dir * (0 - 1)
                v_ivy = v_ivy + v_dx * v_swirl_strength * v_swirl_dir
            endif
            v_nx = v_px[v_i] + v_ivx
            v_ny = v_py[v_i] + v_ivy
            v_inten = v_intensity[v_i] - v_fade_rate
            v_vx[v_i] = v_ivx
            v_vy[v_i] = v_ivy
            v_px[v_i] = v_nx
            v_py[v_i] = v_ny
            if v_inten <= 0 then
                v_alive[v_i] = 0
                v_intensity[v_i] = 0
            else
                v_alive[v_i] = 1
                v_intensity[v_i] = v_inten
                v_any_alive = 1
                v_di = int(v_inten)
                if v_di > 60 then
                    v_color = v_color_bright
                    v_pi = v_di
                elseif v_di > 30 then
                    v_color = v_color_mid
                    v_pi = v_di + 20
                else
                    v_color = v_color_dark
                    v_pi = v_di + 30
                endif
                if v_pi < 0 then
                    v_pi = 0
                endif
                if v_pi > 100 then
                    v_pi = 100
                endif
                mplot(int(v_nx), int(v_ny), v_color, v_pi)
            endif
        endif
    endfor v_i
}
