# Sprite Transforms Demo
# Walks through every transform command with an on-screen label so you can
# verify scale, flip, angle, tilt, back cel, anchor, reset, and combined
# set_sprite_transform on the panel.
#
# HUD lives on layer 50 (redrawn each frame). Demo sprite on layer 10.

fps(30)
throttle(0)

v_pace = 1.0
v_hold = 100          # frames per section (~3.3s at 30fps)
v_hold_long = 220     # longer hold for scale+move (~7.3s)
v_this_hold = 100
v_phase = 0
v_t = 0
v_nphase = 14         # number of demo sections (0 .. 13)

# --- Art: arrow (points right), card front/back, coin ---
define_sprite(arrow, 11, 7)
    draw_rectangle(0, 2, 7, 3, sky_blue, 100, true)
    plot(7, 1, sky_blue, 100)
    plot(7, 2, sky_blue, 100)
    plot(7, 3, sky_blue, 100)
    plot(7, 4, sky_blue, 100)
    plot(7, 5, sky_blue, 100)
    plot(8, 2, cyan, 100)
    plot(8, 3, cyan, 100)
    plot(8, 4, cyan, 100)
    plot(9, 3, white, 100)
    plot(1, 3, navy, 100)
endsprite

define_sprite(card, 10, 14)
    sprite_cel(0)
        # Front: red face with a white "pip" corner
        draw_rectangle(0, 0, 10, 14, white, 100, true)
        draw_rectangle(1, 1, 8, 12, red, 90, true)
        plot(2, 2, white, 100)
        plot(2, 3, white, 100)
        plot(3, 2, white, 100)
        plot(7, 10, white, 100)
        plot(7, 11, white, 100)
        plot(6, 11, white, 100)
        # Simple A mark in the middle
        plot(4, 5, white, 100)
        plot(5, 5, white, 100)
        plot(3, 6, white, 100)
        plot(6, 6, white, 100)
        plot(3, 7, white, 100)
        plot(4, 7, white, 100)
        plot(5, 7, white, 100)
        plot(6, 7, white, 100)
        plot(3, 8, white, 100)
        plot(6, 8, white, 100)
    sprite_cel(1)
        # Back: navy pattern (shown via sprite_back_cel when reversed)
        draw_rectangle(0, 0, 10, 14, navy, 100, true)
        draw_rectangle(1, 1, 8, 12, blue, 80, true)
        plot(2, 2, cyan, 100)
        plot(7, 2, cyan, 100)
        plot(2, 11, cyan, 100)
        plot(7, 11, cyan, 100)
        draw_line(2, 4, 7, 9, cyan, 70)
        draw_line(7, 4, 2, 9, cyan, 70)
endsprite
sprite_back_cel(card, 1)

define_sprite(coin, 9, 9)
    sprite_cel(0)
        draw_circle(4, 4, 4, gold, 100, true)
        draw_circle(4, 4, 3, yellow, 90, true)
        plot(4, 4, orange, 100)
    sprite_cel(1)
        draw_circle(4, 4, 4, silver, 100, true)
        draw_circle(4, 4, 3, gray, 90, true)
        plot(3, 3, white, 100)
        plot(5, 5, white, 100)
endsprite
sprite_back_cel(coin, 1)

# Marker pixel so stretch/flip direction is obvious
define_sprite(mark, 8, 8)
    draw_rectangle(0, 0, 8, 8, green, 80, true)
    draw_rectangle(0, 0, 3, 3, lime, 100, true)
    plot(7, 0, red, 100)
    plot(0, 7, blue, 100)
endsprite

# Show instances once; phases only change transforms / which is visible
set_layer(10)
show_sprite(arrow, 32, 34, 0, 0, 0)
show_sprite(card, 32, 34, 0, 0, 0)
show_sprite(coin, 32, 34, 0, 0, 0)
show_sprite(mark, 32, 34, 0, 0, 0)
hide_sprite(card, 0)
hide_sprite(coin, 0)
hide_sprite(mark, 0)
set_sprite_anchor(arrow, 1, 0)
set_sprite_anchor(card, 1, 0)
set_sprite_anchor(coin, 1, 0)
set_sprite_anchor(mark, 1, 0)

def hide_all {
    hide_sprite(arrow, 0)
    hide_sprite(card, 0)
    hide_sprite(coin, 0)
    hide_sprite(mark, 0)
}

def show_arrow {
    call hide_all
    show_sprite(arrow, 32, 34, 0, 0, 0)
    set_sprite_anchor(arrow, 1, 0)
}

def show_card {
    call hide_all
    show_sprite(card, 32, 34, 0, 0, 0)
    set_sprite_anchor(card, 1, 0)
}

def show_coin {
    call hide_all
    show_sprite(coin, 32, 34, 0, 0, 0)
    set_sprite_anchor(coin, 1, 0)
}

def show_mark {
    call hide_all
    show_sprite(mark, 32, 34, 0, 0, 0)
    set_sprite_anchor(mark, 1, 0)
}

while true then
    begin_frame
        # ---- HUD label (layer 50) ----
        clear_layer(50)
        set_layer(50)
        draw_rectangle(0, 0, 64, 12, black, 70, true)

        if v_phase == 0 then
            draw_text(1, 1, "1 scale", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_scale", tiny64_font, 5, white, 90)
        elseif v_phase == 1 then
            draw_text(1, 1, "2 stretch", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "scale + scale_y", tiny64_font, 5, white, 90)
        elseif v_phase == 2 then
            draw_text(1, 1, "3 flip H", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_flip 1", tiny64_font, 5, white, 90)
        elseif v_phase == 3 then
            draw_text(1, 1, "4 flip V", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_flip 2", tiny64_font, 5, white, 90)
        elseif v_phase == 4 then
            draw_text(1, 1, "5 flip HV", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_flip 3", tiny64_font, 5, white, 90)
        elseif v_phase == 5 then
            draw_text(1, 1, "6 angle +", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_angle CW", tiny64_font, 5, white, 90)
        elseif v_phase == 6 then
            draw_text(1, 1, "7 angle -", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_angle CCW", tiny64_font, 5, white, 90)
        elseif v_phase == 7 then
            draw_text(1, 1, "8 tilt_y", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_tilt card", tiny64_font, 5, white, 90)
        elseif v_phase == 8 then
            draw_text(1, 1, "9 back_cel", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "sprite_back_cel", tiny64_font, 5, white, 90)
        elseif v_phase == 9 then
            draw_text(1, 1, "10 tilt_x", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "tip forward/back", tiny64_font, 5, white, 90)
        elseif v_phase == 10 then
            draw_text(1, 1, "11 edge-on", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "tilt_y near 90", tiny64_font, 5, white, 90)
        elseif v_phase == 11 then
            draw_text(1, 1, "12 transform", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "set_sprite_transform", tiny64_font, 5, white, 90)
        elseif v_phase == 12 then
            draw_text(1, 1, "13 reset", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "reset keeps anchor", tiny64_font, 5, white, 90)
        else
            draw_text(1, 1, "14 scale+move", tiny64_font, 5, yellow, 100)
            draw_text(1, 7, "zoom while drifting", tiny64_font, 5, white, 90)
        endif

        # ---- Drive the active demo ----
        v_this_hold = v_hold
        if v_phase == 13 then
            v_this_hold = v_hold_long
        endif
        v_u = v_t / v_this_hold
        if v_u > 1 then
            v_u = 1
        endif

        if v_phase == 0 then
            # scale 0.3 → 3.0 → 0.3
            call show_arrow
            reset_sprite_transform(arrow, 0)
            set_sprite_anchor(arrow, 1, 0)
            v_s = 0.3 + abs(sin(v_t * 0.08)) * 2.7
            set_sprite_scale(arrow, v_s, 0)
            move_sprite(arrow, 32, 34, 0)

        elseif v_phase == 1 then
            call show_mark
            reset_sprite_transform(mark, 0)
            set_sprite_anchor(mark, 1, 0)
            v_sx = 1.0 + sin(v_t * 0.1) * 0.8
            v_sy = 1.0 + cos(v_t * 0.1) * 0.8
            set_sprite_scale(mark, v_sx, 0, v_sy)
            move_sprite(mark, 32, 34, 0)

        elseif v_phase == 2 then
            call show_arrow
            reset_sprite_transform(arrow, 0)
            set_sprite_anchor(arrow, 1, 0)
            if int(v_t / 20) % 2 == 0 then
                set_sprite_flip(arrow, 0, 0)
            else
                set_sprite_flip(arrow, 1, 0)
            endif
            move_sprite(arrow, 32, 34, 0)

        elseif v_phase == 3 then
            call show_mark
            reset_sprite_transform(mark, 0)
            set_sprite_anchor(mark, 1, 0)
            if int(v_t / 20) % 2 == 0 then
                set_sprite_flip(mark, 0, 0)
            else
                set_sprite_flip(mark, 2, 0)
            endif
            move_sprite(mark, 32, 34, 0)

        elseif v_phase == 4 then
            call show_mark
            reset_sprite_transform(mark, 0)
            set_sprite_anchor(mark, 1, 0)
            if int(v_t / 20) % 2 == 0 then
                set_sprite_flip(mark, 0, 0)
            else
                set_sprite_flip(mark, 3, 0)
            endif
            move_sprite(mark, 32, 34, 0)

        elseif v_phase == 5 then
            call show_arrow
            reset_sprite_transform(arrow, 0)
            set_sprite_anchor(arrow, 1, 0)
            set_sprite_angle(arrow, v_t * 4, 0)
            move_sprite(arrow, 32, 34, 0)

        elseif v_phase == 6 then
            call show_arrow
            reset_sprite_transform(arrow, 0)
            set_sprite_anchor(arrow, 1, 0)
            set_sprite_angle(arrow, 0 - v_t * 4, 0)
            move_sprite(arrow, 32, 34, 0)

        elseif v_phase == 7 then
            # Card tips left/right (front only until past 90)
            call show_card
            reset_sprite_transform(card, 0)
            set_sprite_anchor(card, 1, 0)
            v_ty = sin(v_t * 0.06) * 80
            set_sprite_tilt(card, 0, v_ty, 0)
            move_sprite(card, 32, 34, 0)

        elseif v_phase == 8 then
            # Full flip through back cel (navy/cyan pattern)
            call show_card
            reset_sprite_transform(card, 0)
            set_sprite_anchor(card, 1, 0)
            v_ty = v_t * 3
            set_sprite_tilt(card, 0, v_ty, 0)
            move_sprite(card, 32, 34, 0)

        elseif v_phase == 9 then
            call show_card
            reset_sprite_transform(card, 0)
            set_sprite_anchor(card, 1, 0)
            v_tx = sin(v_t * 0.06) * 80
            set_sprite_tilt(card, v_tx, 0, 0)
            move_sprite(card, 32, 34, 0)

        elseif v_phase == 10 then
            # Coin wobbles through edge-on so the sliver flashes
            call show_coin
            reset_sprite_transform(coin, 0)
            set_sprite_anchor(coin, 1, 0)
            set_sprite_tilt(coin, sin(v_t * 0.05) * 25, v_t * 6, 0)
            set_sprite_angle(coin, sin(v_t * 0.04) * 20, 0)
            move_sprite(coin, 32, 34, 0)

        elseif v_phase == 11 then
            call show_arrow
            set_sprite_anchor(arrow, 1, 0)
            v_s = 0.8 + abs(sin(v_t * 0.07)) * 1.2
            set_sprite_transform(arrow, v_s, v_t * 5, 0, 0, sin(v_t * 0.05) * 40, 0)
            move_sprite(arrow, 32, 34, 0)

        elseif v_phase == 12 then
            # Spin+scale, then reset mid-section — anchor stays centre
            call show_arrow
            set_sprite_anchor(arrow, 1, 0)
            if v_t < v_hold / 2 then
                set_sprite_transform(arrow, 2.0, v_t * 8, 0, 0, 0, 1)
            else
                reset_sprite_transform(arrow, 0)
            endif
            move_sprite(arrow, 32, 34, 0)

        else
            # Zoom in/out while drifting — proves scale + fractional move together
            call show_coin
            reset_sprite_transform(coin, 0)
            set_sprite_anchor(coin, 1, 0)
            v_s = 0.4 + abs(sin(v_t * 0.05)) * 2.6
            set_sprite_scale(coin, v_s, 0)
            v_x = 32 + sin(v_t * 0.04) * 14
            v_y = 34 + cos(v_t * 0.035) * 10
            move_sprite(coin, v_x, v_y, 0)
        endif

        # Phase counter in the corner
        set_layer(50)
        draw_text(50, 58, v_phase + 1, tiny64_font, 5, gray, 80)
        draw_text(56, 58, "/", tiny64_font, 5, gray, 60)
        draw_text(59, 58, v_nphase, tiny64_font, 5, gray, 80)

    end_frame

    v_t = v_t + 1
    if v_t >= v_this_hold then
        v_t = 0
        v_phase = v_phase + 1
        if v_phase >= v_nphase then
            v_phase = 0
        endif
    endif
endwhile
