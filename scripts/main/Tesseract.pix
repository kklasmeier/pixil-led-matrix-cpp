# Tesseract - a 4D hypercube turning through the fourth dimension
#
# A tesseract has 16 corners and 32 edges. Here it rotates in planes that
# involve the fourth axis (w), something no 3D object can do. Seen in our
# 3D world, the small "inner" cube swells, slides out through the big outer
# cube and turns the whole shape inside out, again and again, while the
# result also tumbles slowly in ordinary 3D.
#
#   - Edges are coloured by their 4D depth: the part of the hypercube that
#     is "far away" in w is drawn small and cool, the near part big and warm.
#     The colours drift slowly around the spectrum.
#   - Brightness follows 3D depth, so the near side of the shape glows.
#   - Every frame is drawn with a short fading burnout, leaving soft motion
#     ghosts behind the moving edges.
#   - The motion cycles through phases: a pure XW turn (the classic
#     inside-out), a double rotation in two planes at once, and a three-plane
#     spin. Phases blend smoothly into each other.
#
# How it works: rotate each 4D corner in the XW / YW / ZW planes, project 4D
# to 3D with perspective (divide by distance in w), tumble in 3D, then
# project 3D to the panel. Only 16 points and 32 lines a frame.

fps(60)
throttle(0)

# ---------------- Settings ----------------
v_d4 = 3.2             # 4D camera distance (smaller = stronger inside-out)
v_d3 = 7               # 3D camera distance
v_scale = 9.5          # overall size on the panel
v_ghost_ms = 260       # length of the fading motion ghosts
v_dot_ms = 120         # corner dots fade a little faster
v_phase_frames = 900   # frames per motion phase (~15 s at 60 fps)
v_blend_frames = 180   # frames to blend between phases

# ---------------- Geometry ----------------
create_array(v_vx, 16, numeric)
create_array(v_vy, 16, numeric)
create_array(v_vz, 16, numeric)
create_array(v_vw, 16, numeric)
create_array(v_px, 16, numeric)
create_array(v_py, 16, numeric)
create_array(v_pz, 16, numeric)
create_array(v_pw, 16, numeric)
create_array(v_ea, 32, numeric)
create_array(v_eb, 32, numeric)

# Corner i: bit 0 -> x, bit 1 -> y, bit 2 -> z, bit 3 -> w (each +/-1)
for v_i in (0, 15, 1)
    v_vx[v_i] = (v_i % 2) * 2 - 1
    v_vy[v_i] = (floor(v_i / 2) % 2) * 2 - 1
    v_vz[v_i] = (floor(v_i / 4) % 2) * 2 - 1
    v_vw[v_i] = (floor(v_i / 8) % 2) * 2 - 1
endfor v_i

# Edges join corners that differ in exactly one bit
v_e = 0
for v_i in (0, 15, 1)
    v_bit = 1
    for v_b in (0, 3, 1)
        if floor(v_i / v_bit) % 2 == 0 then
            v_ea[v_e] = v_i
            v_eb[v_e] = v_i + v_bit
            v_e = v_e + 1
        endif
        v_bit = v_bit * 2
    endfor v_b
endfor v_i

# ---------------- Motion phases ----------------
# Speeds (radians per frame) for the XW, YW, ZW and YZ planes, per phase.
create_array(v_ph_xw, 3, numeric)
create_array(v_ph_yw, 3, numeric)
create_array(v_ph_zw, 3, numeric)
create_array(v_ph_yz, 3, numeric)
v_ph_xw[0] = 0.016
v_ph_yw[0] = 0
v_ph_zw[0] = 0
v_ph_yz[0] = 0.002
v_ph_xw[1] = 0.012
v_ph_yw[1] = 0
v_ph_zw[1] = 0
v_ph_yz[1] = 0.012
v_ph_xw[2] = 0.009
v_ph_yw[2] = 0.006
v_ph_zw[2] = 0.011
v_ph_yz[2] = 0.003

v_a_xw = 0
v_a_yw = 0
v_a_zw = 0
v_a_yz = 0.35
v_tumble_y = 0
v_tumble_x = 0.45
v_hue = 55
v_frame = 0

def project_all {
    v_cxw = cos(v_a_xw)
    v_sxw = sin(v_a_xw)
    v_cyw = cos(v_a_yw)
    v_syw = sin(v_a_yw)
    v_czw = cos(v_a_zw)
    v_szw = sin(v_a_zw)
    v_cyz = cos(v_a_yz)
    v_syz = sin(v_a_yz)
    v_cty = cos(v_tumble_y)
    v_sty = sin(v_tumble_y)
    v_ctx = cos(v_tumble_x)
    v_stx = sin(v_tumble_x)
    for v_i in (0, 15, 1)
        v_x = v_vx[v_i]
        v_y = v_vy[v_i]
        v_z = v_vz[v_i]
        v_w = v_vw[v_i]
        # 4D rotations
        v_t1 = v_x * v_cxw - v_w * v_sxw
        v_w = v_x * v_sxw + v_w * v_cxw
        v_x = v_t1
        v_t1 = v_y * v_cyw - v_w * v_syw
        v_w = v_y * v_syw + v_w * v_cyw
        v_y = v_t1
        v_t1 = v_z * v_czw - v_w * v_szw
        v_w = v_z * v_szw + v_w * v_czw
        v_z = v_t1
        v_t1 = v_y * v_cyz - v_z * v_syz
        v_z = v_y * v_syz + v_z * v_cyz
        v_y = v_t1
        # 4D -> 3D perspective
        v_f = v_d4 / (v_d4 - v_w)
        v_x = v_x * v_f
        v_y = v_y * v_f
        v_z = v_z * v_f
        # slow 3D tumble (around y, then x)
        v_t1 = v_x * v_cty + v_z * v_sty
        v_z = v_z * v_cty - v_x * v_sty
        v_x = v_t1
        v_t1 = v_y * v_ctx - v_z * v_stx
        v_z = v_y * v_stx + v_z * v_ctx
        v_y = v_t1
        # 3D -> panel
        v_f = v_scale * v_d3 / max(v_d3 - v_z, 1)
        v_px[v_i] = 31.5 + v_x * v_f
        v_py[v_i] = 31.5 + v_y * v_f
        v_pz[v_i] = v_z
        v_pw[v_i] = v_w
    endfor v_i
}

def draw_all {
    for v_e in (0, 31, 1)
        v_a = v_ea[v_e]
        v_b = v_eb[v_e]
        v_w = (v_pw[v_a] + v_pw[v_b]) * 0.5
        v_z = (v_pz[v_a] + v_pz[v_b]) * 0.5
        v_col = int(v_hue + v_w * 11 + 200) % 100
        v_bri = 38 + (v_w + 2) * 9 + v_z * 7
        v_bri = min(max(v_bri, 12), 100)
        draw_line(v_px[v_a], v_py[v_a], v_px[v_b], v_py[v_b], v_col, v_bri, v_ghost_ms, fade)
    endfor v_e
    # corners: bright white points, larger when close
    for v_i in (0, 15, 1)
        v_x = round(v_px[v_i])
        v_y = round(v_py[v_i])
        v_bri = min(max(60 + v_pz[v_i] * 12 + v_pw[v_i] * 8, 25), 100)
        mplot(v_x, v_y, white, v_bri, v_dot_ms, fade)
        if v_pz[v_i] + v_pw[v_i] * 0.5 > 0.6 then
            v_glow = v_bri * 0.45
            mplot(v_x + 1, v_y, white, v_glow, v_dot_ms, fade)
            mplot(v_x - 1, v_y, white, v_glow, v_dot_ms, fade)
            mplot(v_x, v_y + 1, white, v_glow, v_dot_ms, fade)
            mplot(v_x, v_y - 1, white, v_glow, v_dot_ms, fade)
        endif
    endfor v_i
}

# ---------------- Main loop ----------------
while true then
    # which phase are we in, and how far into the blend to the next one
    v_cycle = floor(v_frame / v_phase_frames)
    v_p0 = v_cycle % 3
    v_p1 = (v_cycle + 1) % 3
    v_into = v_frame - v_cycle * v_phase_frames
    v_mix = max(0, (v_into - (v_phase_frames - v_blend_frames)) / v_blend_frames)
    v_mix = v_mix * v_mix * (3 - 2 * v_mix)
    v_a_xw = v_a_xw + v_ph_xw[v_p0] * (1 - v_mix) + v_ph_xw[v_p1] * v_mix
    v_a_yw = v_a_yw + v_ph_yw[v_p0] * (1 - v_mix) + v_ph_yw[v_p1] * v_mix
    v_a_zw = v_a_zw + v_ph_zw[v_p0] * (1 - v_mix) + v_ph_zw[v_p1] * v_mix
    v_a_yz = v_a_yz + v_ph_yz[v_p0] * (1 - v_mix) + v_ph_yz[v_p1] * v_mix

    v_tumble_y = v_tumble_y + 0.004
    v_tumble_x = 0.45 + sin(v_frame * 0.0021) * 0.3
    v_hue = v_hue + 0.012
    if v_hue >= 100 then
        v_hue = v_hue - 100
    endif

    call project_all
    begin_frame(true)
        call draw_all
    end_frame
    v_frame = v_frame + 1
endwhile
