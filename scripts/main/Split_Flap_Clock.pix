# Split-Flap Clock - a railway-station flip clock
#
# Hours and minutes on big flap cards, seconds on small ones underneath, and
# the date below. When a digit changes, the top half of the old card falls
# toward you on its hinge, turns edge-on, and the bottom half of the new card
# swings down into place, just like a mechanical split-flap display. The leaf
# starts slowly and speeds up as it falls. When several digits change at once
# (10:59 -> 11:00) they flip one after another, right to left.
#
# How it works: every card half is a sprite (one cel per digit, plus a
# blank). The falling leaf is a sprite instance turned with set_sprite_tilt.
# Tilt pivots around the sprite's centre, so the leaf is moved every frame to
# keep its hinge edge fixed on the split line. Nearly no CPU is needed.

fps(60)
throttle(0)

# ---------------- Settings ----------------
v_24h = 0              # 1 = 24-hour clock, 0 = 12-hour (blank leading zero)
v_flip_frames = 20     # frames for one big flip
v_flip_frames_small = 14
v_cascade = 5          # frames between digits that flip together
v_date_color = "gold"

# ---------------- Card art (generated) ----------------
# Each card is split in two halves: *_top shows the upper half of a digit,
# *_bot the lower half. Cel 0-9 = digits, cel 10 = blank card.
define_sprite(big_top, 13, 12)
    sprite_cel(0)
        draw_rectangle(0, 0, 13, 12, dark_gray, 55, true)
        plot(0, 0, black, 100)
        plot(12, 0, black, 100)
        draw_line(4, 2, 8, 2, white, 95)
        draw_line(3, 3, 9, 3, white, 95)
        draw_line(3, 4, 9, 4, white, 95)
