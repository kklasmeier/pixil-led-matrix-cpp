        draw_line(2, 3, 3, 3, white, 95)
        draw_line(5, 3, 6, 3, white, 95)
        draw_line(2, 4, 3, 4, white, 95)
        draw_line(5, 4, 6, 4, white, 95)
        draw_line(2, 5, 6, 5, white, 95)
        draw_line(2, 6, 6, 6, white, 95)
    sprite_cel(10)
        draw_rectangle(0, 0, 9, 7, dark_gray, 55, true)
        plot(0, 0, black, 100)
        plot(8, 0, black, 100)
endsprite

