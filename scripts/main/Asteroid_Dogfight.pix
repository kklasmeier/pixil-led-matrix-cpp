}
v_fa = 0
v_fb = 1
v_fcc = 3
v_tcol = "crimson"
call etri
v_fa = 0
v_fb = 3
v_fcc = 2
call etri
v_fa = 0
v_fb = 4
v_fcc = 1
v_tcol = "maroon"
call etri
