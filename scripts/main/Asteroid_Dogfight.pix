# Asteroid Dogfight - chasing an enemy fighter through an asteroid belt
#
# The camera rides just behind your starfighter as you chase a red raider
# through a field of tumbling, flat-shaded asteroids. The raider jinks and
# weaves; you bank after it, swerve around rocks and fire twin lasers. It
# shoots back now and then, and your shield flares when a shot comes close.
# Wear down its shield and it blows apart in a fireball and spinning
# debris, then the next raider comes in from the distance.
#
# How it is built:
#   - Asteroids are 20-sided rocks, each with its own lumpy shape and tumble.
#     The ships are small hand-built meshes (original designs).
#   - Every face is lit by a distant sun and faces turned away are skipped.
#     Faraway rocks are drawn as simple shaded discs to save time.
#   - Everything (faces, discs, laser bolts, debris, dust) goes into one
#     list sorted by distance into buckets, then drawn far to near.
#   - Stars and a distant gas giant sit at infinity, so they only turn with
#     the camera; space dust streams past to show your speed.

fps(60)
throttle(0)

v_pace = 1.7
v_k = 1.7 / v_pace          # time step relative to the design speed
v_focal = 34
v_near = 0.6
v_speed = 0.32 * v_k        # forward speed (units per frame)
v_nast = 26
v_view = 95                 # how far ahead asteroids live

# sun direction (towards the sun)
v_lx = 0.55
v_ly = 0.6
v_lz = -0.58

# ---------------- Meshes ----------------
# icosahedron for asteroids
create_array(v_ivx, 12, numeric)
create_array(v_ivy, 12, numeric)
create_array(v_ivz, 12, numeric)
v_ph = 1.618
create_array(v_tmp3, 36, numeric)
v_tmp3[0] = -1
v_tmp3[1] = v_ph
v_tmp3[2] = 0
v_tmp3[3] = 1
v_tmp3[4] = v_ph
v_tmp3[5] = 0
v_tmp3[6] = -1
v_tmp3[7] = 0 - v_ph
v_tmp3[8] = 0
v_tmp3[9] = 1
v_tmp3[10] = 0 - v_ph
v_tmp3[11] = 0
v_tmp3[12] = 0
v_tmp3[13] = -1
v_tmp3[14] = v_ph
v_tmp3[15] = 0
v_tmp3[16] = 1
v_tmp3[17] = v_ph
v_tmp3[18] = 0
v_tmp3[19] = -1
v_tmp3[20] = 0 - v_ph
v_tmp3[21] = 0
v_tmp3[22] = 1
v_tmp3[23] = 0 - v_ph
v_tmp3[24] = v_ph
v_tmp3[25] = 0
v_tmp3[26] = -1
v_tmp3[27] = v_ph
v_tmp3[28] = 0
v_tmp3[29] = 1
v_tmp3[30] = 0 - v_ph
v_tmp3[31] = 0
v_tmp3[32] = -1
v_tmp3[33] = 0 - v_ph
v_tmp3[34] = 0
v_tmp3[35] = 1
for v_i in (0, 11, 1)
    v_l = sqrt(v_tmp3[v_i * 3] * v_tmp3[v_i * 3] + v_tmp3[v_i * 3 + 1] * v_tmp3[v_i * 3 + 1] + v_tmp3[v_i * 3 + 2] * v_tmp3[v_i * 3 + 2])
    v_ivx[v_i] = v_tmp3[v_i * 3] / v_l
    v_ivy[v_i] = v_tmp3[v_i * 3 + 1] / v_l
    v_ivz[v_i] = v_tmp3[v_i * 3 + 2] / v_l
endfor v_i
create_array(v_ifc, 60, numeric)
v_fl = 0
def fc {
    v_ifc[v_fl] = v_fa
    v_ifc[v_fl + 1] = v_fb
    v_ifc[v_fl + 2] = v_fcc
    v_fl = v_fl + 3
}
# the 20 faces
for v_q in (0, 19, 1)
    if v_q == 0 then
        v_fa = 0
        v_fb = 11
        v_fcc = 5
    elseif v_q == 1 then
        v_fa = 0
        v_fb = 5
        v_fcc = 1
    elseif v_q == 2 then
        v_fa = 0
        v_fb = 1
        v_fcc = 7
    elseif v_q == 3 then
        v_fa = 0
        v_fb = 7
        v_fcc = 10
    elseif v_q == 4 then
        v_fa = 0
        v_fb = 10
        v_fcc = 11
    elseif v_q == 5 then
        v_fa = 1
        v_fb = 5
        v_fcc = 9
    elseif v_q == 6 then
        v_fa = 5
        v_fb = 11
        v_fcc = 4
    elseif v_q == 7 then
        v_fa = 11
        v_fb = 10
        v_fcc = 2
    elseif v_q == 8 then
        v_fa = 10
        v_fb = 7
        v_fcc = 6
    elseif v_q == 9 then
        v_fa = 7
        v_fb = 1
        v_fcc = 8
    elseif v_q == 10 then
        v_fa = 3
        v_fb = 9
        v_fcc = 4
    elseif v_q == 11 then
        v_fa = 3
        v_fb = 4
        v_fcc = 2
    elseif v_q == 12 then
        v_fa = 3
        v_fb = 2
        v_fcc = 6
    elseif v_q == 13 then
        v_fa = 3
        v_fb = 6
        v_fcc = 8
    elseif v_q == 14 then
        v_fa = 3
        v_fb = 8
        v_fcc = 9
    elseif v_q == 15 then
        v_fa = 4
        v_fb = 9
        v_fcc = 5
    elseif v_q == 16 then
        v_fa = 2
        v_fb = 4
        v_fcc = 11
    elseif v_q == 17 then
        v_fa = 6
        v_fb = 2
        v_fcc = 10
    elseif v_q == 18 then
        v_fa = 8
        v_fb = 6
        v_fcc = 7
    else
        v_fa = 9
        v_fb = 8
        v_fcc = 1
    endif
    call fc
endfor v_q

# ship meshes: vertex lists and triangle lists (indices), original designs
# player: an arrow-head hull with a dorsal fin and two wing blades
create_array(v_pvx, 9, numeric)
create_array(v_pvy, 9, numeric)
create_array(v_pvz, 9, numeric)
create_array(v_ptri, 30, numeric)
create_array(v_ptc, 10, string)
def pv {
    v_pvx[v_vi] = v_ax
    v_pvy[v_vi] = v_ay
    v_pvz[v_vi] = v_az
}
v_vi = 0
v_ax = 0
v_ay = 0
v_az = 1.8
call pv
v_vi = 1
v_ax = -0.45
v_ay = 0
v_az = -0.9
call pv
v_vi = 2
v_ax = 0.45
v_ay = 0
v_az = -0.9
call pv
v_vi = 3
v_ax = 0
v_ay = 0.4
v_az = -0.8
call pv
v_vi = 4
v_ax = 0
v_ay = -0.3
v_az = -0.8
call pv
v_vi = 5
v_ax = -1.7
v_ay = -0.15
v_az = -1.1
call pv
v_vi = 6
v_ax = 1.7
v_ay = -0.15
v_az = -1.1
call pv
v_vi = 7
v_ax = 0
v_ay = 0.95
v_az = -1.2
call pv
v_vi = 8
v_ax = 0
v_ay = 0.1
v_az = 0.3
call pv
v_np = 0
def ptri {
    v_ptri[v_np * 3] = v_fa
    v_ptri[v_np * 3 + 1] = v_fb
    v_ptri[v_np * 3 + 2] = v_fcc
    v_ptc[v_np] = v_tcol
    v_np = v_np + 1
}
v_fa = 0
v_fb = 1
v_fcc = 3
v_tcol = "silver"
call ptri
v_fa = 0
v_fb = 3
v_fcc = 2
call ptri
v_fa = 0
v_fb = 4
v_fcc = 1
v_tcol = "gray"
call ptri
v_fa = 0
v_fb = 2
v_fcc = 4
call ptri
v_fa = 1
v_fb = 3
v_fcc = 4
v_tcol = "dark_gray"
call ptri
v_fa = 2
v_fb = 4
v_fcc = 3
call ptri
v_fa = 8
v_fb = 1
v_fcc = 5
v_tcol = "royal_blue"
call ptri
v_fa = 8
v_fb = 6
v_fcc = 2
call ptri
v_fa = 3
v_fb = 7
v_fcc = 8
v_tcol = "sky_blue"
call ptri
v_nptri = v_np

# raider: a stubby body with forward-swept wings and twin rear pods
create_array(v_evx, 9, numeric)
create_array(v_evy, 9, numeric)
create_array(v_evz, 9, numeric)
create_array(v_etri, 30, numeric)
create_array(v_etc, 10, string)
def ev {
    v_evx[v_vi] = v_ax
    v_evy[v_vi] = v_ay
    v_evz[v_vi] = v_az
}
v_vi = 0
v_ax = 0
v_ay = 0
v_az = 1.3
call ev
v_vi = 1
v_ax = -0.55
v_ay = 0
v_az = -0.9
call ev
v_vi = 2
