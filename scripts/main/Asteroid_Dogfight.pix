v_ay = 0
v_az = -0.9
call ev
v_vi = 3
v_ax = 0
v_ay = 0.5
v_az = -0.7
call ev
v_vi = 4
v_ax = 0
v_ay = -0.45
v_az = -0.7
call ev
v_vi = 5
v_ax = -2.1
v_ay = 0.1
v_az = 0.8
call ev
v_vi = 6
v_ax = 2.1
v_ay = 0.1
v_az = 0.8
call ev
v_vi = 7
v_ax = -0.4
v_ay = 0
