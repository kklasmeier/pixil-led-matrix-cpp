v_az = 0.1
call ev
v_np = 0
def etri {
    v_etri[v_np * 3] = v_fa
    v_etri[v_np * 3 + 1] = v_fb
    v_etri[v_np * 3 + 2] = v_fcc
    v_etc[v_np] = v_tcol
