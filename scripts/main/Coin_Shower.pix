# Coin Shower - a vault of spinning gold coins
#
# Gold coins rain down at three depths. Each one spins as it falls: the star
# face turns to an edge-on flash of gold, then the "1" on the back, and round
# again. Far coins are small, dim and slow; near coins are big and fast.
# The near coins land on a heap of gold at the bottom, tip over flat, and
# become part of it; the heap slides like sand, glints, and keeps growing.
# Coins further back fall behind the heap. When the heap gets high enough,
# the vault floor opens and it drains away, and the shower carries on.
#
# Spin modes (a new one every 8 - 15 seconds, picked at random):
#   1 clockwise            5 diagonal tumble down-left
#   2 counter-clockwise    6 diagonal tumble up-left
#   3 top-down tumble      7 diagonal tumble down-right
#   4 bottom-up tumble     8 diagonal tumble up-right
#   9 complete mix: every coin picks its own mode
# The diagonal modes vary each coin's angle a little so they don't march in
# lockstep. New coins take the new mode, so the shower changes over smoothly.
#
# How it works:
#   - Three coin sprites (near / mid / far) with two cels each: front face
#     and back face (sprite_back_cel). set_sprite_tilt spins them around the
#     vertical axis; past 90 degrees the back face shows, and edge-on the
#     engine draws a 1-pixel sliver of gold, just like a real spinning coin.
#   - Drawing layers give the depth order: far coins (layer 0), mid coins
#     (layer 10), the heap (layer 20), near coins (layer 30).
#   - The heap is a height per column with a simple sand-slide rule.

fps(60)
throttle(0)

# ---------------- Settings ----------------
v_coins = 21           # coins in the air (a third at each depth)
v_heap_max = 24        # heap height that opens the vault floor
v_drain_speed = 0.18   # how fast the heap drains
v_mode_min = 480       # frames before the spin mode changes (min)
v_mode_max = 900       # ... and max
v_diag_var = 18        # +/- degrees of variation in the diagonal modes

