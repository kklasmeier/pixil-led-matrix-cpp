sprite_back_cel(coin_far, 1)

# ---------------- Coins ----------------
create_array(v_cx, v_coins, numeric)
create_array(v_cy, v_coins, numeric)
create_array(v_vy, v_coins, numeric)
create_array(v_spin, v_coins, numeric)
create_array(v_spd, v_coins, numeric)
create_array(v_scl, v_coins, numeric)
create_array(v_land, v_coins, numeric)   # 0 = falling, >0 frames since landing
create_array(v_axis, v_coins, numeric)   # 0 = spin (tilt_y), 1 = tumble (tilt_x)
create_array(v_cang, v_coins, numeric)   # in-plane angle that sets the tumble direction
create_array(v_adirty, v_coins, numeric) # 1 = angle needs sending
v_mode = random(1, 9, 0)

# give coin v_i a spin style for mode v_mode (mode 9 = a random one of 1-8)
def style_coin {
    v_m = v_mode
    if v_m == 9 then
        v_m = random(1, 8, 0)
    endif
    v_mag = random(5, 13, 1)
    v_var = random(0 - v_diag_var, v_diag_var, 0)
    if v_m == 1 then
        v_axis[v_i] = 0
        v_spd[v_i] = v_mag
        v_cang[v_i] = 0
    elseif v_m == 2 then
        v_axis[v_i] = 0
        v_spd[v_i] = 0 - v_mag
        v_cang[v_i] = 0
    elseif v_m == 3 then
        v_axis[v_i] = 1
        v_spd[v_i] = 0 - v_mag
        v_cang[v_i] = 0
    elseif v_m == 4 then
        v_axis[v_i] = 1
        v_spd[v_i] = v_mag
        v_cang[v_i] = 0
    elseif v_m == 5 then
        v_axis[v_i] = 1
        v_spd[v_i] = 0 - v_mag
        v_cang[v_i] = 45 + v_var
    elseif v_m == 6 then
        v_axis[v_i] = 1
        v_spd[v_i] = v_mag
        v_cang[v_i] = -45 + v_var
    elseif v_m == 7 then
        v_axis[v_i] = 1
        v_spd[v_i] = 0 - v_mag
        v_cang[v_i] = -45 + v_var
    else
        v_axis[v_i] = 1
        v_spd[v_i] = v_mag
        v_cang[v_i] = 45 + v_var
    endif
    v_adirty[v_i] = 1
}

create_array(v_heap, 64, numeric)
for v_x in (0, 63, 1)
    v_heap[v_x] = 0
endfor v_x

# v_i = coin; depth bucket = v_i % 3 (0 near, 1 mid, 2 far)
def spawn {
    v_b = v_i % 3
    v_cx[v_i] = random(3, 60, 1)
    v_cy[v_i] = random(-40, -8, 1)
    v_spin[v_i] = random(0, 359, 0)
    call style_coin
    if v_b == 0 then
        v_scl[v_i] = random(1.0, 1.35, 2)
        v_vy[v_i] = random(0.55, 0.75, 2)
    elseif v_b == 1 then
        v_scl[v_i] = random(0.7, 0.9, 2)
        v_vy[v_i] = random(0.38, 0.5, 2)
    else
        v_scl[v_i] = random(0.42, 0.58, 2)
        v_vy[v_i] = random(0.22, 0.32, 2)
    endif
    v_land[v_i] = 0
}

def show_coin {
    v_b = v_i % 3
    if v_b == 0 then
        set_layer(30)
        show_sprite(coin_near, v_cx[v_i], v_cy[v_i], v_i, 0, 0)
        set_sprite_anchor(coin_near, 1, v_i)
        set_sprite_scale(coin_near, v_scl[v_i], v_i)
    elseif v_b == 1 then
        set_layer(10)
        show_sprite(coin_mid, v_cx[v_i], v_cy[v_i], v_i, 0, 0)
        set_sprite_anchor(coin_mid, 1, v_i)
        set_sprite_scale(coin_mid, v_scl[v_i], v_i)
    else
        set_layer(0)
        show_sprite(coin_far, v_cx[v_i], v_cy[v_i], v_i, 0, 0)
        set_sprite_anchor(coin_far, 1, v_i)
        set_sprite_scale(coin_far, v_scl[v_i], v_i)
    endif
    set_layer(0)
}

def draw_coin {
    v_b = v_i % 3
    v_ang = v_cang[v_i]
    if v_axis[v_i] == 0 then
        v_tx = 0
        v_ty = v_spin[v_i]
    else
        v_tx = v_spin[v_i]
        v_ty = 0
    endif
    if v_land[v_i] > 0 then
        # settling flat onto the heap: blend from the spin to lying flat
        v_k = min(v_land[v_i] / 10, 1)
        v_tx = v_tx * (1 - v_k) + 80 * v_k
        v_ty = v_ty * (1 - v_k)
        v_ang = v_ang * (1 - v_k)
        v_adirty[v_i] = 1
    endif
    if v_b == 0 then
        if v_adirty[v_i] == 1 then
            set_sprite_angle(coin_near, v_ang, v_i)
        endif
        set_sprite_tilt(coin_near, v_tx, v_ty, v_i)
        move_sprite(coin_near, v_cx[v_i], v_cy[v_i], v_i, 0)
    elseif v_b == 1 then
        if v_adirty[v_i] == 1 then
            set_sprite_angle(coin_mid, v_ang, v_i)
        endif
        set_sprite_tilt(coin_mid, v_tx, v_ty, v_i)
        move_sprite(coin_mid, v_cx[v_i], v_cy[v_i], v_i, 0)
    else
        if v_adirty[v_i] == 1 then
            set_sprite_angle(coin_far, v_ang, v_i)
        endif
        set_sprite_tilt(coin_far, v_tx, v_ty, v_i)
        move_sprite(coin_far, v_cx[v_i], v_cy[v_i], v_i, 0)
    endif
    v_adirty[v_i] = 0
}

# a near coin joins the heap: a soft bump under it
def add_to_heap {
    v_hx = round(v_cx[v_i])
    for v_d in (-3, 3, 1)
        v_x = v_hx + v_d
        if v_x >= 0 and v_x <= 63 then
            v_heap[v_x] = v_heap[v_x] + (3.2 - abs(v_d)) * 0.55
        endif
    endfor v_d
}

# sand slide: steep steps pour sideways
def settle_heap {
    for v_x in (0, 62, 1)
        v_diff = v_heap[v_x] - v_heap[v_x + 1]
        if v_diff > 0.9 then
            v_heap[v_x] = v_heap[v_x] - 0.2
            v_heap[v_x + 1] = v_heap[v_x + 1] + 0.2
        elseif v_diff < -0.9 then
            v_heap[v_x] = v_heap[v_x] + 0.2
            v_heap[v_x + 1] = v_heap[v_x + 1] - 0.2
        endif
    endfor v_x
}

def draw_heap {
    set_layer(20)
    v_top = 0
    for v_x in (0, 63, 1)
        v_h = round(v_heap[v_x])
        v_top = max(v_top, v_heap[v_x])
        if v_h >= 1 then
            draw_line(v_x, 63, v_x, 64 - v_h, bronze, 40)
            v_y = 64 - v_h
            mplot(v_x, v_y, gold, 95)
            if v_h >= 2 then
                mplot(v_x, v_y + 1, gold, 70)
            endif
            # glints scattered through the heap
            if random(0, 1, 2) < 0.04 then
                mplot(v_x, v_y + random(0, v_h - 1, 0), white, 90)
            endif
        endif
    endfor v_x
    set_layer(0)
}

# ---------------- Start ----------------
for v_i in (0, v_coins - 1, 1)
    call spawn
    v_cy[v_i] = random(-60, 50, 1)
    call show_coin
endfor v_i

v_draining = 0
v_mode_timer = random(v_mode_min, v_mode_max, 0)
v_top = 0

# ---------------- Main loop ----------------
while true then
    # time for a new spin mode?
    v_mode_timer = v_mode_timer - 1
    if v_mode_timer <= 0 then
        v_old_mode = v_mode
        while v_mode == v_old_mode then
            v_mode = random(1, 9, 0)
        endwhile
        v_mode_timer = random(v_mode_min, v_mode_max, 0)
        # coins still above the screen switch right away (nobody sees it)
        for v_i in (0, v_coins - 1, 1)
            if v_cy[v_i] < -8 then
                call style_coin
            endif
        endfor v_i
    endif
    begin_frame
        # faint glints in the dark vault behind everything
        for v_k in (0, 3, 1)
            mplot(random(0, 63, 0), random(0, 50, 0), gold, random(4, 18, 0))
        endfor v_k

        for v_i in (0, v_coins - 1, 1)
            if v_land[v_i] > 0 then
                v_land[v_i] = v_land[v_i] + 1
                if v_land[v_i] > 12 then
                    call add_to_heap
                    call spawn
                endif
            else
                v_cy[v_i] = v_cy[v_i] + v_vy[v_i]
                v_vy[v_i] = v_vy[v_i] + 0.004
                v_spin[v_i] = v_spin[v_i] + v_spd[v_i]
                if v_spin[v_i] > 180 then
                    v_spin[v_i] = v_spin[v_i] - 360
                elseif v_spin[v_i] < -180 then
                    v_spin[v_i] = v_spin[v_i] + 360
                endif
                if v_i % 3 == 0 then
                    v_hx = min(max(round(v_cx[v_i]), 0), 63)
                    v_floor = 63 - v_heap[v_hx] - 5 * v_scl[v_i]
                    if v_cy[v_i] >= v_floor then
                        v_cy[v_i] = v_floor
                        if v_draining == 0 then
                            v_land[v_i] = 1
                        else
                            call spawn
                        endif
                    endif
                elseif v_cy[v_i] > 72 then
                    call spawn
                endif
            endif
            call draw_coin
        endfor v_i

        call settle_heap
        if v_draining == 1 then
            for v_x in (0, 63, 1)
                v_heap[v_x] = max(v_heap[v_x] - v_drain_speed * (1 + v_heap[v_x] * 0.05), 0)
            endfor v_x
            if v_top < 0.5 then
                v_draining = 0
v_mode_timer = random(v_mode_min, v_mode_max, 0)
            endif
        elseif v_top > v_heap_max then
            v_draining = 1
        endif
        call draw_heap
    end_frame
endwhile
