# Sine Wave Color Flow
# Draws left → right with burnout trails (same feel as the classic script),
# with a soft vertical shade so the ribbon is less blocky.

throttle(0)
fps(60)

v_num_waves = 2
v_wave_speed = 0.1
v_color_speed = 0.05
v_burnout = 300
v_refresh_count = 0
v_color_cycle = 0

create_array(v_phase, v_num_waves, numeric)
create_array(v_amplitude, v_num_waves, numeric)
create_array(v_frequency, v_num_waves, numeric)

v_t = 0
v_color_t = 0

def init_waves {
    for v_i in (0, v_num_waves - 1, 1)
        v_phase[v_i] = random(0, 628, 2) / 100
        v_amplitude[v_i] = random(5, 15, 1)
        v_frequency[v_i] = random(1, 4, 2) / 10
    endfor v_i
}

def pick_colors {
    if v_color_cycle == 0 then
        v_c0 = "cyan"
        v_c1 = "magenta"
    elseif v_color_cycle == 1 then
        v_c0 = "yellow"
        v_c1 = "blue"
    elseif v_color_cycle == 2 then
        v_c0 = "green"
        v_c1 = "red"
    elseif v_color_cycle == 3 then
        v_c0 = "violet"
        v_c1 = "orange"
    else
        v_c0 = "blue"
        v_c1 = "yellow"
    endif
}

def plot_row {
    if v_yi >= 0 and v_yi <= 63 then
        if v_b < 1 then
            v_b = 1
        endif
        if v_b > 100 then
            v_b = 100
        endif
        plot(v_x, v_yi, v_col, v_b, v_burnout)
    endif
}

# Soft 5-row lobe with subpixel blend — still one column at a time for L→R burnouts
def draw_wave_column {
    v_y = 32 + v_amplitude[v_i] * sin((v_x * v_frequency[v_i]) + v_phase[v_i] + v_t)
    v_y0 = floor(v_y)
    v_frac = v_y - v_y0
    v_peak = 52 + sin(v_t + v_x * 0.1) * 45

    # Core + halo, lit above / shaded below for a bit of dimension
    for v_d in (0, 2, 1)
        if v_d == 0 then
            v_fall = 1.0
        elseif v_d == 1 then
            v_fall = 0.55
        else
            v_fall = 0.22
        endif

        # Lower (shaded) half of the ribbon
        v_yi = v_y0 + v_d
        v_b = v_peak * v_fall * 0.85 * (1 - v_frac)
        call plot_row
        v_yi = v_y0 + 1 + v_d
        v_b = v_peak * v_fall * 0.85 * v_frac
        call plot_row

        # Upper (lit) halo
        if v_d > 0 then
            v_yi = v_y0 - v_d
            v_b = v_peak * v_fall * 1.05 * (1 - v_frac)
            call plot_row
            v_yi = v_y0 + 1 - v_d
            v_b = v_peak * v_fall * 1.05 * v_frac
            call plot_row
        endif
    endfor v_d
}

call init_waves
call pick_colors

while true then
    v_refresh_count = v_refresh_count + 1
    if v_refresh_count >= 10 then
        v_refresh_count = 0
        v_color_cycle = v_color_cycle + 1
        if v_color_cycle > 4 then
            v_color_cycle = 0
        endif
        call pick_colors
        call init_waves
    endif

    # Classic progressive draw: each column is its own preserve frame so the
    # wave crawls left→right and burnouts leave the trailing ribbon.
    for v_x in (0, 63, 1)
        begin_frame(true)
            v_i = 0
            v_col = v_c0
            call draw_wave_column
            v_i = 1
            v_col = v_c1
            call draw_wave_column
        end_frame
    endfor v_x

    v_t = v_t + v_wave_speed
    v_color_t = v_color_t + v_color_speed
endwhile
