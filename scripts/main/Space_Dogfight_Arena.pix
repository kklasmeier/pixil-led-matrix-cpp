# Space Dogfight Arena - two fighters duel round a spinning space station
#
# Seen from above: two original fighters, the teal "Vireo" and the
# orange "Hornet", chase each other round an orbital station.
#   - Each ship turns smoothly to any heading, hunting the other, and
#     weaves so the fight never settles into one orbit. They fire when
#     the other ship is in their sights.
#   - Shots streak out along the ship's heading. A hit flashes the hull
#     and throws sparks; after four hits the ship bursts into spinning
#     wreckage, and a fresh one warps in from the edge a few seconds later.
#   - The station's hub turns beneath the fight; its two great rings turn
#     ABOVE it, so ships dive under the rings and out again. The ring
#     lights blink.
#   - Engine trails fade behind each ship, and kill tallies sit in the
#     top corners.
#
# What it shows off (layers + sprite transforms):
#   set_sprite_angle for ship headings, shots, spinning wreckage and the
#   rotating station parts; set_sprite_scale for warp-ins and shrinking
#   debris; sprites placed on different layers so the rings pass over
#   the ships and the hub under them.
#
# Layers: 0 stars and nebula   5 station hub   10 engine trails
#         15 shots   20 ships   25 wreckage   30 station rings
#         45 sparks and tallies

fps(60)
throttle(0)

v_pace = 1.7
v_k = 1.7 / v_pace
v_pi = 3.14159

# ---------------- Sprites (original designs) ----------------
def draw_vireo {
    # swept-back wings, slim fuselage; faces right
    draw_line(6, 5, 2, 1, v_c1, 90)
    draw_line(5, 5, 1, 1, v_c1, 70)
    draw_line(6, 5, 2, 9, v_c1, 90)
    draw_line(5, 5, 1, 9, v_c1, 70)
    draw_line(2, 4, 8, 4, v_c3, 85)
    draw_line(2, 6, 8, 6, v_c3, 85)
    draw_line(1, 5, 9, 5, v_c2, 100)
    plot(10, 5, v_c4, 100)
    plot(7, 5, v_c4, 100)
    plot(2, 1, v_c4, 100)
    plot(2, 9, v_c4, 100)
    plot(0, 4, v_c5, 90)
    plot(0, 6, v_c5, 90)
}

def draw_hornet {
    # forward-swept wings, stubby body, twin tail fins; faces right
    draw_rectangle(2, 4, 7, 3, v_c1, 90, true)
    draw_line(4, 5, 8, 1, v_c2, 90)
    draw_line(4, 5, 8, 9, v_c2, 90)
    draw_line(3, 5, 7, 1, v_c2, 70)
    draw_line(3, 5, 7, 9, v_c2, 70)
    plot(9, 5, v_c3, 100)
    plot(10, 5, v_c3, 100)
    plot(7, 5, v_c4, 100)
    plot(1, 3, v_c2, 90)
    plot(1, 7, v_c2, 90)
    plot(0, 5, v_c5, 90)
}

define_sprite(ship, 11, 11)
    sprite_cel(0)
        v_c1 = "teal"
        v_c2 = "white"
        v_c3 = "gray"
        v_c4 = "cyan"
        v_c5 = "sky_blue"
        call draw_vireo
    sprite_cel(1)
        v_c1 = "orange"
        v_c2 = "red"
        v_c3 = "yellow"
        v_c4 = "sky_blue"
        v_c5 = "gold"
        call draw_hornet
    sprite_cel(2)
        v_c1 = "white"
        v_c2 = "white"
        v_c3 = "white"
        v_c4 = "white"
        v_c5 = "white"
        call draw_vireo
    sprite_cel(3)
        call draw_hornet
endsprite

define_sprite(bolt, 5, 3)
    sprite_cel(0)
        draw_line(0, 1, 4, 1, cyan, 90)
        plot(4, 1, white, 100)
    sprite_cel(1)
        draw_line(0, 1, 4, 1, orange, 90)
        plot(4, 1, yellow, 100)
endsprite

define_sprite(chunk, 4, 4)
    sprite_cel(0)
        draw_line(0, 0, 3, 1, teal, 90)
        draw_line(0, 1, 2, 3, gray, 80)
    sprite_cel(1)
        draw_line(0, 2, 3, 0, orange, 90)
        plot(1, 3, red, 90)
        plot(2, 2, red, 80)
    sprite_cel(2)
        draw_rectangle(0, 0, 3, 2, gray, 70, true)
        plot(3, 3, white, 80)
endsprite

def draw_ring {
    # ring of radius v_rr with four gaps; lights at v_lo offset
    for v_a in (0, 358, 2)
        if v_a % 90 > 16 then
            v_ra = v_a * v_pi / 180
            plot(v_rc + cos(v_ra) * v_rr, v_rc + sin(v_ra) * v_rr, gray, 35)
            plot(v_rc + cos(v_ra) * (v_rr - 1), v_rc + sin(v_ra) * (v_rr - 1), silver, 45)
            if (v_a + v_lo) % 30 == 0 then
                plot(v_rc + cos(v_ra) * (v_rr - 0.5), v_rc + sin(v_ra) * (v_rr - 0.5), v_lc, 100)
            endif
        endif
    endfor v_a
}

define_sprite(ring, 43, 43)
    v_rc = 21
    v_rr = 20
    v_lc = "red"
    sprite_cel(0)
        v_lo = 0
        call draw_ring
    sprite_cel(1)
        v_lo = 14
        call draw_ring
endsprite

define_sprite(ring2, 27, 27)
    v_rc = 13
    v_rr = 12
    v_lc = "lime"
    sprite_cel(0)
        v_lo = 0
        call draw_ring
    sprite_cel(1)
        v_lo = 16
        call draw_ring
endsprite

define_sprite(hub, 13, 13)
    sprite_cel(0)
        draw_circle(6, 6, 5, dark_gray, 90, true)
        draw_circle(6, 6, 5, silver, 70, false)
        draw_circle(6, 6, 2, navy, 90, true)
        plot(6, 6, cyan, 100)
        draw_line(0, 6, 12, 6, gray, 70)
        draw_line(6, 0, 6, 12, gray, 70)
        plot(6, 1, yellow, 100)
        plot(11, 6, yellow, 100)
endsprite

# ---------------- Backdrop ----------------
def draw_space {
    set_layer(0)
    draw_ellipse(16, 46, 18, 10, indigo, 14, true, 25)
    draw_ellipse(48, 14, 16, 9, purple, 10, true, -20)
    draw_ellipse(50, 50, 10, 6, ocean_blue, 10, true, 10)
    for v_i in (0, 70, 1)
        plot(random(0, 63, 0), random(0, 63, 0), white, random(10, 55, 0))
    endfor v_i
    for v_i in (0, 5, 1)
        plot(random(0, 63, 0), random(0, 63, 0), sky_blue, 90)
    endfor v_i
}

# ---------------- Fighters ----------------
create_array(v_sx, 2, numeric)
create_array(v_sy, 2, numeric)
create_array(v_sh, 2, numeric)
create_array(v_sv, 2, numeric)
create_array(v_stur, 2, numeric)
create_array(v_shp, 2, numeric)
create_array(v_salive, 2, numeric)
create_array(v_swait, 2, numeric)
create_array(v_scool, 2, numeric)
create_array(v_sflash, 2, numeric)
create_array(v_swarp, 2, numeric)
create_array(v_kills, 2, numeric)
v_ntr = 10
create_array(v_trx, 20, numeric)
create_array(v_try, 20, numeric)

def warp_in {
    # ship v_w appears at the edge heading inward
    v_wa = random(0, 628, 0) / 100
    v_sx[v_w] = 32 + cos(v_wa) * 27
    v_sy[v_w] = 32 + sin(v_wa) * 27
    v_sh[v_w] = v_wa + v_pi
    v_shp[v_w] = 4
    v_salive[v_w] = 1
    v_scool[v_w] = 60
    v_sflash[v_w] = 0
    v_swarp[v_w] = 0.1
    for v_n in (0, v_ntr - 1, 1)
        v_trx[v_w * v_ntr + v_n] = v_sx[v_w]
        v_try[v_w * v_ntr + v_n] = v_sy[v_w]
    endfor v_n
    set_layer(20)
    show_sprite(ship, v_sx[v_w], v_sy[v_w], v_w, 0, v_w)
    set_sprite_anchor(ship, 1, v_w)
    v_px = v_sx[v_w]
    v_py = v_sy[v_w]
    v_pn = 14
    v_pcol = "white"
    call spawn_sparks
}

def fly_ship {
    # steer ship v_i toward the other one, weaving, kept inside the arena
    v_j = 1 - v_i
    v_dx = v_sx[v_j] - v_sx[v_i]
    v_dy = v_sy[v_j] - v_sy[v_i]
    v_dist = sqrt(v_dx * v_dx + v_dy * v_dy)
    v_aim = atan2(v_dy + sin(v_sh[v_j]) * v_dist * 0.3, v_dx + cos(v_sh[v_j]) * v_dist * 0.3)
    if v_salive[v_j] == 0 then
        # no opponent: circle the station
        v_aim = atan2(v_sy[v_i] - 32, v_sx[v_i] - 32) + 1.4
    endif
    v_want = v_aim + sin(v_t * 0.013 + v_i * 2.7) * 0.9
    v_cd = sqrt((v_sx[v_i] - 32) * (v_sx[v_i] - 32) + (v_sy[v_i] - 32) * (v_sy[v_i] - 32))
    if v_cd > 24 then
        v_home = atan2(32 - v_sy[v_i], 32 - v_sx[v_i])
        v_mix = min((v_cd - 24) / 6, 1)
        v_d = atan2(sin(v_home - v_want), cos(v_home - v_want))
        v_want = v_want + v_d * v_mix
    endif
    v_d = atan2(sin(v_want - v_sh[v_i]), cos(v_want - v_sh[v_i]))
    v_turn = max(min(v_d, v_stur[v_i]), 0 - v_stur[v_i])
    v_sh[v_i] = v_sh[v_i] + v_turn * v_k
    v_sx[v_i] = v_sx[v_i] + cos(v_sh[v_i]) * v_sv[v_i] * v_k
    v_sy[v_i] = v_sy[v_i] + sin(v_sh[v_i]) * v_sv[v_i] * v_k
    # fire when the other ship is in the sights
    v_scool[v_i] = v_scool[v_i] - v_k
    v_off = atan2(sin(atan2(v_dy, v_dx) - v_sh[v_i]), cos(atan2(v_dy, v_dx) - v_sh[v_i]))
    if v_salive[v_j] == 1 and v_scool[v_i] <= 0 and abs(v_off) < 0.22 and v_dist < 34 then
        v_fx = v_sx[v_i] + cos(v_sh[v_i]) * 5
        v_fy = v_sy[v_i] + sin(v_sh[v_i]) * 5
        v_fh = v_sh[v_i]
        v_fo = v_i
        call fire_bolt
        v_scool[v_i] = random(18, 32, 0)
    endif
    # trail
    if int(v_t) % 3 == 0 then
        for v_n in (v_ntr - 1, 1, -1)
            v_trx[v_i * v_ntr + v_n] = v_trx[v_i * v_ntr + v_n - 1]
            v_try[v_i * v_ntr + v_n] = v_try[v_i * v_ntr + v_n - 1]
        endfor v_n
    endif
    v_trx[v_i * v_ntr] = v_sx[v_i] - cos(v_sh[v_i]) * 4
    v_try[v_i * v_ntr] = v_sy[v_i] - sin(v_sh[v_i]) * 4
    # sprite
    v_sflash[v_i] = max(v_sflash[v_i] - v_k, 0)
    v_cel = v_i
    if v_sflash[v_i] > 0 and int(v_sflash[v_i]) % 4 < 2 then
        v_cel = v_i + 2
    endif
    v_swarp[v_i] = min(v_swarp[v_i] + 0.03 * v_k, 1)
    set_sprite_transform(ship, v_swarp[v_i], v_sh[v_i] * 180 / v_pi, v_i)
    move_sprite(ship, v_sx[v_i], v_sy[v_i], v_i, v_cel)
}

# ---------------- Shots ----------------
v_nb = 12
create_array(v_bx, v_nb, numeric)
create_array(v_by, v_nb, numeric)
create_array(v_bh, v_nb, numeric)
create_array(v_bl, v_nb, numeric)
create_array(v_bo, v_nb, numeric)

def fire_bolt {
    v_free = -1
    for v_q in (0, v_nb - 1, 1)
        if v_free == -1 and v_bl[v_q] <= 0 then
            v_free = v_q
        endif
    endfor v_q
    if v_free >= 0 then
        v_bx[v_free] = v_fx
        v_by[v_free] = v_fy
        v_bh[v_free] = v_fh
        v_bl[v_free] = 42
        v_bo[v_free] = v_fo
        set_layer(15)
        show_sprite(bolt, v_fx, v_fy, v_free, 0, v_fo)
        set_sprite_anchor(bolt, 1, v_free)
        set_sprite_angle(bolt, v_fh * 180 / v_pi, v_free)
    endif
}

def update_bolts {
    for v_b in (0, v_nb - 1, 1)
        if v_bl[v_b] > 0 then
            v_bl[v_b] = v_bl[v_b] - v_k
            v_bx[v_b] = v_bx[v_b] + cos(v_bh[v_b]) * 1.5 * v_k
            v_by[v_b] = v_by[v_b] + sin(v_bh[v_b]) * 1.5 * v_k
            v_tg = 1 - v_bo[v_b]
            v_hdx = v_bx[v_b] - v_sx[v_tg]
            v_hdy = v_by[v_b] - v_sy[v_tg]
            if v_salive[v_tg] == 1 and v_hdx * v_hdx + v_hdy * v_hdy < 12 then
                # hit
                v_bl[v_b] = 0
                v_shp[v_tg] = v_shp[v_tg] - 1
                v_sflash[v_tg] = 16
                v_px = v_bx[v_b]
                v_py = v_by[v_b]
                v_pn = 6
                v_pcol = "yellow"
                call spawn_sparks
                if v_shp[v_tg] <= 0 then
                    v_xs = v_tg
                    call explode
                endif
            endif
            if v_bl[v_b] <= 0 or v_bx[v_b] < -3 or v_bx[v_b] > 66 or v_by[v_b] < -3 or v_by[v_b] > 66 then
                v_bl[v_b] = 0
                hide_sprite(bolt, v_b)
            else
                move_sprite(bolt, v_bx[v_b], v_by[v_b], v_b, v_bo[v_b])
            endif
        endif
    endfor v_b
}

# ---------------- Wreckage ----------------
v_nd = 12
create_array(v_dbx, v_nd, numeric)
create_array(v_dby, v_nd, numeric)
create_array(v_dvx, v_nd, numeric)
create_array(v_dvy, v_nd, numeric)
create_array(v_dang, v_nd, numeric)
create_array(v_dspin, v_nd, numeric)
create_array(v_dl, v_nd, numeric)

def explode {
    # ship v_xs bursts into spinning wreckage
    v_salive[v_xs] = 0
    v_swait[v_xs] = 200
    v_kills[1 - v_xs] = v_kills[1 - v_xs] + 1
    if v_kills[1 - v_xs] > 10 then
        # new match: clear the tallies
        v_kills[0] = 0
        v_kills[1] = 0
        v_kills[1 - v_xs] = 1
    endif
    hide_sprite(ship, v_xs)
    v_px = v_sx[v_xs]
    v_py = v_sy[v_xs]
    v_pn = 30
    v_pcol = "orange"
    call spawn_sparks
    v_made = 0
    for v_e in (0, v_nd - 1, 1)
        if v_dl[v_e] <= 0 and v_made < 6 then
            v_made = v_made + 1
            v_ea = random(0, 628, 0) / 100
            v_es = random(20, 60, 0) / 100
            v_dbx[v_e] = v_px
            v_dby[v_e] = v_py
            v_dvx[v_e] = cos(v_ea) * v_es + cos(v_sh[v_xs]) * 0.3
            v_dvy[v_e] = sin(v_ea) * v_es + sin(v_sh[v_xs]) * 0.3
            v_dang[v_e] = random(0, 359, 0)
            v_dspin[v_e] = random(-12, 12, 0)
            v_dl[v_e] = random(90, 150, 0)
            set_layer(25)
            show_sprite(chunk, v_px, v_py, v_e, 0, (v_xs + v_e) % 3)
            set_sprite_anchor(chunk, 1, v_e)
        endif
    endfor v_e
}

def update_debris {
    for v_e in (0, v_nd - 1, 1)
        if v_dl[v_e] > 0 then
            v_dl[v_e] = v_dl[v_e] - v_k
            v_dbx[v_e] = v_dbx[v_e] + v_dvx[v_e] * v_k
            v_dby[v_e] = v_dby[v_e] + v_dvy[v_e] * v_k
            v_dvx[v_e] = v_dvx[v_e] * 0.992
            v_dvy[v_e] = v_dvy[v_e] * 0.992
            v_dang[v_e] = v_dang[v_e] + v_dspin[v_e] * v_k
            if v_dl[v_e] <= 0 then
                hide_sprite(chunk, v_e)
            else
                set_sprite_transform(chunk, max(min(v_dl[v_e] / 50, 1.4), 0.2), v_dang[v_e], v_e)
                move_sprite(chunk, v_dbx[v_e], v_dby[v_e], v_e, (v_e) % 3)
            endif
        endif
    endfor v_e
}

# ---------------- Sparks ----------------
v_np = 50
create_array(v_ppx, v_np, numeric)
create_array(v_ppy, v_np, numeric)
create_array(v_pvx, v_np, numeric)
create_array(v_pvy, v_np, numeric)
create_array(v_pl, v_np, numeric)
create_array(v_pc, v_np, numeric)

def spawn_sparks {
    # v_pn sparks at (v_px, v_py), colour v_pcol
    v_left = v_pn
    for v_q in (0, v_np - 1, 1)
        if v_left > 0 and v_pl[v_q] <= 0 then
            v_left = v_left - 1
            v_qa = random(0, 628, 0) / 100
            v_qs = random(15, 110, 0) / 100
            v_ppx[v_q] = v_px
            v_ppy[v_q] = v_py
            v_pvx[v_q] = cos(v_qa) * v_qs
            v_pvy[v_q] = sin(v_qa) * v_qs
            v_pl[v_q] = random(15, 40, 0)
            v_pc[v_q] = 0
            if v_pcol == "orange" then
                v_pc[v_q] = 1 + v_q % 2
            elseif v_pcol == "white" then
                v_pc[v_q] = 3
            endif
        endif
    endfor v_q
}

def draw_effects {
    set_layer(10)
    clear_layer(10)
    for v_i in (0, 1, 1)
        if v_salive[v_i] == 1 then
            v_tc = "sky_blue"
            if v_i == 1 then
                v_tc = "orange"
            endif
            for v_n in (0, v_ntr - 2, 1)
                draw_line(v_trx[v_i * v_ntr + v_n], v_try[v_i * v_ntr + v_n], v_trx[v_i * v_ntr + v_n + 1], v_try[v_i * v_ntr + v_n + 1], v_tc, 55 - v_n * 5)
            endfor v_n
        endif
    endfor v_i
    set_layer(45)
    clear_layer(45)
    for v_p in (0, v_np - 1, 1)
        if v_pl[v_p] > 0 then
            v_pl[v_p] = v_pl[v_p] - v_k
            v_ppx[v_p] = v_ppx[v_p] + v_pvx[v_p] * v_k
            v_ppy[v_p] = v_ppy[v_p] + v_pvy[v_p] * v_k
            v_pvx[v_p] = v_pvx[v_p] * 0.96
            v_pvy[v_p] = v_pvy[v_p] * 0.96
            v_cc = "yellow"
            if v_pc[v_p] == 1 then
                v_cc = "orange"
            elseif v_pc[v_p] == 2 then
                v_cc = "red"
            elseif v_pc[v_p] == 3 then
                v_cc = "white"
            endif
            plot(v_ppx[v_p], v_ppy[v_p], v_cc, min(v_pl[v_p] * 5, 100))
        endif
    endfor v_p
    # kill tallies
    for v_n in (0, min(v_kills[0], 10) - 1, 1)
        plot(1 + v_n * 2, 1, cyan, 80)
    endfor v_n
    for v_n in (0, min(v_kills[1], 10) - 1, 1)
        plot(62 - v_n * 2, 1, orange, 80)
    endfor v_n
}

# ---------------- Main ----------------
v_t = 0
v_sv[0] = 0.55
v_sv[1] = 0.6
v_stur[0] = 0.046
v_stur[1] = 0.047
for v_q in (0, v_nb - 1, 1)
    v_bl[v_q] = 0
endfor v_q
for v_q in (0, v_nd - 1, 1)
    v_dl[v_q] = 0
endfor v_q
for v_q in (0, v_np - 1, 1)
    v_pl[v_q] = 0
endfor v_q

begin_frame
    call draw_space
    set_layer(5)
    show_sprite(hub, 32, 32, 0, 0, 0)
    set_sprite_anchor(hub, 1, 0)
    set_layer(30)
    show_sprite(ring, 32, 32, 0, 0, 0)
    set_sprite_anchor(ring, 1, 0)
    show_sprite(ring2, 32, 32, 0, 0, 0)
    set_sprite_anchor(ring2, 1, 0)
    for v_w in (0, 1, 1)
        call warp_in
    endfor v_w
end_frame

while true then
    v_t = v_t + v_k
    begin_frame(true)
        # station turns: hub one way, rings above the fight the other
        v_rl = int(v_t / 30) % 2
        set_sprite_angle(hub, v_t * 0.4, 0)
        set_sprite_angle(ring, v_t * 0.25, 0)
        set_sprite_angle(ring2, 0 - v_t * 0.5, 0)
        move_sprite(hub, 32, 32, 0, 0)
        move_sprite(ring, 32, 32, 0, v_rl)
        move_sprite(ring2, 32, 32, 0, 1 - v_rl)
        for v_i in (0, 1, 1)
            if v_salive[v_i] == 1 then
                call fly_ship
            else
                v_swait[v_i] = v_swait[v_i] - v_k
                if v_swait[v_i] <= 0 then
                    v_w = v_i
                    call warp_in
                endif
            endif
        endfor v_i
        call update_bolts
        call update_debris
        call draw_effects
    end_frame
endwhile
