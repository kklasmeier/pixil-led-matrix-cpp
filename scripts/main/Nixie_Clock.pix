# Nixie Tube Clock - glowing orange numerals in glass tubes
#
# Hours and minutes in four big nixie tubes, seconds in two small ones
# underneath, with blinking neon colon dots between the hours and minutes.
# Each tube shows the faint stack of all ten wire numerals behind the one
# that is lit, plus the fine anode mesh, the glass and its base.
#
#   - A changing digit dims out and the new one glows up, like a real tube.
#   - Now and then a tube flickers for a moment.
#   - Every ten minutes the clock runs its "anti-poisoning" routine: every
#     tube spins rapidly through all its digits, slot-machine style, and
#     they settle back on the time one after another. (Real nixie clocks do
#     this to keep unused cathodes from wearing out.)
#
# How it works: tubes and digits are sprites drawn once at start, so the
# clock costs almost nothing per frame. Each digit sprite has bright, dim
# and very dim cels for every numeral (used for switching and flicker).

fps(30)
throttle(0)

# ---------------- Settings ----------------
v_24h = 0              # 1 = 24-hour clock, 0 = 12-hour (leading zero tube dark)
v_flicker = 0.0015     # chance per frame per tube of a brief flicker
v_sweep_every = 10     # minutes between anti-poisoning sweeps (0 = never)

# ---------------- Tubes and numerals (generated) ----------------
