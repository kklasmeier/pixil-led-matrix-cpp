# ---------------- Layout ----------------
# slots 0-3: big HH MM tubes, 4-5: small seconds tubes
v_slots = 6
create_array(v_tx, v_slots, numeric)
create_array(v_ty, v_slots, numeric)
v_tx[0] = 1
v_tx[1] = 15
v_tx[2] = 36
v_tx[3] = 50
v_tx[4] = 22
v_tx[5] = 33
v_ty[0] = 2
v_ty[1] = 2
v_ty[2] = 2
v_ty[3] = 2
v_ty[4] = 36
v_ty[5] = 36

create_array(v_shown, v_slots, numeric)   # digit on display (-1 = dark)
create_array(v_want, v_slots, numeric)    # digit the time calls for
create_array(v_anim, v_slots, numeric)    # frames into a digit change (-1 = none)
create_array(v_from, v_slots, numeric)
create_array(v_flick, v_slots, numeric)   # frames of flicker left
create_array(v_cel, v_slots, numeric)     # cel last sent (-1 = hidden)

def read_time {
    if v_24h == 1 then
        v_hr = get_datetime("H")
    else
        v_hr = get_datetime("h")
    endif
    v_mn = get_datetime("mi")
    v_sc = get_datetime("s")
    v_want[0] = floor(v_hr / 10)
    if v_want[0] == 0 and v_24h == 0 then
        v_want[0] = -1
    endif
    v_want[1] = v_hr % 10
    v_want[2] = floor(v_mn / 10)
    v_want[3] = v_mn % 10
    v_want[4] = floor(v_sc / 10)
    v_want[5] = v_sc % 10
}

# send cel v_c for slot v_p (-1 hides the digit, the tube stays)
def set_cel {
    if v_c != v_cel[v_p] then
        if v_c < 0 then
            if v_p < 4 then
                hide_sprite(nix_big, v_p)
            else
                hide_sprite(nix_small, v_p)
            endif
        else
            if v_cel[v_p] < 0 then
                if v_p < 4 then
                    show_sprite(nix_big, v_tx[v_p] + 2, v_ty[v_p] + 7, v_p, 2, v_c)
                else
                    show_sprite(nix_small, v_tx[v_p] + 1, v_ty[v_p] + 4, v_p, 2, v_c)
                endif
            else
                if v_p < 4 then
                    move_sprite(nix_big, v_tx[v_p] + 2, v_ty[v_p] + 7, v_p, v_c)
                else
                    move_sprite(nix_small, v_tx[v_p] + 1, v_ty[v_p] + 4, v_p, v_c)
                endif
            endif
        endif
        v_cel[v_p] = v_c
    endif
}

# ---------------- Start ----------------
for v_p in (0, v_slots - 1, 1)
    if v_p < 4 then
        show_sprite(tube_big, v_tx[v_p], v_ty[v_p], v_p, 0, 0)
    else
        show_sprite(tube_small, v_tx[v_p], v_ty[v_p], v_p, 0, 0)
    endif
    v_shown[v_p] = -1
    v_anim[v_p] = -1
    v_flick[v_p] = 0
    v_cel[v_p] = -1
endfor v_p
call read_time

v_sweep = 120          # start with a sweep (warming up the tubes)
v_last_min = get_datetime("mi")
v_frame = 0

# ---------------- Main loop ----------------
while true then
    v_frame = v_frame + 1
    call read_time
    if v_mn != v_last_min then
        v_last_min = v_mn
        if v_sweep_every > 0 and v_mn % v_sweep_every == 0 then
            v_sweep = 120
        endif
    endif

    for v_p in (0, v_slots - 1, 1)
        if v_sweep > 0 then
            # anti-poisoning: spin through the digits, settle left to right
            v_settle = 25 + v_p * 14
            if 120 - v_sweep < v_settle then
                v_c = (floor(v_frame / 2) + v_p * 3) % 10
                v_shown[v_p] = v_want[v_p]
                v_anim[v_p] = -1
            else
                v_c = v_shown[v_p]
            endif
        else
            # start a change when the time moves on
            if v_want[v_p] != v_shown[v_p] and v_anim[v_p] < 0 then
                v_from[v_p] = v_shown[v_p]
                v_shown[v_p] = v_want[v_p]
                v_anim[v_p] = 0
            endif
            v_c = v_shown[v_p]
            if v_anim[v_p] >= 0 then
                # old digit dims out, new digit glows up (8 frames)
                v_a = v_anim[v_p]
                if v_a < 2 then
                    v_c = v_from[v_p] + 10
                elseif v_a < 4 then
                    v_c = v_from[v_p] + 20
                elseif v_a < 6 then
                    v_c = v_shown[v_p] + 20
                else
                    v_c = v_shown[v_p] + 10
                endif
                if v_from[v_p] < 0 and v_a < 4 then
                    v_c = -1
                endif
                v_anim[v_p] = v_a + 1
                if v_a >= 8 then
                    v_anim[v_p] = -1
                    v_c = v_shown[v_p]
                endif
            endif
            # flicker
            if v_flick[v_p] > 0 then
                v_flick[v_p] = v_flick[v_p] - 1
                if v_c >= 0 and v_c < 10 then
                    v_c = v_c + 10
                endif
            elseif random(0, 1, 4) < v_flicker then
                v_flick[v_p] = random(2, 6, 0)
            endif
        endif
        if v_shown[v_p] < 0 and v_sweep <= 0 and v_anim[v_p] < 0 then
            v_c = -1
        endif
        call set_cel
    endfor v_p
    if v_sweep > 0 then
        v_sweep = v_sweep - 1
    endif

    begin_frame
        # neon colon dots, blinking with the seconds
        if v_sc % 2 == 0 then
            v_cb = 90
        else
            v_cb = 25
        endif
        draw_rectangle(31, 11, 2, 2, 7, v_cb, true)
        draw_rectangle(31, 21, 2, 2, 7, v_cb, true)
        mplot(30, 11, 3, v_cb * 0.3)
        mplot(33, 12, 3, v_cb * 0.3)
        mplot(30, 21, 3, v_cb * 0.3)
        mplot(33, 22, 3, v_cb * 0.3)
        # wooden plinth with a warm reflection of the tubes
        draw_rectangle(0, 57, 64, 5, wood_brown, 28, true)
        draw_line(0, 57, 63, 57, 8, 30)
        draw_line(2, 58, 61, 58, 5, 16)
    end_frame
endwhile
