# Particle Clock - the time built from hundreds of 3D particles
#
# The hours and minutes are made of ~300 glowing particles hanging in
# space. When the minute changes the digits explode outward, the cloud
# swirls around while the camera tilts and orbits through it, then every
# particle flies home and the new time snaps together with a springy
# overshoot. A bright spark orbits the digits once a minute as the
# seconds hand.
#
# Colours drift slowly through the spectrum; fast-moving particles glow
# brighter, so the explosion flashes and the swirl leaves glints.

fps(40)
throttle(0)

# ---------------- Settings ----------------
v_24h = 0              # 1 = 24-hour clock, 0 = 12-hour
v_demo_every = 0       # >0: explode every N seconds instead of every minute (demo)
v_explode = 2.2        # explosion strength
v_cam_d = 70           # camera distance (smaller = stronger perspective)

# digit particle targets (2x2 particles per font cell)
create_array(v_dcount, 10, numeric)
create_array(v_dpx, 1000, numeric)
create_array(v_dpy, 1000, numeric)
v_dpx[0] = 2
v_dpy[0] = 0
