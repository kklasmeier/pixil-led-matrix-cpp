v_dpy[959] = 13
v_dcount[9] = 60

# ---------------- Particle pool ----------------
v_n = 320
create_array(v_px, v_n, numeric)
create_array(v_py, v_n, numeric)
create_array(v_pz, v_n, numeric)
create_array(v_vx, v_n, numeric)
create_array(v_vy, v_n, numeric)
create_array(v_vz, v_n, numeric)
create_array(v_hx, v_n, numeric)    # home (target) position
create_array(v_hy, v_n, numeric)
create_array(v_hz, v_n, numeric)
create_array(v_dl, v_n, numeric)    # per-particle return delay
create_array(v_sh, v_n, numeric)    # per-particle hue offset

# digit slot left edges (screen x) for H H : M M
create_array(v_slot_x, 4, numeric)
v_slot_x[0] = 5
v_slot_x[1] = 18
v_slot_x[2] = 37
v_slot_x[3] = 50
v_top = 25

create_array(v_tgx, 400, numeric)
create_array(v_tgy, 400, numeric)

# build the target point list for the current time and give every
# particle a home on it (extra particles double up on random points)
def build_targets {
    if v_24h == 1 then
        v_hr = get_datetime("H")
    else
        v_hr = get_datetime("h")
    endif
    v_mn = get_datetime("mi")
    v_tc = 0
    v_shift = 0
    if v_hr < 10 and v_24h == 0 then
        v_shift = -6
    endif
    for v_s in (0, 3, 1)
        if v_s == 0 then
            v_d = floor(v_hr / 10)
        elseif v_s == 1 then
            v_d = v_hr % 10
        elseif v_s == 2 then
            v_d = floor(v_mn / 10)
        else
            v_d = v_mn % 10
        endif
        if v_s == 0 and v_d == 0 and v_24h == 0 then
            v_d = -1
        endif
        if v_d >= 0 then
            for v_k in (0, v_dcount[v_d] - 1, 1)
                v_tgx[v_tc] = v_slot_x[v_s] + v_dpx[v_d * 100 + v_k] - 32 + v_shift
                v_tgy[v_tc] = v_top + v_dpy[v_d * 100 + v_k] - 32
                v_tc = v_tc + 1
            endfor v_k
        endif
    endfor v_s
    # colon
    for v_k in (0, 3, 1)
        v_tgx[v_tc] = 31 + v_k % 2 - 32 + v_shift
        v_tgy[v_tc] = 29 + floor(v_k / 2) - 32
        v_tgx[v_tc + 4] = 31 + v_k % 2 - 32 + v_shift
        v_tgy[v_tc + 4] = 35 + floor(v_k / 2) - 32
    endfor v_k
    v_tc = v_tc + 8
    # assign: start at a random offset so particles change places each minute
    v_off = random(0, v_n - 1, 0)
    for v_i in (0, v_n - 1, 1)
        v_j = (v_i + v_off) % v_n
        if v_j < v_tc then
            v_t = v_j
        else
            v_t = random(0, v_tc - 1, 0)
        endif
        v_hx[v_i] = v_tgx[v_t] + 0.5
        v_hy[v_i] = v_tgy[v_t] + 0.5
        v_hz[v_i] = random(-0.6, 0.6, 2)
    endfor v_i
}

# blow the particles outward from the centre, with a twist
def explode {
    for v_i in (0, v_n - 1, 1)
        v_a = random(0, 6.283, 3)
        v_e = random(-1, 1, 3)
        v_r = v_explode * random(0.5, 1.4, 2)
        v_cxy = sqrt(1 - v_e * v_e)
        v_vx[v_i] = v_vx[v_i] + v_px[v_i] * 0.05 + cos(v_a) * v_cxy * v_r
        v_vy[v_i] = v_vy[v_i] + v_py[v_i] * 0.05 + sin(v_a) * v_cxy * v_r
        v_vz[v_i] = v_vz[v_i] + v_e * v_r * 1.3
        v_dl[v_i] = random(0, 30, 0)
    endfor v_i
    v_ev = 0
}

# ---------------- Start: particles begin as a scattered cloud ----------------
for v_i in (0, v_n - 1, 1)
    v_px[v_i] = random(-40, 40, 1)
    v_py[v_i] = random(-40, 40, 1)
    v_pz[v_i] = random(-40, 40, 1)
    v_vx[v_i] = 0
    v_vy[v_i] = 0
    v_vz[v_i] = 0
    v_sh[v_i] = random(-6, 6, 1)
    v_dl[v_i] = random(0, 30, 0)
endfor v_i
call build_targets
v_ev = 40              # frames since the last explosion (start mid-return)
v_ev_len = 170
v_last_min = get_datetime("mi")
v_last_demo = get_datetime("s")
v_frame = 0
v_yaw0 = random(0, 1, 0) * 2 - 1

# ---------------- Main loop ----------------
while true then
    v_frame = v_frame + 1
    v_sc = get_datetime("s")
    v_mn = get_datetime("mi")
    v_go = 0
    if v_demo_every > 0 then
        if v_sc != v_last_demo and v_sc % v_demo_every == 0 then
            v_go = 1
        endif
        v_last_demo = v_sc
    elseif v_mn != v_last_min then
        v_go = 1
    endif
    if v_go == 1 then
        v_last_min = v_mn
        call explode
        call build_targets
        v_yaw0 = -v_yaw0
    endif

    # ---- event phase: 0 = just exploded ... v_ev_len = settled ----
    if v_ev < v_ev_len then
        v_ev = v_ev + 1
    endif
    v_u = v_ev / v_ev_len
    v_hump = sin(v_u * 3.14159)
    # spring strength ramps up after the burst, swirl fades out
    v_k = max(0, min(1, (v_ev - 35) / 70))
    v_swirl = 0.06 * (1 - v_k) * min(1, v_ev / 10)
    v_cs = cos(v_swirl)
    v_ss = sin(v_swirl)

    # ---- camera: gentle sway, plus a big orbit and tilt during an event ----
    v_ease = v_u * v_u * (3 - 2 * v_u)
    v_yaw = sin(v_frame * 0.011) * 0.22 + v_yaw0 * 6.2832 * v_ease
    if v_ev >= v_ev_len then
        v_yaw = sin(v_frame * 0.011) * 0.22
    endif
    v_pitch = sin(v_frame * 0.0077) * 0.15 + 0.75 * v_hump
    v_cy = cos(v_yaw)
    v_sy = sin(v_yaw)
    v_cp = cos(v_pitch)
    v_sp = sin(v_pitch)
    v_zoom = 1 + 0.25 * v_hump

    # colour drifts through the spectrum, once every ~10 minutes
    v_hue = (v_frame * 0.004) % 100

    begin_frame
        for v_i in (0, v_n - 1, 1)
            v_x = v_px[v_i]
            v_y = v_py[v_i]
            v_z = v_pz[v_i]
            # swirl around the vertical axis
            if v_swirl > 0 then
                v_t = v_x * v_cs - v_z * v_ss
                v_z = v_x * v_ss + v_z * v_cs
                v_x = v_t
            endif
            # spring home (each particle starts its return a little later)
            v_kk = v_k
            if v_ev < v_ev_len then
                v_kk = max(0, min(1, (v_ev - 35 - v_dl[v_i]) / 60))
            endif
            v_ax = (v_hx[v_i] - v_x) * 0.05 * v_kk
            v_ay = (v_hy[v_i] - v_y) * 0.05 * v_kk
            v_az = (v_hz[v_i] - v_z) * 0.05 * v_kk
            v_drag = 0.955 - 0.13 * v_kk
            v_vx[v_i] = (v_vx[v_i] + v_ax) * v_drag
            v_vy[v_i] = (v_vy[v_i] + v_ay) * v_drag
            v_vz[v_i] = (v_vz[v_i] + v_az) * v_drag
            v_x = v_x + v_vx[v_i]
            v_y = v_y + v_vy[v_i]
            v_z = v_z + v_vz[v_i]
            v_px[v_i] = v_x
            v_py[v_i] = v_y
            v_pz[v_i] = v_z

            # project
            v_x1 = v_x * v_cy + v_z * v_sy
            v_z1 = v_z * v_cy - v_x * v_sy
            v_y1 = v_y * v_cp - v_z1 * v_sp
            v_z2 = v_y * v_sp + v_z1 * v_cp
            v_dd = v_cam_d + v_z2
            if v_dd > 8 then
                v_s = v_cam_d * v_zoom / v_dd
                v_sx = 32 + v_x1 * v_s
                v_sy2 = 32 + v_y1 * v_s
                if v_sx >= 0 and v_sx < 64 and v_sy2 >= 0 and v_sy2 < 64 then
                    v_spd = abs(v_vx[v_i]) + abs(v_vy[v_i]) + abs(v_vz[v_i])
                    v_b = min(100, 72 + v_spd * 22 - v_z2 * 0.6)
                    v_c = floor(v_hue + v_sh[v_i] + v_sx * 0.35) % 100
                    mplot(v_sx, v_sy2, v_c, max(12, v_b))
                endif
            endif
        endfor v_i

        # seconds spark: orbits the digits in 3D once a minute
        v_a = (v_sc + (v_frame % 40) / 40) / 60 * 6.2832 - 1.5708
        v_x = cos(v_a) * 30
        v_y = sin(v_a) * 19
        v_z = sin(v_a * 2) * 6
        v_x1 = v_x * v_cy + v_z * v_sy
        v_z1 = v_z * v_cy - v_x * v_sy
        v_y1 = v_y * v_cp - v_z1 * v_sp
        v_z2 = v_y * v_sp + v_z1 * v_cp
        v_s = v_cam_d * v_zoom / (v_cam_d + v_z2)
        v_sx = 32 + v_x1 * v_s
        v_sy2 = 32 + v_y1 * v_s
        mplot(v_sx, v_sy2, white, 100)
        mplot(v_sx + 1, v_sy2, white, 35)
        mplot(v_sx - 1, v_sy2, white, 35)
        mplot(v_sx, v_sy2 + 1, white, 35)
        mplot(v_sx, v_sy2 - 1, white, 35)
    end_frame
endwhile
