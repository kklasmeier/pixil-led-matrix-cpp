# Layer Walk — a forest path with real depth
#
# A fox patrols a meadow trail between far pines and near trees. A rabbit
# hops through now and then. Birds cross the sky and sometimes duck
# behind the near trees, then pop out again. Fireflies blink in the
# foreground, pollen drifts, and the grass tips sway in a light breeze.
# The sky and clouds scroll under everything.
#
# How the depth is built (back → front):
#   backgrounds 0–1  sky + clouds (always under drawing layers)
#   layer 5          meadow ground, path, flowers (drawn once)
#   layer 10         far pines (drawn once)
#   layer 15         “behind near trees” band (birds duck here)
#   layer 18         fox + rabbit (between the two tree bands)
#   layer 25         near trees (drawn once; occludes midband)
#   layer 30         birds when flying in front of the near trees
#   layer 40         fireflies, pollen, swaying grass (redrawn each frame)
#
# Longevity comes from independent clocks: fox walk/pause, rabbit visits,
# bird crossings with random depth changes, and soft ambient loops.

clear()
throttle(0)
fps(30)

# ---------------- Backgrounds ----------------
define_sprite(sky, 128, 64)
    draw_rectangle(0, 0, 128, 14, navy, 92, true)
    draw_rectangle(0, 14, 128, 12, royal_blue, 78, true)
    draw_rectangle(0, 26, 128, 10, sky_blue, 62, true)
    draw_rectangle(0, 36, 128, 10, azure, 42, true)
    draw_rectangle(0, 46, 128, 18, forest_green, 28, true)
    # late-day sun
    draw_circle(108, 10, 6, gold, 22, true)
    draw_circle(108, 10, 4, yellow, 80, true)
    draw_circle(108, 10, 2, white, 70, true)
endsprite

define_sprite(clouds, 128, 64)
    draw_ellipse(18, 12, 10, 3, white, 28, true, 0)
    draw_ellipse(24, 11, 7, 2, white, 34, true, 0)
    draw_ellipse(52, 16, 12, 3, white, 24, true, 0)
    draw_ellipse(58, 15, 8, 2, white, 30, true, 0)
    draw_ellipse(90, 10, 9, 3, white, 26, true, 0)
    draw_ellipse(96, 9, 6, 2, white, 32, true, 0)
    draw_ellipse(118, 14, 8, 2, white, 22, true, 0)
endsprite

# ---------------- Fox (walk cycle, right-facing) ----------------
define_sprite(fox_r, 7, 4)
    sprite_cel(0)
        plot(1, 1, orange, 100)
        plot(2, 0, orange, 100)
        plot(2, 1, orange, 100)
        plot(2, 2, orange, 100)
        plot(3, 1, orange, 100)
        plot(3, 2, orange, 90)
        plot(4, 0, orange, 90)
        plot(4, 1, white, 100)
        plot(5, 1, orange, 85)
        plot(2, 3, dark_brown, 80)
        plot(4, 3, dark_brown, 80)
    sprite_cel(1)
        plot(1, 1, orange, 100)
        plot(2, 0, orange, 100)
        plot(2, 1, orange, 100)
        plot(2, 2, orange, 100)
        plot(3, 1, orange, 100)
        plot(3, 2, orange, 90)
        plot(4, 0, orange, 90)
        plot(4, 1, white, 100)
        plot(5, 1, orange, 85)
        plot(1, 3, dark_brown, 80)
        plot(3, 3, dark_brown, 80)
        plot(5, 3, dark_brown, 70)
    sprite_cel(2)
        plot(1, 1, orange, 100)
        plot(2, 0, orange, 100)
        plot(2, 1, orange, 100)
        plot(2, 2, orange, 100)
        plot(3, 1, orange, 100)
        plot(3, 2, orange, 90)
        plot(4, 0, orange, 90)
        plot(4, 1, white, 100)
        plot(5, 1, orange, 85)
        plot(2, 3, dark_brown, 80)
        plot(4, 3, dark_brown, 80)
    sprite_cel(3)
        plot(1, 1, orange, 100)
        plot(2, 0, orange, 100)
        plot(2, 1, orange, 100)
        plot(2, 2, orange, 100)
        plot(3, 1, orange, 100)
        plot(3, 2, orange, 90)
        plot(4, 0, orange, 90)
        plot(4, 1, white, 100)
        plot(5, 1, orange, 85)
        plot(3, 3, dark_brown, 80)
        plot(5, 3, dark_brown, 70)
endsprite

