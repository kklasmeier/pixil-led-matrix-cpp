        plot(5, 1, orange, 100)
        plot(4, 0, orange, 100)
        plot(4, 1, orange, 100)
        plot(4, 2, orange, 100)
        plot(3, 1, orange, 100)
        plot(3, 2, orange, 90)
        plot(2, 0, orange, 90)
        plot(2, 1, white, 100)
        plot(1, 1, orange, 85)
        plot(5, 3, dark_brown, 80)
        plot(3, 3, dark_brown, 80)
        plot(1, 3, dark_brown, 70)
    sprite_cel(2)
        plot(5, 1, orange, 100)
        plot(4, 0, orange, 100)
        plot(4, 1, orange, 100)
        plot(4, 2, orange, 100)
        plot(3, 1, orange, 100)
