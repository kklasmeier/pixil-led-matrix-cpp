# ---------------- Rabbit (hop) ----------------
define_sprite(rabbit, 5, 4)
    sprite_cel(0)
        plot(1, 1, white, 95)
        plot(2, 1, white, 100)
        plot(2, 2, white, 90)
        plot(3, 1, white, 95)
        plot(3, 0, pink, 70)
        plot(1, 0, pink, 60)
        plot(2, 3, gray, 70)
    sprite_cel(1)
        plot(1, 0, white, 95)
        plot(2, 0, white, 100)
        plot(2, 1, white, 90)
        plot(3, 0, white, 95)
        plot(1, 0, pink, 55)
        plot(3, 0, pink, 70)
        plot(4, 1, white, 80)
        plot(1, 2, gray, 60)
    sprite_cel(2)
        plot(1, 1, white, 95)
        plot(2, 1, white, 100)
        plot(2, 2, white, 90)
        plot(3, 1, white, 95)
        plot(3, 0, pink, 70)
        plot(1, 0, pink, 60)
        plot(3, 3, gray, 70)
endsprite

# ---------------- Bird ----------------
define_sprite(bird, 5, 3)
    sprite_cel(0)
        plot(0, 1, dark_gray, 80)
        plot(1, 1, gray, 90)
        plot(2, 1, white, 95)
        plot(3, 1, gray, 85)
        plot(4, 1, dark_gray, 70)
        plot(1, 0, gray, 60)
        plot(3, 0, gray, 60)
    sprite_cel(1)
        plot(0, 1, dark_gray, 80)
        plot(1, 1, gray, 90)
        plot(2, 1, white, 95)
        plot(3, 1, gray, 85)
        plot(4, 1, dark_gray, 70)
        plot(2, 0, gray, 75)
    sprite_cel(2)
        plot(0, 1, dark_gray, 80)
        plot(1, 1, gray, 90)
        plot(2, 1, white, 95)
        plot(3, 1, gray, 85)
        plot(4, 1, dark_gray, 70)
        plot(1, 2, gray, 55)
        plot(3, 2, gray, 55)
endsprite

# ---------------- Static scenery ----------------
def draw_ground {
    draw_rectangle(0, 46, 64, 18, forest_green, 48, true)
    draw_rectangle(0, 44, 64, 4, green, 55, true)
    # worn path
    draw_ellipse(32, 50, 22, 5, olive, 40, true, 0)
    draw_ellipse(32, 51, 16, 3, dark_brown, 28, true, 0)
    # wildflowers
    for v_i in (0, 9, 1)
        v_fx = 3 + v_i * 6 + (v_i * 3) % 4
        v_fy = 48 + (v_i * 5) % 6
        if abs(v_fx - 32) > 14 then
            plot(v_fx, v_fy, yellow, 70)
            plot(v_fx + 1, v_fy - 1, white, 55)
            if v_i % 3 == 0 then
                plot(v_fx - 1, v_fy, pink, 65)
            endif
            if v_i % 4 == 0 then
                plot(v_fx, v_fy - 1, lavender, 60)
            endif
        endif
    endfor v_i
}

def draw_far_trees {
    for v_i in (0, v_nft - 1, 1)
        v_x = v_ftx[v_i]
        draw_rectangle(v_x + 2, 30, 2, 14, brown, 55, true)
        draw_circle(v_x + 3, 28, 6, forest_green, 58, true)
        draw_circle(v_x + 1, 30, 4, green, 40, true)
    endfor v_i
    # soft distant ridge under the pines
    draw_ellipse(20, 42, 18, 4, olive, 25, true, 0)
    draw_ellipse(48, 43, 14, 3, olive, 22, true, 0)
}

def draw_near_trees {
    for v_i in (0, v_nnt - 1, 1)
        v_x = v_ntx[v_i]
        draw_rectangle(v_x + 3, 20, 4, 30, dark_brown, 88, true)
        draw_circle(v_x + 5, 18, 9, green, 90, true)
        draw_circle(v_x + 2, 22, 6, lime, 55, true)
        draw_circle(v_x + 8, 24, 5, forest_green, 70, true)
        plot(v_x + 4, 28, brown, 50)
        plot(v_x + 5, 34, brown, 45)
    endfor v_i
    # low bushes between trunks
    draw_ellipse(12, 42, 5, 3, forest_green, 75, true, 0)
    draw_ellipse(30, 43, 6, 3, green, 70, true, 0)
    draw_ellipse(48, 42, 5, 3, forest_green, 72, true, 0)
}

# ---------------- Ambient (redrawn) ----------------
def draw_ambient {
    clear_layer(40)
    set_layer(40)

    # swaying near-grass tips
    for v_g in (0, 31, 1)
        v_gx = v_g * 2
        v_sway = sin(v_t * 0.07 + v_g * 0.55) * 1.2
        v_gh = 2 + (v_g * 3) % 3
        draw_line(v_gx, 63, v_gx + v_sway, 63 - v_gh, lime, 45 + (v_g % 3) * 8)
    endfor v_g

    # fireflies
    for v_i in (0, v_nff - 1, 1)
        v_ffx[v_i] = v_ffx[v_i] + sin(v_t * 0.05 + v_i * 1.7) * 0.18
        v_ffy[v_i] = v_ffy[v_i] + cos(v_t * 0.04 + v_i * 2.1) * 0.12
        v_ffx[v_i] = min(max(v_ffx[v_i], 1), 62)
        v_ffy[v_i] = min(max(v_ffy[v_i], 18), 50)
        v_glow = sin(v_t * 0.09 + v_ffp[v_i])
        if v_glow > 0.35 then
            mplot(v_ffx[v_i], v_ffy[v_i], lime, (v_glow - 0.3) * 140)
            if v_glow > 0.7 then
                mplot(v_ffx[v_i] + 1, v_ffy[v_i], yellow, 35)
            endif
        endif
    endfor v_i

    # drifting pollen / dust motes
    for v_i in (0, v_np - 1, 1)
        v_px[v_i] = v_px[v_i] + 0.15 + sin(v_t * 0.03 + v_i) * 0.08
        v_py[v_i] = v_py[v_i] + cos(v_t * 0.05 + v_i * 1.3) * 0.1
        if v_px[v_i] > 66 then
            v_px[v_i] = 0 - 2
            v_py[v_i] = random(10, 40, 0)
        endif
        if v_py[v_i] < 6 then
            v_py[v_i] = 42
        endif
        if v_py[v_i] > 48 then
            v_py[v_i] = 12
        endif
        mplot(v_px[v_i], v_py[v_i], white, 18 + (v_i % 4) * 6)
    endfor v_i
}

# ---------------- Actors ----------------
def place_fox {
    # show the facing sprite on the mid animal layer
    set_layer(18)
    if v_fdir > 0 then
        hide_sprite(fox_l)
        show_sprite(fox_r, v_fx, v_fy, 0, 1, 0)
    else
        hide_sprite(fox_r)
        show_sprite(fox_l, v_fx, v_fy, 0, 1, 0)
    endif
}

def update_fox {
    if v_fpause > 0 then
        v_fpause = v_fpause - 1
        # hold still on cel 0 while sniffing
        if v_fdir > 0 then
            move_sprite(fox_r, v_fx, v_fy, 0, 0)
        else
            move_sprite(fox_l, v_fx, v_fy, 0, 0)
        endif
    else
        v_fx = v_fx + v_fdir * 0.55
        if v_fx >= 52 then
            v_fx = 52
            v_fdir = 0 - 1
            call place_fox
            v_fpause = random(18, 40, 0)
        endif
        if v_fx <= 2 then
            v_fx = 2
            v_fdir = 1
            call place_fox
            v_fpause = random(18, 40, 0)
        endif

        # occasional mid-path sniff
        if random(0, 220, 0) == 0 then
            v_fpause = random(20, 45, 0)
        endif

        if v_fdir > 0 then
            move_sprite(fox_r, v_fx, v_fy, 0)
        else
            move_sprite(fox_l, v_fx, v_fy, 0)
        endif
    endif
}

def update_rabbit {
    if v_rstate == 0 then
        # waiting for next visit
        v_rwait = v_rwait - 1
        if v_rwait <= 0 then
            v_rstate = 1
            if random(0, 1, 0) == 0 then
                v_rx = 0 - 6
                v_rdir = 1
            else
                v_rx = 66
                v_rdir = 0 - 1
            endif
            v_ry = 42 + random(0, 2, 0)
            set_layer(18)
            show_sprite(rabbit, v_rx, v_ry, 0, 0, 0)
        endif
    else
        # hopping across
        v_rx = v_rx + v_rdir * 0.9
        v_ry = 42 + abs(sin(v_t * 0.35)) * 2
        move_sprite(rabbit, v_rx, v_ry, 0)
        if (v_rdir > 0 and v_rx > 68) or (v_rdir < 0 and v_rx < 0 - 8) then
            hide_sprite(rabbit)
            v_rstate = 0
            v_rwait = random(90, 220, 0)
        endif
    endif
}

def spawn_bird {
    v_i = v_spawn_i
    v_bx[v_i] = 0 - 6
    v_by[v_i] = random(8, 28, 0)
    v_bs[v_i] = 0.35 + random(0, 40, 0) / 100
    v_bl[v_i] = 30
    v_bd[v_i] = random(40, 120, 0)
    set_layer(30)
    show_sprite(bird, v_bx[v_i], v_by[v_i], v_i, 0, 0)
}

def update_birds {
    for v_i in (0, v_nb - 1, 1)
        if v_balive[v_i] == 0 then
            v_btimer[v_i] = v_btimer[v_i] - 1
            if v_btimer[v_i] <= 0 then
                v_balive[v_i] = 1
                v_spawn_i = v_i
                call spawn_bird
            endif
        else
            v_bx[v_i] = v_bx[v_i] + v_bs[v_i]
            v_by[v_i] = v_by[v_i] + sin(v_t * 0.08 + v_i * 2) * 0.15
            move_sprite(bird, v_bx[v_i], v_by[v_i], v_i)

            # sometimes duck behind the near trees, then emerge
            v_bd[v_i] = v_bd[v_i] - 1
            if v_bd[v_i] <= 0 then
                v_bd[v_i] = random(50, 140, 0)
                if v_bl[v_i] == 30 then
                    # only duck while crossing the tree band
                    if v_bx[v_i] > 8 and v_bx[v_i] < 50 then
                        set_sprite_layer(bird, 15, v_i)
                        v_bl[v_i] = 15
                    endif
                else
                    set_sprite_layer(bird, 30, v_i)
                    v_bl[v_i] = 30
                endif
            endif

            if v_bx[v_i] > 70 then
                hide_sprite(bird, v_i)
                v_balive[v_i] = 0
                v_btimer[v_i] = random(40, 160, 0)
            endif
        endif
    endfor v_i
}

# ---------------- State ----------------
v_t = 0

v_nft = 5
create_array(v_ftx, v_nft, numeric)
v_ftx[0] = 2
v_ftx[1] = 12
v_ftx[2] = 28
v_ftx[3] = 44
v_ftx[4] = 56

v_nnt = 4
create_array(v_ntx, v_nnt, numeric)
v_ntx[0] = 0
v_ntx[1] = 18
v_ntx[2] = 38
v_ntx[3] = 54

v_nff = 8
create_array(v_ffx, v_nff, numeric)
create_array(v_ffy, v_nff, numeric)
create_array(v_ffp, v_nff, numeric)
for v_i in (0, v_nff - 1, 1)
    v_ffx[v_i] = random(2, 61, 0)
    v_ffy[v_i] = random(20, 48, 0)
    v_ffp[v_i] = random(0, 628, 0) / 100
endfor v_i

v_np = 12
create_array(v_px, v_np, numeric)
create_array(v_py, v_np, numeric)
for v_i in (0, v_np - 1, 1)
    v_px[v_i] = random(0, 63, 0)
    v_py[v_i] = random(8, 42, 0)
endfor v_i

v_fx = 8
v_fy = 41
v_fdir = 1
v_fpause = 0

v_rstate = 0
v_rwait = 60
v_rx = 0
v_ry = 42
v_rdir = 1

v_nb = 3
create_array(v_bx, v_nb, numeric)
create_array(v_by, v_nb, numeric)
create_array(v_bs, v_nb, numeric)
create_array(v_bl, v_nb, numeric)
create_array(v_bd, v_nb, numeric)
create_array(v_balive, v_nb, numeric)
create_array(v_btimer, v_nb, numeric)
for v_i in (0, v_nb - 1, 1)
    v_balive[v_i] = 0
    v_btimer[v_i] = 20 + v_i * 55
endfor v_i
v_spawn_i = 0

# ---------------- Scenery setup (one present) ----------------
set_background(sky, 0)
set_background(clouds, 1)

begin_frame
    set_layer(5)
    call draw_ground

    set_layer(10)
    call draw_far_trees

    # ensure mid / duck bands exist for sprites
    set_layer(15)
    set_layer(18)
    call place_fox

    set_layer(25)
    call draw_near_trees

    set_layer(30)
    set_layer(40)
end_frame

# ---------------- Main loop ----------------
while true then
    v_t = v_t + 1

    begin_frame(true)
        # soft parallax under the diorama
        if v_t - floor(v_t / 3) * 3 == 0 then
            nudge_background(1, 0, 0)
        endif
        nudge_background(1, 0, 1)

        call update_fox
        call update_rabbit
        call update_birds
        call draw_ambient
    end_frame
endwhile
