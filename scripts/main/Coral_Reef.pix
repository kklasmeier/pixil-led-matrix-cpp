# Coral Reef - a slow drift along a sunlit tropical reef
#
# The view pans gently back and forth along a reef. Shafts of sunlight sway
# through the water, light ripples dance across the sand, kelp and anemones
# sway in the current and bubbles rise to the shimmering surface. Reef fish
# of several kinds patrol the coral and turn around at the ends, a school of
# little silver fish swirls around, a sea turtle glides past in the blue,
# and jellyfish pulse up and down.
#
# How it is built:
#   - Three depths of scenery move at different speeds as the view pans
#     (far reef silhouettes, the main reef, the front plants), which gives
#     a strong sense of depth.
#   - The reef is generated randomly at start: rocks, branching coral grown
#     by splitting branches, brain coral, sea fans, tube sponges and starfish.
#   - Light shafts are drawn row by row as slightly brighter water; the sand
#     ripples are a sum of moving sine waves where the peaks light up.
#   - Fish are drawn from ellipses and lines. Their tails beat while they
#     swim, and they squash flat as they turn around.

fps(60)
throttle(0)

v_pace = 1.7
v_world = 140           # width of the front layer
v_sandy = 53            # rough height of the sand
v_t = 0

# ---------------- Sand profile (front layer) ----------------
create_array(v_sand, v_world + 1, numeric)
v_p1 = random(0, 300, 0) / 100
v_p2 = random(0, 300, 0) / 100
for v_x in (0, v_world, 1)
    v_sand[v_x] = v_sandy + sin(v_x * 0.07 + v_p1) * 2 + sin(v_x * 0.19 + v_p2) * 1
endfor v_x

# ---------------- Far reef silhouettes ----------------
v_nfar = 10
create_array(v_fx, v_nfar, numeric)
create_array(v_fw, v_nfar, numeric)
create_array(v_fh, v_nfar, numeric)
for v_k in (0, v_nfar - 1, 1)
    v_fx[v_k] = v_k * 10 + random(-3, 3, 0)
    v_fw[v_k] = random(6, 11, 0)
    v_fh[v_k] = random(5, 12, 0)
endfor v_k

# ---------------- Main reef: rocks and coral ----------------
v_nrock = 8
create_array(v_rkx, v_nrock, numeric)
create_array(v_rkw, v_nrock, numeric)
create_array(v_rkh, v_nrock, numeric)
for v_k in (0, v_nrock - 1, 1)
    v_rkx[v_k] = 8 + v_k * 15 + random(-4, 4, 0)
    v_rkw[v_k] = random(5, 9, 0)
    v_rkh[v_k] = random(3, 6, 0)
endfor v_k

# coral pieces: type 1 branching, 2 brain, 3 fan, 4 tube sponge
v_ncor = 14
create_array(v_cty, v_ncor, numeric)
create_array(v_cx, v_ncor, numeric)
create_array(v_cy, v_ncor, numeric)
create_array(v_cs, v_ncor, numeric)
create_array(v_cc, v_ncor, string)
create_array(v_cc2, v_ncor, string)
create_array(v_csg0, v_ncor, numeric)    # first branch segment
create_array(v_csg1, v_ncor, numeric)    # last branch segment
# branch segments for branching coral (relative to the coral base)
v_maxseg = 200
create_array(v_sgx0, v_maxseg, numeric)
create_array(v_sgy0, v_maxseg, numeric)
create_array(v_sgx1, v_maxseg, numeric)
create_array(v_sgy1, v_maxseg, numeric)
create_array(v_sgd, v_maxseg, numeric)
v_nseg = 0
# a work queue for growing branches
create_array(v_qbx, 40, numeric)
create_array(v_qby, 40, numeric)
create_array(v_qba, 40, numeric)
create_array(v_qbl, 40, numeric)
create_array(v_qbd, 40, numeric)

create_array(v_palette, 8, string)
v_palette[0] = "magenta"
v_palette[1] = "coral"
v_palette[2] = "orange"
v_palette[3] = "violet"
v_palette[4] = "pink"
v_palette[5] = "gold"
v_palette[6] = "salmon"
v_palette[7] = "lavender"

def grow_branches {
    # grow one branching coral of size v_gsz into the segment list
    v_qn = 1
    v_qh = 0
    v_qbx[0] = 0
    v_qby[0] = 0
    v_qba[0] = -1.5708 + random(-20, 20, 0) / 100
    v_qbl[0] = v_gsz
    v_qbd[0] = 0
    while v_qh < v_qn and v_nseg < v_maxseg then
        v_bx = v_qbx[v_qh]
        v_by = v_qby[v_qh]
        v_ba = v_qba[v_qh]
        v_bl = v_qbl[v_qh]
        v_bd = v_qbd[v_qh]
        v_qh = v_qh + 1
        v_ex = v_bx + cos(v_ba) * v_bl
        v_ey = v_by + sin(v_ba) * v_bl
        v_sgx0[v_nseg] = v_bx
        v_sgy0[v_nseg] = v_by
        v_sgx1[v_nseg] = v_ex
        v_sgy1[v_nseg] = v_ey
        v_sgd[v_nseg] = v_bd
        v_nseg = v_nseg + 1
        if v_bd < 3 and v_qn < 38 then
            for v_side in (-1, 1, 2)
                v_qbx[v_qn] = v_ex
                v_qby[v_qn] = v_ey
                v_qba[v_qn] = v_ba + v_side * random(30, 60, 0) / 100
                v_qbl[v_qn] = v_bl * random(60, 80, 0) / 100
                v_qbd[v_qn] = v_bd + 1
                v_qn = v_qn + 1
            endfor v_side
        endif
    endwhile
}

for v_k in (0, v_ncor - 1, 1)
    v_rk = v_k % v_nrock
    v_cty[v_k] = random(1, 4, 0)
    v_cx[v_k] = v_rkx[v_rk] + random(-6, 6, 0)
    v_cy[v_k] = v_sandy - v_rkh[v_rk] + random(0, 3, 0)
    v_cs[v_k] = random(3, 6, 0)
    v_cc[v_k] = v_palette[random(0, 7, 0)]
    v_cc2[v_k] = v_palette[random(0, 7, 0)]
    if v_cty[v_k] == 1 then
        v_csg0[v_k] = v_nseg
        v_gsz = v_cs[v_k] * 0.8
        call grow_branches
        v_csg1[v_k] = v_nseg - 1
    endif
endfor v_k

# starfish on the sand (front layer)
v_nstar = 4
create_array(v_stx, v_nstar, numeric)
create_array(v_stc, v_nstar, string)
for v_k in (0, v_nstar - 1, 1)
    v_stx[v_k] = random(5, v_world - 5, 0)
    v_stc[v_k] = v_palette[random(0, 2, 0)]
endfor v_k

# ---------------- Front plants ----------------
v_nkelp = 7
create_array(v_kx, v_nkelp, numeric)
create_array(v_kh, v_nkelp, numeric)
create_array(v_kph, v_nkelp, numeric)
for v_k in (0, v_nkelp - 1, 1)
    v_kx[v_k] = random(3, v_world - 3, 0)
    v_kh[v_k] = random(6, 10, 0)
    v_kph[v_k] = random(0, 628, 0) / 100
endfor v_k
v_nanem = 4
create_array(v_ax, v_nanem, numeric)
create_array(v_ac, v_nanem, string)
for v_k in (0, v_nanem - 1, 1)
    v_ax[v_k] = 15 + v_k * 33 + random(-8, 8, 0)
    v_ac[v_k] = v_palette[random(3, 7, 0)]
endfor v_k

# ---------------- Fish ----------------
# kinds: 0 yellow disc fish, 1 blue fish with gold stripes,
#        2 long red fish, 3 small blue damsel, 4 big parrotfish
v_nfish = 7
create_array(v_fsx, v_nfish, numeric)
create_array(v_fsy, v_nfish, numeric)
create_array(v_fsd, v_nfish, numeric)     # heading: -1 or 1
create_array(v_fsk, v_nfish, numeric)     # kind
create_array(v_fsv, v_nfish, numeric)     # speed
create_array(v_fst, v_nfish, numeric)     # turn progress (0 = not turning)
create_array(v_fsp, v_nfish, numeric)     # phase
create_array(v_fsl, v_nfish, numeric)     # body length
create_array(v_fsh, v_nfish, numeric)     # body height
create_array(v_fcb, v_nfish, string)      # body colour
create_array(v_fcs, v_nfish, string)      # stripe colour
create_array(v_fct, v_nfish, string)      # tail / fin colour
for v_k in (0, v_nfish - 1, 1)
    v_fsk[v_k] = v_k % 5
    v_fsx[v_k] = random(10, v_world - 10, 0)
    v_fsy[v_k] = random(14, 44, 0)
    v_fsd[v_k] = random(0, 1, 0) * 2 - 1
    v_fst[v_k] = 0
    v_fsp[v_k] = random(0, 628, 0) / 100
    v_kd = v_fsk[v_k]
    if v_kd == 0 then
        v_fsl[v_k] = 3.5
        v_fsh[v_k] = 3
        v_fcb[v_k] = "yellow"
        v_fcs[v_k] = "black"
        v_fct[v_k] = "gold"
        v_fsv[v_k] = 0.12
    elseif v_kd == 1 then
        v_fsl[v_k] = 4
        v_fsh[v_k] = 2.5
        v_fcb[v_k] = "royal_blue"
        v_fcs[v_k] = "gold"
        v_fct[v_k] = "azure"
        v_fsv[v_k] = 0.15
    elseif v_kd == 2 then
        v_fsl[v_k] = 5
        v_fsh[v_k] = 1.8
        v_fcb[v_k] = "crimson"
        v_fcs[v_k] = "salmon"
        v_fct[v_k] = "red"
        v_fsv[v_k] = 0.2
    elseif v_kd == 3 then
        v_fsl[v_k] = 2.2
        v_fsh[v_k] = 1.4
        v_fcb[v_k] = "azure"
        v_fcs[v_k] = "cyan"
        v_fct[v_k] = "sky_blue"
        v_fsv[v_k] = 0.18
    else
        v_fsl[v_k] = 6
        v_fsh[v_k] = 2.8
        v_fcb[v_k] = "turquoise"
        v_fcs[v_k] = "magenta"
        v_fct[v_k] = "pink"
        v_fsv[v_k] = 0.1
    endif
endfor v_k

# school of small silver fish following a wandering leader
v_nsch = 12
create_array(v_scx, v_nsch, numeric)
create_array(v_scy, v_nsch, numeric)
create_array(v_scox, v_nsch, numeric)
create_array(v_scoy, v_nsch, numeric)
for v_k in (0, v_nsch - 1, 1)
    v_scox[v_k] = random(-60, 60, 0) / 10
    v_scoy[v_k] = random(-30, 30, 0) / 10
    v_scx[v_k] = 60
    v_scy[v_k] = 25
endfor v_k
v_slx = 60
v_sly = 25
v_sldir = 1

# jellyfish (mid-water, slow)
v_njel = 2
create_array(v_jx, v_njel, numeric)
create_array(v_jy, v_njel, numeric)
create_array(v_jp, v_njel, numeric)
for v_k in (0, v_njel - 1, 1)
    v_jx[v_k] = 30 + v_k * 50
    v_jy[v_k] = 20 + v_k * 8
    v_jp[v_k] = v_k * 2.1
endfor v_k

# turtle crossing in the distance now and then
v_tux = -30
v_tuy = 18
v_tud = 1
v_tuwait = 200

# bubbles and drifting specks
v_nbub = 10
create_array(v_bx, v_nbub, numeric)
create_array(v_by, v_nbub, numeric)
create_array(v_bs, v_nbub, numeric)
for v_k in (0, v_nbub - 1, 1)
    v_bx[v_k] = v_ax[v_k % v_nanem] + random(-2, 2, 0)
    v_by[v_k] = random(5, 55, 0)
    v_bs[v_k] = random(10, 25, 0) / 100
endfor v_k
v_nspk = 22
create_array(v_spx, v_nspk, numeric)
create_array(v_spy, v_nspk, numeric)
for v_k in (0, v_nspk - 1, 1)
    v_spx[v_k] = random(0, 63, 0)
    v_spy[v_k] = random(2, 50, 0)
endfor v_k

# ---------------- Drawing: water ----------------
def draw_water {
    # sunlight shafts: slanted bands that sway; drawn row by row as brighter water
    for v_y in (0, v_sandy + 4, 1)
        # hue shifts from turquoise-blue near the surface to deep blue
        v_wc = 52 + int(v_y * 0.16)
        v_wi = 48 - v_y * 0.55
        draw_line(0, v_y, 63, v_y, v_wc, v_wi)
        v_rb = 16 * (1 - v_y / 62)
        for v_r in (0, 3, 1)
            v_rx = v_r * 21 + 6 - v_cam * 0.2 + sin(v_t * 0.008 + v_r * 1.7) * 4
            v_rx = v_rx - floor(v_rx / 84) * 84 - 10
            v_rx = v_rx + v_y * (0.35 + v_r * 0.05)
            v_rw = 2 + v_y * 0.08 + v_r % 2
            if v_rx + v_rw >= 0 and v_rx <= 63 then
                draw_line(max(v_rx, 0), v_y, min(v_rx + v_rw, 63), v_y, v_wc, min(v_wi + v_rb, 100))
            endif
        endfor v_r
    endfor v_y
    # surface shimmer
    for v_x in (0, 63, 1)
        v_sv = sin((v_x + v_cam) * 0.45 + v_t * 0.09) + sin((v_x + v_cam) * 0.21 - v_t * 0.06)
        if v_sv > 1.1 then
            mplot(v_x, 0, white, 70)
        elseif v_sv > 0.3 then
            mplot(v_x, 0, sky_blue, 60)
        endif
    endfor v_x
}

def draw_far_reef {
    v_off = v_cam * 0.35
    for v_k in (0, v_nfar - 1, 1)
        v_xx = v_fx[v_k] - v_off
        if v_xx > -12 and v_xx < 76 then
            draw_ellipse(v_xx, v_sandy - 1, v_fw[v_k], v_fh[v_k], teal, 18, true, 0)
        endif
    endfor v_k
}

def draw_sand {
    for v_x in (0, 63, 1)
        v_wx = v_x + v_cam
        v_top = v_sand[int(v_wx)]
        draw_line(v_x, v_top, v_x, 63, tan, 34)
        mplot(v_x, v_top, peach, 45)
    endfor v_x
    # rippling light on the sand
    for v_y in (v_sandy - 1, 63, 1)
        for v_x in (v_y % 2, 63, 2)
            v_wx = v_x + v_cam
            if v_y > v_sand[int(v_wx)] then
                v_cv = sin(v_wx * 0.35 + v_y * 0.6 + v_t * 0.05) + sin(v_wx * 0.22 - v_y * 0.9 - v_t * 0.04) + sin((v_wx + v_y) * 0.13 + v_t * 0.03)
                if v_cv > 1.5 then
                    draw_line(v_x, v_y, v_x + 1, v_y, peach, 62 - (v_y - v_sandy) * 2)
                endif
            endif
        endfor v_x
    endfor v_y
    # starfish
    for v_k in (0, v_nstar - 1, 1)
        v_xx = v_stx[v_k] - v_cam
        if v_xx > -3 and v_xx < 67 then
            v_yy = v_sand[v_stx[v_k]] + 4
            for v_a in (0, 4, 1)
                v_an = v_a * 1.2566 - 1.5708
                draw_line(v_xx, v_yy, v_xx + cos(v_an) * 2.2, v_yy + sin(v_an) * 1.6, v_stc[v_k], 70)
            endfor v_a
        endif
    endfor v_k
}

# ---------------- Drawing: reef ----------------
def draw_reef {
    v_off = v_cam * 0.75
    for v_k in (0, v_nrock - 1, 1)
        v_xx = v_rkx[v_k] - v_off
        if v_xx > -12 and v_xx < 76 then
            draw_ellipse(v_xx, v_sandy, v_rkw[v_k], v_rkh[v_k], gray, 26, true, 0)
            draw_ellipse(v_xx - 1, v_sandy - 1, v_rkw[v_k] * 0.6, v_rkh[v_k] * 0.5, light_gray, 22, true, 0)
        endif
    endfor v_k
    for v_k in (0, v_ncor - 1, 1)
        v_xx = v_cx[v_k] - v_off
        v_yy = v_cy[v_k]
        v_sz = v_cs[v_k]
        if v_xx > -10 and v_xx < 74 then
            v_ty = v_cty[v_k]
            if v_ty == 1 then
                # branching coral with brighter tips
                v_sway = sin(v_t * 0.02 + v_k) * 0.3
                for v_g in (v_csg0[v_k], v_csg1[v_k], 1)
                    v_lean = v_sway * (v_sgd[v_g] + 1) * 0.3
                    draw_line(v_xx + v_sgx0[v_g] + v_lean * (0 - v_sgy0[v_g]) * 0.2, v_yy + v_sgy0[v_g], v_xx + v_sgx1[v_g] + v_lean * (0 - v_sgy1[v_g]) * 0.2, v_yy + v_sgy1[v_g], v_cc[v_k], 55 + v_sgd[v_g] * 12)
                endfor v_g
            elseif v_ty == 2 then
                # brain coral: dome with winding grooves
                draw_ellipse(v_xx, v_yy, v_sz * 0.9, v_sz * 0.6, v_cc[v_k], 55, true, 0)
                for v_g in (0, 2, 1)
                    v_gy = v_yy - v_sz * 0.4 + v_g * v_sz * 0.3
                    draw_line(v_xx - v_sz * 0.6, v_gy, v_xx + v_sz * 0.6, v_gy + sin(v_g * 2 + v_k) * 0.8, v_cc2[v_k], 40)
                endfor v_g
            elseif v_ty == 3 then
                # sea fan: ribs spreading from a stem, swaying
                v_sway = sin(v_t * 0.025 + v_k * 1.3) * 1.2
                for v_g in (0, 6, 1)
                    v_an = -2.6 + v_g * 0.35
                    draw_line(v_xx, v_yy, v_xx + cos(v_an) * v_sz * 1.3 + v_sway, v_yy + sin(v_an) * v_sz * 1.4, v_cc[v_k], 60)
                endfor v_g
                draw_ellipse(v_xx + v_sway * 0.6, v_yy - v_sz * 1.0, v_sz * 1.1, v_sz * 0.5, v_cc[v_k], 35, false, 0)
            else
                # tube sponges
                for v_g in (0, 2, 1)
                    v_th = v_sz * (0.8 + v_g * 0.35)
                    v_tx = v_xx - 2 + v_g * 2
                    draw_rectangle(v_tx, v_yy - v_th, 2, v_th, v_cc[v_k], 55, true)
                    mplot(v_tx, v_yy - v_th, v_cc2[v_k], 85)
                    mplot(v_tx + 1, v_yy - v_th, v_cc2[v_k], 85)
                endfor v_g
            endif
        endif
    endfor v_k
}

def draw_plants {
    # kelp in front, swaying in the current
    for v_k in (0, v_nkelp - 1, 1)
        v_px = v_kx[v_k] - v_cam
        if v_px > -8 and v_px < 72 then
            v_py = v_sand[v_kx[v_k]] + 3
            v_ang = -1.5708
            for v_g in (1, v_kh[v_k], 1)
                v_ang = -1.5708 + sin(v_t * 0.03 + v_kph[v_k] + v_g * 0.45) * 0.08 * v_g
                v_nx = v_px + cos(v_ang) * 3
                v_ny = v_py + sin(v_ang) * 3
                draw_line(v_px, v_py, v_nx, v_ny, forest_green, 70)
                if v_g % 2 == 0 then
                    draw_line(v_nx, v_ny, v_nx + 2, v_ny - 1, green, 55)
                else
                    draw_line(v_nx, v_ny, v_nx - 2, v_ny - 1, green, 55)
                endif
                v_px = v_nx
                v_py = v_ny
            endfor v_g
        endif
    endfor v_k
    # anemones: waving tentacles with bright tips
    for v_k in (0, v_nanem - 1, 1)
        v_px = v_ax[v_k] - v_cam
        if v_px > -6 and v_px < 70 then
            v_py = v_sand[v_ax[v_k]] + 1
            draw_ellipse(v_px, v_py, 3, 1.5, v_ac[v_k], 45, true, 0)
            for v_g in (0, 6, 1)
                v_an = -2.7 + v_g * 0.4 + sin(v_t * 0.04 + v_g * 0.9 + v_k) * 0.25
                v_tx = v_px + cos(v_an) * 4.5
                v_ty = v_py - 1 + sin(v_an) * 4.5
                draw_line(v_px + (v_g - 3) * 0.6, v_py - 1, v_tx, v_ty, v_ac[v_k], 70)
                mplot(v_tx, v_ty, white, 70)
            endfor v_g
        endif
    endfor v_k
}

# ---------------- Drawing: creatures ----------------
def draw_fish {
    # fish v_k at screen (v_fx0, v_fy0); v_sxs is facing scale (-1..1)
    v_L = v_fsl[v_k]
    v_H = v_fsh[v_k]
    v_wag = sin(v_t * 0.25 + v_fsp[v_k]) * v_H * 0.45
    v_bw = max(abs(v_sxs) * v_L, 0.6)
    # tail
    v_tbx = v_fx0 - v_sxs * v_L * 0.9
    v_ttx = v_fx0 - v_sxs * v_L * 1.6
    for v_g in (-2, 2, 1)
        draw_line(v_tbx, v_fy0, v_ttx, v_fy0 + v_g * v_H * 0.3 + v_wag * 0.5, v_fct[v_k], 75)
    endfor v_g
    # body
    draw_ellipse(v_fx0, v_fy0, v_bw, v_H, v_fcb[v_k], 85, true, 0)
    # kind details
    v_kd = v_fsk[v_k]
    if v_kd == 0 then
        draw_line(v_fx0 + v_sxs * v_L * 0.4, v_fy0 - v_H * 0.8, v_fx0 + v_sxs * v_L * 0.4, v_fy0 + v_H * 0.8, v_fcs[v_k], 70)
        draw_line(v_fx0 - v_sxs * 0.5, v_fy0 - v_H, v_fx0 - v_sxs * v_L * 0.6, v_fy0 - v_H * 1.5, v_fct[v_k], 70)
    elseif v_kd == 1 then
        draw_line(v_fx0, v_fy0 - v_H * 0.8, v_fx0, v_fy0 + v_H * 0.8, v_fcs[v_k], 80)
        draw_line(v_fx0 - v_sxs * v_L * 0.5, v_fy0 - v_H * 0.6, v_fx0 - v_sxs * v_L * 0.5, v_fy0 + v_H * 0.6, v_fcs[v_k], 80)
    elseif v_kd == 2 then
        draw_line(v_fx0 - v_sxs * v_L * 0.7, v_fy0, v_fx0 + v_sxs * v_L * 0.7, v_fy0, v_fcs[v_k], 60)
    elseif v_kd == 4 then
        draw_line(v_fx0 - v_sxs * v_L * 0.6, v_fy0 - v_H, v_fx0 + v_sxs * v_L * 0.3, v_fy0 - v_H, v_fcs[v_k], 70)
        draw_line(v_fx0 - v_sxs * v_L * 0.6, v_fy0 + v_H * 0.7, v_fx0 + v_sxs * v_L * 0.3, v_fy0 + v_H * 0.7, v_fcs[v_k], 60)
    endif
    # eye
    if abs(v_sxs) > 0.3 then
        mplot(v_fx0 + v_sxs * v_L * 0.6, v_fy0 - v_H * 0.25, white, 100)
        mplot(v_fx0 + v_sxs * v_L * 0.65, v_fy0 - v_H * 0.25, black, 100)
    endif
}

def update_and_draw_fish {
    v_off = v_cam * 0.85
    for v_k in (0, v_nfish - 1, 1)
        # swim; turn around near the ends of the reef
        if v_fst[v_k] > 0 then
            v_fst[v_k] = v_fst[v_k] + 0.05 * 1.7 / v_pace
            if v_fst[v_k] >= 1 then
                v_fst[v_k] = 0
                v_fsd[v_k] = 0 - v_fsd[v_k]
            endif
        else
            v_fsx[v_k] = v_fsx[v_k] + v_fsd[v_k] * v_fsv[v_k] * 1.7 / v_pace
            if (v_fsx[v_k] > v_world - 8 and v_fsd[v_k] > 0) or (v_fsx[v_k] < 8 and v_fsd[v_k] < 0) or random(0, 999, 0) < 2 then
                v_fst[v_k] = 0.01
            endif
        endif
        v_fsp[v_k] = v_fsp[v_k] + 0.004
        v_fy0 = v_fsy[v_k] + sin(v_t * 0.02 + v_fsp[v_k] * 5) * 3
        v_fy0 = min(max(v_fy0, 6), v_sandy - 4)
        v_fx0 = v_fsx[v_k] - v_off
        v_sxs = v_fsd[v_k]
        if v_fst[v_k] > 0 then
            v_sxs = v_fsd[v_k] * cos(v_fst[v_k] * 3.1416)
        endif
        if v_fx0 > -10 and v_fx0 < 74 then
            call draw_fish
        endif
    endfor v_k
}

def draw_school {
    # leader wanders through the open water; the school follows loosely
    v_slx = v_slx + v_sldir * 0.25 * 1.7 / v_pace
    if v_slx > v_world - 15 then
        v_sldir = -1
    endif
    if v_slx < 15 then
        v_sldir = 1
    endif
    v_sly = 26 + sin(v_t * 0.013) * 10
    v_off = v_cam * 0.9
    for v_k in (0, v_nsch - 1, 1)
        v_wob = v_t * 0.03 + v_k * 0.7
        v_gx = v_slx + v_scox[v_k] + sin(v_wob) * 2
        v_gy = v_sly + v_scoy[v_k] + cos(v_wob * 1.3) * 1.5
        v_scx[v_k] = v_scx[v_k] + (v_gx - v_scx[v_k]) * 0.06
        v_scy[v_k] = v_scy[v_k] + (v_gy - v_scy[v_k]) * 0.06
        v_xx = v_scx[v_k] - v_off
        if v_xx > -2 and v_xx < 66 then
            v_glint = 60
            if (int(v_t * 0.3) + v_k) % 7 == 0 then
                v_glint = 100
            endif
            draw_line(v_xx - v_sldir, v_scy[v_k], v_xx + v_sldir, v_scy[v_k], silver, v_glint)
            mplot(v_xx - v_sldir * 2, v_scy[v_k], gray, 50)
        endif
    endfor v_k
}

def draw_jellies {
    v_off = v_cam * 0.6
    for v_k in (0, v_njel - 1, 1)
        v_jp[v_k] = v_jp[v_k] + 0.035 * 1.7 / v_pace
        v_pulse = sin(v_jp[v_k])
        # rise on each pulse, sink slowly between
        v_jy[v_k] = v_jy[v_k] - max(v_pulse, 0) * 0.08 + 0.025
        if v_jy[v_k] > 42 then
            v_jy[v_k] = 42
        endif
        if v_jy[v_k] < 8 then
            v_jy[v_k] = 8
        endif
        v_xx = v_jx[v_k] - v_off + sin(v_t * 0.005 + v_k) * 6
        v_yy = v_jy[v_k]
        if v_xx > -6 and v_xx < 70 then
            v_bw = 3 + v_pulse * 0.6
            v_bh = 2 - v_pulse * 0.4
            for v_g in (0, 3, 1)
                v_gx = v_xx - 2 + v_g * 1.3
                v_wv = sin(v_t * 0.05 + v_g + v_k) * 1.2
                draw_line(v_gx, v_yy + 1, v_gx + v_wv, v_yy + 6 + v_g % 2, lavender, 35)
            endfor v_g
            draw_ellipse(v_xx, v_yy, v_bw, v_bh, violet, 45, true, 0)
            draw_ellipse(v_xx, v_yy - 0.5, v_bw * 0.6, v_bh * 0.5, pink, 45, true, 0)
        endif
    endfor v_k
}

def draw_turtle {
    if v_tuwait > 0 then
        v_tuwait = v_tuwait - 1.7 / v_pace
    else
        v_tux = v_tux + v_tud * 0.09 * 1.7 / v_pace
        v_tuy = 17 + sin(v_t * 0.01) * 3
        v_xx = v_tux - v_cam * 0.5
        if (v_tud > 0 and v_xx > 80) or (v_tud < 0 and v_xx < -16) then
            # go round again later, from the other side
            v_tuwait = random(300, 700, 0)
            v_tud = 0 - v_tud
            if v_tud > 0 then
                v_tux = v_cam * 0.5 - 14
            else
                v_tux = v_cam * 0.5 + 78
            endif
        endif
        v_fl = sin(v_t * 0.05) * 2.5
        # flippers
        draw_line(v_xx + v_tud * 2, v_tuy, v_xx + v_tud * 5, v_tuy - 2 - v_fl, olive, 45)
        draw_line(v_xx + v_tud * 2, v_tuy + 1, v_xx + v_tud * 5, v_tuy + 3 + v_fl, olive, 45)
        draw_line(v_xx - v_tud * 3, v_tuy + 1, v_xx - v_tud * 5, v_tuy + 3 - v_fl * 0.5, olive, 40)
        # head
        draw_circle(v_xx + v_tud * 6, v_tuy - 0.5, 1.2, olive, 50, true)
        # shell with plates
        draw_ellipse(v_xx, v_tuy, 5, 2.6, forest_green, 50, true, 0)
        draw_ellipse(v_xx, v_tuy - 0.5, 3, 1.5, olive, 45, true, 0)
        mplot(v_xx - 2, v_tuy, bronze, 50)
        mplot(v_xx + 2, v_tuy, bronze, 50)
    endif
}

def draw_particles {
    for v_k in (0, v_nbub - 1, 1)
        v_by[v_k] = v_by[v_k] - v_bs[v_k] * 1.7 / v_pace
        if v_by[v_k] < 1 then
            v_by[v_k] = 52
            v_bx[v_k] = v_ax[random(0, v_nanem - 1, 0)] + random(-2, 2, 0)
        endif
        v_xx = v_bx[v_k] - v_cam + sin(v_by[v_k] * 0.5 + v_k) * 0.8
        if v_xx >= 0 and v_xx <= 63 then
            mplot(v_xx, v_by[v_k], white, 70)
            if v_k % 3 == 0 then
                mplot(v_xx, v_by[v_k] - 1, sky_blue, 50)
            endif
        endif
    endfor v_k
    for v_k in (0, v_nspk - 1, 1)
        v_spx[v_k] = v_spx[v_k] + 0.03
        v_spy[v_k] = v_spy[v_k] + sin(v_t * 0.02 + v_k) * 0.02
        v_xx = v_spx[v_k] - v_cam * 0.95
        v_xx = v_xx - floor(v_xx / 64) * 64
        mplot(v_xx, v_spy[v_k], light_gray, 22)
    endfor v_k
}

# ---------------- Main loop ----------------
v_cam = 0
while true then
    v_t = v_t + 1.7 / v_pace
    v_cam = 38 - cos(v_t * 0.0022) * 38
    begin_frame
        call draw_water
        call draw_far_reef
        call draw_turtle
        call draw_sand
        call draw_jellies
        call draw_reef
        call update_and_draw_fish
        call draw_school
        call draw_plants
        call draw_particles
    end_frame
endwhile
