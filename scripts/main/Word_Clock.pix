# Word Clock - the time, spelled out
#
# An 11 x 10 grid of letters, like the classic word-clock design. Only the
# words that tell the time light up: "IT IS TWENTY PAST SEVEN PM". The other
# letters stay faintly visible. Every five minutes the old words fade out
# and the new ones type themselves in, letter by letter. Four corner dots
# count the minutes between the five-minute steps (one dot per minute), and
# once a minute a soft shimmer sweeps across the lit words.
#
#   on the hour:  IT IS SEVEN OCLOCK
#   5 / 10 past:  FIVE PAST / TEN PAST          (and TO for the second half)
#   15 / 45:      A QUARTER PAST / A QUARTER TO
#   20 / 25:      TWENTY PAST / TWENTY FIVE PAST
#   30:           HALF PAST
#
# The lit colour drifts slowly through the day. Letters are only redrawn
# when they change, so the clock costs almost nothing when it is still.

fps(30)
throttle(0)

# ---------------- Settings ----------------
v_unlit = 14           # brightness of the unlit letters
v_lit = 95             # brightness of the lit letters
v_fade = 0.06          # fade step per frame
v_type_gap = 2         # frames between letters when new words type in
v_time_offset = 0      # minutes added to the real time (for testing)

# ---------------- Letters (generated) ----------------
create_array(v_letters, 110, string)
v_letters[0] = "I"
v_letters[1] = "T"
v_letters[2] = "L"
v_letters[3] = "I"
v_letters[4] = "S"
v_letters[5] = "A"
v_letters[6] = "S"
v_letters[7] = "A"
v_letters[8] = "M"
v_letters[9] = "P"
v_letters[10] = "M"
v_letters[11] = "A"
v_letters[12] = "C"
v_letters[13] = "Q"
