v_letters[16] = "R"
v_letters[17] = "T"
v_letters[18] = "E"
v_letters[19] = "R"
v_letters[20] = "D"
v_letters[21] = "C"
v_letters[22] = "T"
v_letters[23] = "W"
v_letters[24] = "E"
v_letters[25] = "N"
