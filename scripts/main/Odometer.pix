# Mechanical Odometer - the time on rolling number wheels
#
# Six drums behind a brass panel show hours, minutes and seconds. Each
# drum is a real cylinder: you see the digits above and below the current
# one curving away and darkening, and when the time ticks over the drum
# rolls round to the next number. When the seconds pass 59 the tens drum
# and the minutes drums all roll together, just like the carry on a car's
# mileage counter.
#
# Every few minutes the panel switches to TRIP mode for a while: the drums
# become a mileage counter that races up from 999,990, rolls through the
# big 999999 -> 000000 rollover where every wheel turns at once, keeps
# counting fast, and then rolls back to the time.
#
# Drums and panel are drawn once on layer 0; only the digits on layer 1
# are redrawn each frame.

fps(40)
throttle(0)

# ---------------- Settings ----------------
v_24h = 1              # 1 = 24-hour clock, 0 = 12-hour
v_trip_every = 150     # seconds between trip-meter shows (0 = never)
v_trip_secs = 22       # how long the trip meter runs

