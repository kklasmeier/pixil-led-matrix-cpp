# ---------------- Drums ----------------
v_nw = 6
create_array(v_wx, v_nw, numeric)     # left edge of each drum
create_array(v_pos, v_nw, numeric)    # displayed position (digits, can be fractional)
create_array(v_ndig, v_nw, numeric)   # digits printed on the drum
create_array(v_from, v_nw, numeric)
create_array(v_to, v_nw, numeric)
create_array(v_an, v_nw, numeric)     # roll animation frame (-1 = still)
create_array(v_red, v_nw, numeric)    # red digits (seconds drums)
v_wx[0] = 3
v_wx[1] = 12
v_wx[2] = 24
v_wx[3] = 33
v_wx[4] = 45
v_wx[5] = 54
v_red[4] = 1
v_red[5] = 1
v_cy = 29
v_R = 11
v_roll_frames = 12

# ---------------- Panel and drums (layer 0, once) ----------------
def draw_panel {
    draw_rectangle(0, 0, 64, 64, bronze, 30, true)
    draw_rectangle(1, 1, 62, 62, bronze, 40, false)
    # screws
    for v_k in (0, 3, 1)
        v_sx = 4 + (v_k % 2) * 55
        v_sy = 4 + floor(v_k / 2) * 55
        draw_circle(v_sx, v_sy, 1.2, gold, 50, true)
        mplot(v_sx, v_sy, bronze, 30)
    endfor v_k
    # window: dark recess around all the drums
    draw_rectangle(1, v_cy - 10, 62, 21, black, 100, true)
    draw_line(1, v_cy - 11, 62, v_cy - 11, dark_brown, 60)
    draw_line(1, v_cy + 11, 62, v_cy + 11, gold, 30)
    # each drum: a shaded cylinder
    for v_w in (0, v_nw - 1, 1)
        for v_y in (v_cy - 9, v_cy + 9, 1)
            v_s = (v_y - v_cy) / v_R
            v_c = sqrt(max(0, 1 - v_s * v_s))
            draw_line(v_wx[v_w], v_y, v_wx[v_w] + 6, v_y, gray, 3 + 13 * v_c * v_c)
        endfor v_y
    endfor v_w
}

def draw_labels {
    draw_rectangle(2, 45, 60, 7, bronze, 30, true)
    draw_rectangle(2, 8, 60, 7, bronze, 30, true)
    # colons between the pairs (the trip meter has none)
    if v_mode == 0 then
        v_cc = "gold"
    else
        v_cc = "black"
    endif
    draw_rectangle(21, v_cy - 3, 2, 2, v_cc, 55, true)
    draw_rectangle(21, v_cy + 2, 2, 2, v_cc, 55, true)
    draw_rectangle(42, v_cy - 3, 2, 2, v_cc, 55, true)
    draw_rectangle(42, v_cy + 2, 2, 2, v_cc, 55, true)
    if v_mode == 0 then
        draw_text(11, 46, "HRS", tiny64_font, 8, gold, 45, NORMAL)
        draw_text(26, 46, "MIN", tiny64_font, 8, gold, 45, NORMAL)
        draw_text(47, 46, "SEC", tiny64_font, 8, gold, 45, NORMAL)
        draw_text(32, 9, "TIME", tiny64_font, 8, gold, 70, NORMAL, CENTER)
    else
        draw_text(32, 46, "MILES", tiny64_font, 8, gold, 45, NORMAL, CENTER)
        draw_text(32, 9, "TRIP", tiny64_font, 8, gold, 80, NORMAL, CENTER)
    endif
}

# ---------------- Digits on the drums (layer 1, every frame) ----------------
def draw_drums {
    for v_w in (0, v_nw - 1, 1)
        v_p = v_pos[v_w]
        v_n = v_ndig[v_w]
        v_base = floor(v_p)
        v_x0 = v_wx[v_w] + 1
        for v_o in (-1, 2, 1)
            v_dig = (v_base + v_o) % v_n
            if v_dig < 0 then
                v_dig = v_dig + v_n
            endif
            # angle of this digit's centre from straight ahead (36 degrees a digit)
            v_pc = (v_base + v_o - v_p) * 0.6283
            if abs(v_pc) < 1.75 then
                for v_k in (0, v_gn[v_dig] - 1, 1)
                    v_gy = v_gpy[v_dig * 40 + v_k]
                    v_ph = v_pc + (v_gy - 3) * 0.074
                    if abs(v_ph) < 1.15 then
                        # brightness falls off steeply as the digit curves away
                        v_c = pow(max(0, (cos(v_ph) - 0.6) / 0.4), 3)
                        v_yy = v_cy + v_R * sin(v_ph)
                        if v_red[v_w] == 1 and v_mode == 0 then
                            mplot(v_x0 + v_gpx[v_dig * 40 + v_k], v_yy, red, 3 + 97 * v_c)
                        else
                            mplot(v_x0 + v_gpx[v_dig * 40 + v_k], v_yy, white, 3 + 97 * v_c)
                        endif
                    endif
                endfor v_k
            endif
        endfor v_o
    endfor v_w
}

# ---------------- Clock targets ----------------
create_array(v_want, v_nw, numeric)
def read_clock {
    if v_24h == 1 then
        v_hr = get_datetime("H")
    else
        v_hr = get_datetime("h")
    endif
    v_mn = get_datetime("mi")
    v_sc = get_datetime("s")
    v_want[0] = floor(v_hr / 10)
    v_want[1] = v_hr % 10
    v_want[2] = floor(v_mn / 10)
    v_want[3] = v_mn % 10
    v_want[4] = floor(v_sc / 10)
    v_want[5] = v_sc % 10
}

# start rolling drum v_w forward to v_want[v_w]
def roll_to {
    v_n = v_ndig[v_w]
    v_cur = v_pos[v_w] % v_n
    v_steps = (v_want[v_w] - round(v_cur) + v_n) % v_n
    if v_steps > 0 then
        v_from[v_w] = v_pos[v_w]
        v_to[v_w] = v_pos[v_w] + v_steps
        v_an[v_w] = 0
    endif
}

def animate {
    for v_w in (0, v_nw - 1, 1)
        if v_an[v_w] >= 0 then
            v_an[v_w] = v_an[v_w] + 1
            v_len = v_roll_frames * min(3, 0.6 + 0.4 * (v_to[v_w] - v_from[v_w]))
            v_u = min(1, v_an[v_w] / v_len)
            # ease out with a tiny settle past the stop
            v_e = 1 - pow(1 - v_u, 3) + 0.06 * sin(v_u * 3.14159)
            v_pos[v_w] = v_from[v_w] + (v_to[v_w] - v_from[v_w]) * v_e
            if v_u >= 1 then
                v_pos[v_w] = v_to[v_w] % v_ndig[v_w]
                v_an[v_w] = -1
            endif
        endif
    endfor v_w
}

def set_clock_drums {
    v_ndig[0] = 3
    v_ndig[1] = 10
    v_ndig[2] = 6
    v_ndig[3] = 10
    v_ndig[4] = 6
    v_ndig[5] = 10
}

# ---------------- Start ----------------
v_mode = 0
call set_clock_drums
call read_clock
for v_w in (0, v_nw - 1, 1)
    v_pos[v_w] = v_want[v_w]
    v_an[v_w] = -1
endfor v_w
begin_frame
    call draw_panel
    call draw_labels
end_frame
v_frame = 0
v_next_trip = v_trip_every * 40

# ---------------- Main loop ----------------
while true then
    v_frame = v_frame + 1
    if v_mode == 0 then
        call read_clock
        for v_w in (0, v_nw - 1, 1)
            if v_an[v_w] < 0 and round(v_pos[v_w]) % v_ndig[v_w] != v_want[v_w] then
                call roll_to
            endif
        endfor v_w
        call animate
        if v_trip_every > 0 and v_frame >= v_next_trip then
            # ---- switch to the trip meter: every drum becomes 0-9 ----
            v_mode = 1
            for v_w in (0, v_nw - 1, 1)
                v_ndig[v_w] = 10
                v_pos[v_w] = round(v_pos[v_w]) % 10
            endfor v_w
            v_trip_v = 999990 - random(0, 30, 0)
            v_trip_t = 0
            # roll from the clock to the trip reading
            for v_w in (0, v_nw - 1, 1)
                v_want[v_w] = floor(v_trip_v / pow(10, 5 - v_w)) % 10
                call roll_to
            endfor v_w
            v_settle = 50
            begin_frame(true)
                call draw_labels
            end_frame
        endif
    else
        if v_settle > 0 then
            v_settle = v_settle - 1
            call animate
        else
            # odometer gearing: each wheel turns only while every wheel to
            # its right is rolling from 9 to 0
            v_trip_t = v_trip_t + 1
            v_rate = 0.06 + 0.5 * min(1, v_trip_t / 200) * (0.5 + 0.5 * sin(v_trip_t * 0.01))
            v_trip_v = v_trip_v + v_rate
            if v_trip_v >= 1000000 then
                v_trip_v = v_trip_v - 1000000
            endif
            for v_w in (0, v_nw - 1, 1)
                v_pw = pow(10, 5 - v_w)
                v_whole = floor(v_trip_v / v_pw) % 10
                v_below = v_trip_v - floor(v_trip_v / v_pw) * v_pw
                v_carry = max(0, v_below - (v_pw - 1))
                v_pos[v_w] = v_whole + v_carry
            endfor v_w
            if v_trip_t > v_trip_secs * 40 then
                # ---- back to the clock ----
                v_mode = 0
                for v_w in (0, v_nw - 1, 1)
                    v_pos[v_w] = round(v_pos[v_w]) % 10
                endfor v_w
                call set_clock_drums
                call read_clock
                for v_w in (0, v_nw - 1, 1)
                    v_pos[v_w] = v_pos[v_w] % v_ndig[v_w]
                    call roll_to
                endfor v_w
                v_next_trip = v_frame + v_trip_every * 40
                begin_frame(true)
                    call draw_labels
                end_frame
            endif
        endif
    endif

    begin_frame(true)
        set_layer(1)
        clear_layer(1)
        call draw_drums
        set_layer(0)
    end_frame
endwhile
