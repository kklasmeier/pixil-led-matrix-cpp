# Domino Spiral - domino chain reactions seen from above
#
# Dozens of dominoes are laid out on the floor in a pattern, then knocked
# over: the wave runs along the chain, each domino tipping into the next and
# speeding up as it goes. Seen from above, a standing domino is just a thin
# edge; as it falls it opens up into its full face, so the wave paints the
# pattern in colour. Then the chain rewinds and stands back up, gets new
# colours, and is set off a different way.
#
# Layouts (a new one every two runs, never the same twice in a row):
#   spiral, serpentine rows, sine snake, heart, flower, S double spiral,
#   zigzag
# Ways to set it off (runs alternate: one wave, then two waves, then one...):
#   one wave:  from one end, or from the other end
#   two waves: from the middle outward both ways, or from both ends at once
#              so the waves meet in the middle
#
# How it works: one domino sprite with 32 cels (8 colours x 4 pip faces),
# one instance per domino. Each instance is turned (set_sprite_angle) to face
# along the path and tipped with set_sprite_tilt: about 90 degrees =
# edge-on (standing), 0 = lying flat. The engine draws an edge-on sprite as a
# thin sliver of its colour, which is what a standing domino looks like from
# above. Tilt pivots on the sprite centre, so each domino is moved every frame
# to keep its foot on the floor. Layouts are curves sampled at equal spacing
# along their length; the floor has a little perspective.

fps(60)
throttle(0)

# ---------------- Settings ----------------
v_max_dom = 80         # most dominoes in one layout
v_spacing = 4.6        # gap between dominoes along the path
v_gravity = 0.55       # how quickly a domino tips over
v_rest_angle = 80      # how far a domino ends up tipped (90 = flat)
v_runs_per_layout = 2  # runs before the layout changes

define_sprite(domino, 5, 9)
    sprite_cel(0)
        draw_rectangle(0, 0, 5, 9, red, 70, true)
