# ---------------- Board ----------------
v_n = 256
create_array(v_cur, v_n, numeric)   # face showing: 0 black, 1 yellow
create_array(v_tgt, v_n, numeric)   # face wanted
create_array(v_fp, v_n, numeric)    # flip progress in frames (-1 = still)
create_array(v_fd, v_n, numeric)    # frames to wait before flipping
create_array(v_drop, 16, numeric)

# draw disc v_i: face v_face, width v_wd (0 full, 1 narrow, 2 edge-on)
def draw_disc {
    v_x0 = (v_i % 16) * 4
    v_y0 = floor(v_i / 16) * 4
    for v_yy in (0, 2, 1)
        for v_xx in (0, 2, 1)
            mplot(v_x0 + v_xx, v_y0 + v_yy, black, 100)
        endfor v_xx
    endfor v_yy
    if v_wd == 2 then
        mplot(v_x0 + 1, v_y0, gray, 25)
        mplot(v_x0 + 1, v_y0 + 1, gray, 35)
        mplot(v_x0 + 1, v_y0 + 2, gray, 25)
    else
        if v_face == 1 then
            v_dc = "yellow"
            v_bc = 100
            v_be = 80
            v_bk = 55
        else
            v_dc = "dark_gray"
            v_bc = 16
            v_be = 12
            v_bk = 5
        endif
        mplot(v_x0 + 1, v_y0 + 1, v_dc, v_bc)
        mplot(v_x0 + 1, v_y0, v_dc, v_be)
        mplot(v_x0 + 1, v_y0 + 2, v_dc, v_be)
        if v_wd == 0 then
            mplot(v_x0, v_y0 + 1, v_dc, v_be)
            mplot(v_x0 + 2, v_y0 + 1, v_dc, v_be)
            mplot(v_x0, v_y0, v_dc, v_bk)
            mplot(v_x0 + 2, v_y0, v_dc, v_bk)
            mplot(v_x0, v_y0 + 2, v_dc, v_bk)
            mplot(v_x0 + 2, v_y0 + 2, v_dc, v_bk)
        else
            mplot(v_x0, v_y0 + 1, v_dc, v_bk)
            mplot(v_x0 + 2, v_y0 + 1, v_dc, v_bk)
        endif
    endif
}

# ask disc v_i to show face v_val after v_dl frames
def set_disc {
    if v_tgt[v_i] != v_val then
        v_tgt[v_i] = v_val
        v_fd[v_i] = v_dl
    endif
}

# advance all flips by one frame (call inside a frame)
def update_board {
    for v_i in (0, v_n - 1, 1)
        if v_fp[v_i] >= 0 then
            v_fp[v_i] = v_fp[v_i] + 1
            v_q = v_fp[v_i] / v_flip_frames
            if v_q >= 1 then
                v_cur[v_i] = 1 - v_cur[v_i]
                v_fp[v_i] = -1
                v_face = v_cur[v_i]
                v_wd = 0
            elseif v_q < 0.34 then
                v_face = v_cur[v_i]
                v_wd = 1
            elseif v_q < 0.67 then
                v_wd = 2
            else
                v_face = 1 - v_cur[v_i]
                v_wd = 1
            endif
            call draw_disc
        elseif v_tgt[v_i] != v_cur[v_i] then
            if v_fd[v_i] > 0 then
                v_fd[v_i] = v_fd[v_i] - 1
            else
                v_fp[v_i] = 0
            endif
        endif
    endfor v_i
}

# run v_wait frames of flipping
def run_frames {
    for v_f in (1, v_wait, 1)
        v_fr = v_fr + 1
        begin_frame(true)
            call update_board
        end_frame
    endfor v_f
}

# set every disc to v_val with a column-by-column ripple (direction v_rdir)
def fill_board {
    for v_i in (0, v_n - 1, 1)
        if v_rdir == 1 then
            v_dl = (v_i % 16) * 2
        elseif v_rdir == -1 then
            v_dl = (15 - v_i % 16) * 2
        elseif v_rdir == 2 then
            v_dl = (v_i % 16 + floor(v_i / 16)) * 1.5
        else
            v_dl = 0
        endif
        call set_disc
    endfor v_i
}

# ---------------- Text ----------------
create_array(v_buf, 520, numeric)   # column masks for the text being shown
v_blen = 0
# each font column is used twice, so letters are twice as wide on the board
def add_char {
    v_w = v_gw[v_code]
    for v_c in (0, v_w - 1, 1)
        v_buf[v_blen] = v_gcol[v_code * 5 + v_c]
        v_buf[v_blen + 1] = v_gcol[v_code * 5 + v_c]
        v_blen = v_blen + 2
    endfor v_c
    v_buf[v_blen] = 0
    v_blen = v_blen + 1
}

# draw the glyph for digit v_dg with its top-left at disc (v_gc, v_gr)
def put_digit {
    v_code = v_code_0 + v_dg
    for v_c in (0, 2, 1)
        v_m = v_gcol[v_code * 5 + v_c]
        for v_r in (0, 4, 1)
            v_i = (v_gr + v_r) * 16 + v_gc + v_c
            v_val = floor(v_m / pow(2, v_r)) % 2
            call set_disc
        endfor v_r
    endfor v_c
}

# ---------------- Clock ----------------
def show_clock {
    if v_24h == 1 then
        v_hr = get_datetime("H")
    else
        v_hr = get_datetime("h")
    endif
    v_mn = get_datetime("mi")
    v_sc = get_datetime("s")
    # clear rows we don't use
    v_val = 0
    for v_i in (0, v_n - 1, 1)
        v_row = floor(v_i / 16)
        v_col = v_i % 16
        v_use = 0
        if v_row >= 1 and v_row <= 5 and v_col >= 4 and v_col <= 10 then
            v_use = 1
        endif
        if v_row >= 8 and v_row <= 12 and v_col >= 4 and v_col <= 10 then
            v_use = 1
        endif
        if v_row == 14 then
            v_use = 1
        endif
        if v_use == 0 then
            call set_disc
        endif
    endfor v_i
    # hours (one centred digit when it's a single figure in 12-hour mode)
    v_gr = 1
    if v_hr < 10 and v_24h == 0 then
        for v_r in (1, 5, 1)
            for v_c in (4, 10, 1)
                v_i = v_r * 16 + v_c
                v_val = 0
                call set_disc
            endfor v_c
        endfor v_r
        v_dg = v_hr
        v_gc = 6
        call put_digit
    else
        for v_r in (1, 5, 1)
            v_i = v_r * 16 + 7
            v_val = 0
            call set_disc
        endfor v_r
        v_dg = floor(v_hr / 10)
        v_gc = 4
        call put_digit
        v_dg = v_hr % 10
        v_gc = 8
        call put_digit
    endif
    v_gr = 8
    for v_r in (8, 12, 1)
        v_i = v_r * 16 + 7
        v_val = 0
        call set_disc
    endfor v_r
    v_dg = floor(v_mn / 10)
    v_gc = 4
    call put_digit
    v_dg = v_mn % 10
    v_gc = 8
    call put_digit
    # seconds bar
    v_lit = floor(v_sc * 16 / 60)
    for v_c in (0, 15, 1)
        v_i = 14 * 16 + v_c
        v_val = 0
        if v_c <= v_lit then
            v_val = 1
        endif
        call set_disc
    endfor v_c
}

def clock_mode {
    v_dl = 0
    v_end = v_fr + v_clock_secs * 30
    while v_fr < v_end then
        v_dl = 0
        call show_clock
        # the first update ripples in column by column
        if v_fr < v_clock_start + 2 then
            for v_i in (0, v_n - 1, 1)
                if v_tgt[v_i] != v_cur[v_i] then
                    v_fd[v_i] = (v_i % 16) * 2
                endif
            endfor v_i
        endif
        v_wait = 6
        call run_frames
    endwhile
}

# ---------------- Scrolling message ----------------
def scroll_mode {
    v_blen = 0
    for v_k in (1, 16, 1)
        v_buf[v_blen] = 0
        v_blen = v_blen + 1
    endfor v_k
    if random(0, 1, 2) < 0.3 then
        # the time, spelled out
        if v_24h == 1 then
            v_hr = get_datetime("H")
        else
            v_hr = get_datetime("h")
        endif
        v_mn = get_datetime("mi")
        if v_hr >= 10 then
            v_code = v_code_0 + floor(v_hr / 10)
            call add_char
        endif
        v_code = v_code_0 + v_hr % 10
        call add_char
        v_code = v_code_colon
        call add_char
        v_code = v_code_0 + floor(v_mn / 10)
        call add_char
        v_code = v_code_0 + v_mn % 10
        call add_char
        if v_24h == 0 then
            v_code = v_code_space
            call add_char
            if get_datetime("H") < 12 then
                v_code = v_code_A
            else
                v_code = v_code_P
            endif
            call add_char
            v_code = v_code_M
            call add_char
        endif
    else
        v_m = random(0, v_nmsg - 1, 0)
        if v_m == v_last_msg then
            v_m = (v_m + 1) % v_nmsg
        endif
        v_last_msg = v_m
        for v_k in (0, v_mlen[v_m] - 1, 1)
            v_code = v_mcode[v_mstart[v_m] + v_k]
            call add_char
        endfor v_k
    endif
    for v_k in (1, 16, 1)
        v_buf[v_blen] = 0
        v_blen = v_blen + 1
    endfor v_k
    # clear the board first, sweeping right to left
    v_val = 0
    v_rdir = -1
    call fill_board
    v_wait = 40
    call run_frames
    # a thin rail above and below the text, like a sign's frame
    v_dl = 0
    for v_c in (0, 15, 1)
        v_i = 3 * 16 + v_c
        v_val = 1
        v_dl = v_c
        call set_disc
        v_i = 11 * 16 + v_c
        call set_disc
    endfor v_c
    v_wait = 20
    call run_frames
    v_dl = 0
    for v_s in (0, v_blen - 16, 1)
        for v_c in (0, 15, 1)
            v_m = v_buf[v_s + v_c]
            for v_r in (0, 4, 1)
                v_i = (5 + v_r) * 16 + v_c
                v_val = floor(v_m / pow(2, v_r)) % 2
                call set_disc
            endfor v_r
        endfor v_c
        v_wait = v_scroll_step
        call run_frames
    endfor v_s
    v_wait = 10
    call run_frames
}

# ---------------- Patterns ----------------
def pattern_mode {
    v_pat = random(0, 7, 0)
    if v_pat == v_last_pat then
        v_pat = (v_pat + 3) % 8
    endif
    v_last_pat = v_pat
    if v_pat == 0 then
        # wipes: fill left to right, clear right to left, twice
        for v_k in (1, 2, 1)
            v_val = 1
            v_rdir = 1
            call fill_board
            v_wait = 55
            call run_frames
            v_val = 0
            v_rdir = -1
            call fill_board
            v_wait = 55
            call run_frames
        endfor v_k
    elseif v_pat == 1 then
        # diagonal sweeps
        for v_k in (1, 3, 1)
            v_val = 1
            v_rdir = 2
            call fill_board
            v_wait = 60
            call run_frames
            v_val = 0
            call fill_board
            v_wait = 60
            call run_frames
        endfor v_k
    elseif v_pat == 2 then
        # ripples from the centre
        for v_t in (0, 90, 1)
            v_rad = (v_t % 30) * 0.45
            v_dl = 0
            for v_i in (0, v_n - 1, 1)
                v_dx = v_i % 16 - 7.5
                v_dy = floor(v_i / 16) - 7.5
                v_d = sqrt(v_dx * v_dx + v_dy * v_dy)
                v_val = 0
                if abs(v_d - v_rad) < 0.8 or abs(v_d - v_rad + 6.5) < 0.8 then
                    v_val = 1
                endif
                call set_disc
            endfor v_i
            v_wait = 3
            call run_frames
        endfor v_t
    elseif v_pat == 3 then
        # checkerboard that keeps inverting
        for v_k in (0, 5, 1)
            for v_i in (0, v_n - 1, 1)
                v_val = (v_i % 16 + floor(v_i / 16) + v_k) % 2
                v_dl = floor(v_i / 16) * 2
                call set_disc
            endfor v_i
            v_wait = 45
            call run_frames
        endfor v_k
    elseif v_pat == 4 then
        # sparkle
        for v_t in (0, 240, 1)
            for v_k in (1, 4, 1)
                v_i = random(0, v_n - 1, 0)
                v_val = 1 - v_tgt[v_i]
                v_dl = 0
                call set_disc
            endfor v_k
            v_wait = 1
            call run_frames
        endfor v_t
    elseif v_pat == 5 then
        # rolling waves
        for v_t in (0, 110, 1)
            v_dl = 0
            for v_i in (0, v_n - 1, 1)
                v_c = v_i % 16
                v_r = floor(v_i / 16)
                v_h = 8 + 4 * sin(v_c * 0.45 + v_t * 0.25) + 1.5 * sin(v_c * 1.1 - v_t * 0.17)
                v_val = 0
                if v_r > v_h then
                    v_val = 1
                endif
                call set_disc
            endfor v_i
            v_wait = 2
            call run_frames
        endfor v_t
    elseif v_pat == 6 then
        # rain: drops fall down the columns
        for v_c in (0, 15, 1)
            v_drop[v_c] = -random(0, 20, 0)
        endfor v_c
        for v_t in (0, 120, 1)
            v_dl = 0
            for v_c in (0, 15, 1)
                v_drop[v_c] = v_drop[v_c] + 0.5
                if v_drop[v_c] > 19 then
                    v_drop[v_c] = -random(0, 10, 0)
                endif
                for v_r in (0, 15, 1)
                    v_i = v_r * 16 + v_c
                    v_val = 0
                    if v_r <= v_drop[v_c] and v_r > v_drop[v_c] - 3 then
                        v_val = 1
                    endif
                    call set_disc
                endfor v_r
            endfor v_c
            v_wait = 2
            call run_frames
        endfor v_t
    else
        # spiral fill, then spiral clear
        for v_k in (1, 0, -1)
            v_x = 0
            v_y = 0
            v_dxs = 1
            v_dys = 0
            v_lo = 0
            v_hi = 15
            v_top = 0
            v_bot = 15
            for v_step in (0, v_n - 1, 1)
                v_i = v_y * 16 + v_x
                v_val = v_k
                v_dl = v_step * 0.5
                call set_disc
                # walk the spiral
                if v_dxs == 1 and v_x == v_hi then
                    v_dxs = 0
                    v_dys = 1
                    v_top = v_top + 1
                elseif v_dys == 1 and v_y == v_bot then
                    v_dxs = -1
                    v_dys = 0
                    v_hi = v_hi - 1
                elseif v_dxs == -1 and v_x == v_lo then
                    v_dxs = 0
                    v_dys = -1
                    v_bot = v_bot - 1
                elseif v_dys == -1 and v_y == v_top then
                    v_dxs = 1
                    v_dys = 0
                    v_lo = v_lo + 1
                endif
                v_x = v_x + v_dxs
                v_y = v_y + v_dys
            endfor v_step
            v_wait = 150
            call run_frames
        endfor v_k
    endif
    # sweep clear
    v_val = 0
    v_rdir = 1
    call fill_board
    v_wait = 40
    call run_frames
}

# ---------------- Start ----------------
v_fr = 0
v_last_msg = -1
v_last_pat = -1
for v_i in (0, v_n - 1, 1)
    v_cur[v_i] = 0
    v_tgt[v_i] = 0
    v_fp[v_i] = -1
    v_fd[v_i] = 0
endfor v_i
begin_frame
    v_face = 0
    v_wd = 0
    for v_i in (0, v_n - 1, 1)
        call draw_disc
    endfor v_i
end_frame

# ---------------- Main loop ----------------
while true then
    v_clock_start = v_fr
    call clock_mode
    if random(0, 1, 2) < 0.5 then
        call scroll_mode
    else
        call pattern_mode
    endif
endwhile
