# Flip-Disc Display - the clattering bus-sign board, disc by disc
#
# A 16 x 16 board of round discs, yellow on one side and black on the
# other, like the destination signs on old buses and trains. Every change
# flips discs over one by one: you see each disc turn edge-on and come
# round showing its other face, usually rippling across the board column
# by column the way real flip-dot signs update.
#
# The board cycles through:
#   - A clock: hours over minutes, with a seconds bar along the bottom that
#     clicks over one disc at a time
#   - Scrolling bus-sign messages ("ROUTE 64 DOWNTOWN", "NOT IN SERVICE"...)
#     and the current time
#   - Patterns: wipes, diagonal sweeps, ripples, a checkerboard that
#     inverts, sparkle, rolling waves, rain and a spiral fill
#
# Only discs that are changing get redrawn, so the board costs very little
# per frame.

fps(30)
throttle(0)

# ---------------- Settings ----------------
v_24h = 0              # 1 = 24-hour clock
v_clock_secs = 25      # how long the clock shows between other items
v_flip_frames = 4      # frames for one disc to turn over
v_scroll_step = 3      # frames per column when scrolling text

