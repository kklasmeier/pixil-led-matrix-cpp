# Doom Tour - a 2.5D Doom-style engine, written entirely in Pixil
#
# A guided walk through a hand-built level: a flickering tech corridor, a
# great pillared hall with a staircase up to a balcony, stairs down to an
# open courtyard under a dusk sky, a bridge over a glowing acid pit, a
# cramped metal duct, a red brick chamber with torches, and back.
#
# How it renders (per screen column, every frame):
#   - Every map cell has its own floor height, ceiling height, light level,
#     wall material and floor colour; some are open to the sky.
#   - A ray steps through the grid (DDA). In each cell it passes it draws that
#     cell's floor and ceiling (or sky), then any step up, step down or lower
#     ceiling at the next cell's edge, and shrinks the column's open window.
#     It stops at a solid wall or when the window closes - the same idea as
#     Doom's renderer, on a grid.
#   - Walls are textured by material (tech panels, brown stone, grey blocks,
#     red brick, wooden risers, metal), lit per area and faded by distance.
#   - Barrels and torches are sprites, hidden behind nearer walls.
#   - The camera glides along a smooth spline path, rising and falling with
#     the floor as it climbs stairs.

fps(60)
throttle(0)

# ---------------- Settings ----------------
v_pace = 1.7             # bigger = slower, smoother tour (1.7 suits fps 60)
v_walk = 0.05 / v_pace   # cells per frame
v_eye = 0.55             # eye height above the floor
v_maxd = 17              # draw distance (cells); beyond this is darkness
v_plane = 0.75           # half field of view (camera plane length)
v_sc = 32 / v_plane      # projection scale: pixels per unit at distance 1

# ---------------- Map ----------------
v_w = 44
v_h = 31
v_n = v_w * v_h
create_array(v_fh, v_n, numeric)     # floor height
create_array(v_ch, v_n, numeric)     # ceiling height (<= floor means solid)
create_array(v_lt, v_n, numeric)     # light level 0-1
create_array(v_mat, v_n, numeric)    # wall material
create_array(v_fc, v_n, numeric)     # floor colour (palette index)
create_array(v_cc, v_n, numeric)     # ceiling colour (palette index)
create_array(v_sky, v_n, numeric)    # 1 = open to the sky
create_array(v_flk, v_n, numeric)    # 1 = flickering light

create_array(v_pal, 8, string)
v_pal[0] = "dark_gray"
v_pal[1] = "gray"
v_pal[2] = "dark_brown"
v_pal[3] = "maroon"
v_pal[4] = "lime"
v_pal[5] = "olive"
v_pal[6] = "standard_brown"
v_pal[7] = "silver"

# Materials: main colour, joint colour, course height, block width, stagger
create_array(v_mc1, 7, string)
create_array(v_mc2, 7, string)
create_array(v_mco, 7, numeric)
create_array(v_mw, 7, numeric)
create_array(v_mst, 7, numeric)
v_mc1[1] = "silver"
v_mc2[1] = "dark_gray"
v_mco[1] = 0.5
v_mw[1] = 0.5
v_mst[1] = 0
v_mc1[2] = "standard_brown"
v_mc2[2] = "dark_brown"
v_mco[2] = 0.33
v_mw[2] = 0.5
v_mst[2] = 0.5
v_mc1[3] = "gray"
v_mc2[3] = "dark_gray"
v_mco[3] = 0.5
v_mw[3] = 1.0
v_mst[3] = 0.5
v_mc1[4] = "crimson"
v_mc2[4] = "maroon"
v_mco[4] = 0.25
v_mw[4] = 0.5
v_mst[4] = 0.5
v_mc1[5] = "bronze"
v_mc2[5] = "dark_brown"
v_mco[5] = 1.0
v_mw[5] = 1.0
v_mst[5] = 0
v_mc1[6] = "dark_gray"
v_mc2[6] = "black"
v_mco[6] = 0.3
v_mw[6] = 0.25
v_mst[6] = 0

# Fill a rectangle of cells (v_ax0..v_ax1, v_ay0..v_ay1) with the current
# room settings v_af (floor), v_ac (ceiling), v_al (light), v_am (material),
# v_afc (floor colour), v_acc (ceiling colour), v_as (sky), v_afl (flicker)
def fill_room {
    for v_yy in (v_ay0, v_ay1, 1)
        for v_xx in (v_ax0, v_ax1, 1)
            v_i = v_yy * v_w + v_xx
            v_fh[v_i] = v_af
            v_ch[v_i] = v_ac
            v_lt[v_i] = v_al
            v_mat[v_i] = v_am
            v_fc[v_i] = v_afc
            v_cc[v_i] = v_acc
            v_sky[v_i] = v_as
            v_flk[v_i] = v_afl
        endfor v_xx
    endfor v_yy
    # the solid walls around the room take the room's material
    for v_yy in (max(v_ay0 - 1, 0), min(v_ay1 + 1, v_h - 1), 1)
        for v_xx in (max(v_ax0 - 1, 0), min(v_ax1 + 1, v_w - 1), 1)
            v_i = v_yy * v_w + v_xx
            if v_ch[v_i] <= v_fh[v_i] and v_paint == 1 then
                v_mat[v_i] = v_am
            endif
        endfor v_xx
    endfor v_yy
}

# Make cells solid with material v_am
def fill_solid {
    for v_yy in (v_ay0, v_ay1, 1)
        for v_xx in (v_ax0, v_ax1, 1)
            v_i = v_yy * v_w + v_xx
            v_fh[v_i] = 0
            v_ch[v_i] = 0
            v_mat[v_i] = v_am
        endfor v_xx
    endfor v_yy
}

def set_area {
    # shorthand: v_ax0 v_ay0 v_ax1 v_ay1 are set by the caller
    call fill_room
}

