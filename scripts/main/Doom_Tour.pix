def look_at {
    # input v_li (waypoint), v_qx/v_qy (target), v_qw (strength)
    v_wlx[v_li] = v_qx
    v_wly[v_li] = v_qy
    v_wlw[v_li] = v_qw
}
# glance at the pillars and stage when entering the hall
