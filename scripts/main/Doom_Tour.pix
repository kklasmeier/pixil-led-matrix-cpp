# Catmull-Rom spline through the waypoints: segment v_sg, position v_st (0-1)
def path_point {
    v_i1 = v_sg % v_np
    v_i0 = (v_i1 - 1 + v_np) % v_np
    v_i2 = (v_i1 + 1) % v_np
    v_i3 = (v_i1 + 2) % v_np
    v_t2 = v_st * v_st
    v_t3 = v_t2 * v_st
    v_qx = 0.5 * (2 * v_wpx[v_i1] + (v_wpx[v_i2] - v_wpx[v_i0]) * v_st + (2 * v_wpx[v_i0] - 5 * v_wpx[v_i1] + 4 * v_wpx[v_i2] - v_wpx[v_i3]) * v_t2 + (3 * v_wpx[v_i1] - v_wpx[v_i0] - 3 * v_wpx[v_i2] + v_wpx[v_i3]) * v_t3)
    v_qy = 0.5 * (2 * v_wpy[v_i1] + (v_wpy[v_i2] - v_wpy[v_i0]) * v_st + (2 * v_wpy[v_i0] - 5 * v_wpy[v_i1] + 4 * v_wpy[v_i2] - v_wpy[v_i3]) * v_t2 + (3 * v_wpy[v_i1] - v_wpy[v_i0] - 3 * v_wpy[v_i2] + v_wpy[v_i3]) * v_t3)
}

def seg_len {
    # input v_sg -> v_sl
    v_i1 = v_sg % v_np
    v_i2 = (v_i1 + 1) % v_np
    v_sl = sqrt((v_wpx[v_i2] - v_wpx[v_i1]) * (v_wpx[v_i2] - v_wpx[v_i1]) + (v_wpy[v_i2] - v_wpy[v_i1]) * (v_wpy[v_i2] - v_wpy[v_i1])) + 0.01
}

# ---------------- Camera ----------------
v_seg = 0
v_pt = 0
v_t = 0
v_ang = 0
v_ez = v_eye
v_pitch = 0
v_camx = 7.0
v_camy = 27.6

def move_camera {
    v_sg = v_seg
    call seg_len
    v_pt = v_pt + v_walk / v_sl
    if v_pt >= 1 then
        v_pt = v_pt - 1
        v_seg = (v_seg + 1) % v_np
    endif
    v_sg = v_seg
    v_st = v_pt
    call path_point
    v_camx = v_qx
    v_camy = v_qy
    # look ahead along the path to choose where to face
    v_sg = v_seg
    call seg_len
    v_st = v_pt + 0.9 / v_sl
    if v_st >= 1 then
        v_l0 = v_sl
        v_sg = v_seg + 1
        call seg_len
        v_st = (v_st - 1) * v_l0 / v_sl
        v_st = min(v_st, 0.99)
    endif
    call path_point
    v_hx = v_qx - v_camx
    v_hy = v_qy - v_camy
    v_hl = sqrt(v_hx * v_hx + v_hy * v_hy) + 0.0001
    v_hx = v_hx / v_hl
    v_hy = v_hy / v_hl
    # blend in the look-at target for this stretch of the path
    v_i1 = v_seg % v_np
    v_i2 = (v_i1 + 1) % v_np
    v_lw1 = v_wlw[v_i1] * (1 - v_pt)
    v_lw2 = v_wlw[v_i2] * v_pt
    v_lw = v_lw1 + v_lw2
    if v_lw > 0.001 then
        v_lx = (v_wlx[v_i1] * v_lw1 + v_wlx[v_i2] * v_lw2) / v_lw - v_camx
        v_ly = (v_wly[v_i1] * v_lw1 + v_wly[v_i2] * v_lw2) / v_lw - v_camy
        v_ll = sqrt(v_lx * v_lx + v_ly * v_ly) + 0.0001
        v_hx = v_hx * (1 - v_lw) + v_lx / v_ll * v_lw
        v_hy = v_hy * (1 - v_lw) + v_ly / v_ll * v_lw
    endif
    v_want = atan2(v_hy, v_hx)
    v_tilt = v_wlp[v_i1] * (1 - v_pt) + v_wlp[v_i2] * v_pt
    v_pitch = v_pitch + (v_tilt - v_pitch) * 0.04
    v_da = v_want - v_ang
    v_da = v_da - 6.283185 * floor((v_da + 3.141593) / 6.283185)
    v_ang = v_ang + v_da * 0.06
    # eye follows the floor smoothly (stairs become a glide)
    v_cell = int(v_camy) * v_w + int(v_camx)
    v_ez = v_ez + (v_fh[v_cell] + v_eye - v_ez) * 0.12
}

# ---------------- Rendering ----------------
create_array(v_zbuf, 64, numeric)

# Draw a textured wall face in column v_x between world heights v_h0..v_h1
# at distance v_d, texture position v_fu, material v_fm, intensity v_fi,
# clipped to the open window v_wt..v_wb
def draw_face {
    v_co = v_mco[v_fm]
    v_k0 = floor(v_h0 / v_co)
    v_k1 = ceil(v_h1 / v_co) - 1
    for v_fk in (v_k0, v_k1, 1)
        v_hl = max(v_fk * v_co, v_h0)
        v_hh = min((v_fk + 1) * v_co, v_h1)
        v_ya = v_hz - (v_hh - v_ez) * v_sc / v_d
        v_yb = v_hz - (v_hl - v_ez) * v_sc / v_d
        v_r0 = max(ceil(v_ya), v_wt)
        v_r1 = min(ceil(v_yb) - 1, v_wb)
        if v_r0 <= v_r1 then
            v_bu = v_fu / v_mw[v_fm] + v_mst[v_fm] * (v_fk % 2)
            v_tone = 0.84 + ((floor(v_bu) * 3 + v_fk * 5) % 3) * 0.07
            if v_bu - floor(v_bu) < 0.07 then
                draw_line(v_x, v_r0, v_x, v_r1, v_mc2[v_fm], v_fi * 0.55)
            else
                draw_line(v_x, v_r0, v_x, v_r1, v_mc1[v_fm], v_fi * v_tone)
                if v_r0 == ceil(v_ya) and v_r1 > v_r0 then
                    mplot(v_x, v_r0, v_mc2[v_fm], v_fi * 0.55)
                endif
            endif
        endif
    endfor v_fk
}

def render {
    v_dirx = cos(v_ang)
    v_diry = sin(v_ang)
    v_plx = 0 - v_diry * v_plane
    v_ply = v_dirx * v_plane
    # horizon row: looking down moves it up the screen
    v_hz = 32 - v_pitch + sin(v_t * 0.16) * 0.5
    # flickering lights and the pulsing acid glow
    v_flick = 1
    if sin(v_t * 0.31) + sin(v_t * 0.73) + sin(v_t * 1.9) > 0.9 then
        v_flick = 0.3
    endif
    v_acid = 0.8 + sin(v_t * 0.05) * 0.2
    for v_x in (0, 63, 1)
        v_cx = (v_x + 0.5) / 32 - 1
        v_rdx = v_dirx + v_plx * v_cx
        v_rdy = v_diry + v_ply * v_cx
        v_mx = int(v_camx)
        v_my = int(v_camy)
        v_ddx = 999999
        if v_rdx != 0 then
            v_ddx = abs(1 / v_rdx)
        endif
        v_ddy = 999999
        if v_rdy != 0 then
            v_ddy = abs(1 / v_rdy)
        endif
        if v_rdx < 0 then
            v_stx = -1
            v_sdx = (v_camx - v_mx) * v_ddx
        else
            v_stx = 1
            v_sdx = (v_mx + 1 - v_camx) * v_ddx
        endif
        if v_rdy < 0 then
            v_sty = -1
            v_sdy = (v_camy - v_my) * v_ddy
        else
            v_sty = 1
            v_sdy = (v_my + 1 - v_camy) * v_ddy
        endif
        v_wt = 0
        v_wb = 63
        v_dprev = 0.02
        v_pc = v_my * v_w + v_mx
        v_done = 0
        v_zcl = v_maxd
        while v_done == 0 then
            if v_sdx < v_sdy then
                v_d = v_sdx
                v_sdx = v_sdx + v_ddx
                v_mx = v_mx + v_stx
                v_side = 0
            else
                v_d = v_sdy
                v_sdy = v_sdy + v_ddy
                v_my = v_my + v_sty
                v_side = 1
            endif
            if v_d >= v_maxd then
                v_d = v_maxd
                v_done = 1
            endif
            v_pf = v_fh[v_pc]
            v_pcl = v_ch[v_pc]
            v_light = v_lt[v_pc]
            if v_flk[v_pc] == 1 then
                v_light = v_light * v_flick
            endif
            v_fog = 1 - (v_dprev + v_d) * 0.5 / v_maxd
            v_fog = 1 - (1 - v_fog) * (1 - v_fog) * 0.3 - (1 - v_fog) * 0.7
            # floor of the cell we are crossing
            if v_pf < v_ez then
                v_ya = v_hz + (v_ez - v_pf) * v_sc / v_d
                v_r0 = max(ceil(v_ya), v_wt)
                v_r1 = min(ceil(v_hz + (v_ez - v_pf) * v_sc / v_dprev) - 1, v_wb)
                if v_r0 <= v_r1 then
                    v_fcol = v_fc[v_pc]
                    v_fi = v_light * v_fog * (88 - ((v_mx + v_my) % 2) * 14)
                    if v_fcol == 4 then
                        v_fi = 100 * v_acid * max(v_fog, 0.5)
                    endif
                    draw_line(v_x, v_r0, v_x, v_r1, v_pal[v_fcol], v_fi)
                endif
                v_wb = min(v_wb, ceil(v_ya) - 1)
            endif
            # ceiling (or sky) of the cell we are crossing
            if v_pcl > v_ez then
                v_yb = v_hz - (v_pcl - v_ez) * v_sc / v_d
                v_r0 = max(ceil(v_hz - (v_pcl - v_ez) * v_sc / v_dprev), v_wt)
                v_r1 = min(ceil(v_yb) - 1, v_wb)
                if v_r0 <= v_r1 then
                    if v_sky[v_pc] == 1 then
                        v_my2 = (v_r0 + v_r1) * 0.5 - v_hz + 32
                        if v_my2 < 9 then
                            draw_line(v_x, v_r0, v_x, v_r1, navy, 30)
                        elseif v_my2 < 16 then
                            draw_line(v_x, v_r0, v_x, v_r1, indigo, 40)
                        elseif v_my2 < 22 then
                            draw_line(v_x, v_r0, v_x, v_r1, purple, 50)
                        elseif v_my2 < 26 then
                            draw_line(v_x, v_r0, v_x, v_r1, rose, 55)
                        elseif v_my2 < 29 then
                            draw_line(v_x, v_r0, v_x, v_r1, orange, 68)
                        else
                            draw_line(v_x, v_r0, v_x, v_r1, peach, 78)
                        endif
                    else
                        draw_line(v_x, v_r0, v_x, v_r1, v_pal[v_cc[v_pc]], v_light * v_fog * 60)
                    endif
                endif
                v_wt = max(v_wt, ceil(v_yb))
            endif
            if v_done == 0 then
                v_nc = v_my * v_w + v_mx
                v_nf = v_fh[v_nc]
                v_ncl = v_ch[v_nc]
                if v_side == 0 then
                    v_fu = v_camy + v_d * v_rdy
                else
                    v_fu = v_camx + v_d * v_rdx
                endif
                v_fu = v_fu - floor(v_fu)
                v_fm = v_mat[v_nc]
                v_fd = v_d / v_maxd
                v_fi = min(v_light * 1.15, 1) * (1 - v_fd * 0.75 - v_fd * v_fd * 0.25) * (100 - v_side * 22)
                if v_ncl <= v_nf then
                    # solid wall: fills the rest of the window
                    v_h0 = v_pf
                    v_h1 = v_pcl
                    call draw_face
                    v_done = 1
                    v_zcl = v_d
                else
                    if v_nf > v_pf then
                        # step up
                        v_h0 = v_pf
                        v_h1 = v_nf
                        call draw_face
                        v_wb = min(v_wb, ceil(v_hz - (v_nf - v_ez) * v_sc / v_d) - 1)
                    endif
                    if v_ncl < v_pcl then
                        # lower ceiling ahead (or the edge of the sky)
                        v_h0 = v_ncl
                        v_h1 = v_pcl
                        call draw_face
                        v_wt = max(v_wt, ceil(v_hz - (v_ncl - v_ez) * v_sc / v_d))
                    endif
                    if v_wt > v_wb then
                        v_done = 1
                        v_zcl = v_d
                    endif
                endif
            endif
            v_pc = v_my * v_w + v_mx
            v_dprev = v_d
        endwhile
        v_zbuf[v_x] = v_zcl
    endfor v_x
}

def draw_sprites {
    v_inv = 1 / (v_plx * v_diry - v_dirx * v_ply)
    for v_k in (0, v_nspr - 1, 1)
        v_rx = v_spx[v_k] - v_camx
        v_ry = v_spy[v_k] - v_camy
        v_tx = v_inv * (v_diry * v_rx - v_dirx * v_ry)
        v_ty = v_inv * (0 - v_ply * v_rx + v_plx * v_ry)
        if v_ty > 0.25 and v_ty < v_maxd then
            v_sx = 32 * (1 + v_tx / v_ty)
            v_col = int(v_sx)
            if v_col >= 0 and v_col <= 63 then
                if v_ty < v_zbuf[v_col] then
                    v_scell = int(v_spy[v_k]) * v_w + int(v_spx[v_k])
                    v_s = v_sc / v_ty
                    v_base = v_hz - (v_fh[v_scell] - v_ez) * v_s
                    v_si = max(1 - v_ty / v_maxd, 0) * v_lt[v_scell] * 100
                    if v_spt[v_k] == 1 then
                        # barrel
                        v_bw = max(v_s * 0.36, 1)
                        v_bh = max(v_s * 0.5, 1)
                        draw_rectangle(v_sx - v_bw / 2, v_base - v_bh, v_bw, v_bh, olive, v_si * 0.9, true)
                        draw_rectangle(v_sx - v_bw / 2, v_base - v_bh * 0.72, v_bw, max(v_bh * 0.1, 1), dark_gray, v_si, true)
                        draw_rectangle(v_sx - v_bw / 2, v_base - v_bh * 0.32, v_bw, max(v_bh * 0.1, 1), dark_gray, v_si, true)
                        draw_rectangle(v_sx - v_bw / 2, v_base - v_bh, v_bw, max(v_bh * 0.08, 1), lime, v_si, true)
                    else
                        # torch: pole and a flickering flame
                        v_top = v_base - v_s * 0.75
                        draw_line(v_sx, v_base, v_sx, v_top, dark_gray, v_si)
                        v_fl = 0.8 + sin(v_t * 0.9 + v_k * 3) * 0.2
                        v_fr = max(v_s * 0.07, 1)
                        draw_circle(v_sx, v_top - v_fr, v_fr * 1.6, orange, 55 * v_fl, true)
                        draw_circle(v_sx, v_top - v_fr, v_fr, yellow, 100 * v_fl, true)
                    endif
                endif
            endif
        endif
    endfor v_k
}

# ---------------- Main loop ----------------
while true then
    v_t = v_t + 1 / v_pace
    call move_camera
    begin_frame
        call render
        call draw_sprites
    end_frame
endwhile
