# Famous Chess Games - classic games replayed move by move
#
# Sixteen of the most famous games ever played, replayed on a full-screen board:
#   Legall's Mate (Paris 1750)             Anderssen's Immortal Game (1851)
#   Anderssen's Evergreen Game (1852)      Morphy's Opera Game (Paris 1858)
#   Rotlewi vs Rubinstein (1907)           Reti vs Tartakower miniature (1910)
#   Ed. Lasker vs Thomas king hunt (1912)  Levitsky vs Marshall "gold coins" (1912)
#   Adams vs Torre queen dance (1920)      Glucksberg vs Najdorf "Polish Immortal" (1929)
#   Canal's "Peruvian Immortal" (1934)     Byrne vs Fischer "Game of the Century" (1956)
#   Fischer vs Spassky, game 6 (1972)      Short's king walk vs Timman (1991)
#   Deep Blue vs Kasparov, game 6 (1997)   Kasparov vs Topalov "Kasparov's Immortal" (1999)
#
# Each game opens with a title card. Pieces lift as they glide to their new
# square, the last move stays highlighted, a king in check glows red, and
# captured pieces are flicked off the board spinning. The move is spelled
# out underneath in standard notation. Checkmate gets a burst of sparks and
# the mated king topples over; a resignation tips the king too.
#
# Games play in random order; every game plays before any repeats. Every move
# was checked for legality when the script was generated.

fps(30)
throttle(0)

# ---------------- Settings ----------------
v_move_frames = 14     # frames for a piece to glide to its square
v_pause = 26           # frames to wait between moves (more after checks/captures)
v_title_secs = 4       # how long the title card shows
v_end_frames = 160     # how long the final position stays up

