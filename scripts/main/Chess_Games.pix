# ---------------- Board state ----------------
v_x0 = 4
v_y0 = 0
create_array(v_sq, 64, numeric)       # piece id on each square, -1 = empty
create_array(v_ptype, 32, numeric)    # 0 P 1 N 2 B 3 R 4 Q 5 K
create_array(v_pcol, 32, numeric)     # 0 white 1 black
create_array(v_pon, 32, numeric)
create_array(v_back, 8, numeric)
v_back[0] = 3
v_back[1] = 1
v_back[2] = 2
v_back[3] = 4
v_back[4] = 5
v_back[5] = 2
v_back[6] = 1
v_back[7] = 3

# sparks for the checkmate flourish
v_ns = 70
create_array(v_spx, v_ns, numeric)
create_array(v_spy, v_ns, numeric)
create_array(v_svx, v_ns, numeric)
create_array(v_svy, v_ns, numeric)
create_array(v_sc, v_ns, numeric)

# square v_s -> top-left screen corner v_qx, v_qy
def sq_xy {
    v_qx = v_x0 + (v_s % 8) * 7
    v_qy = v_y0 + (7 - floor(v_s / 8)) * 7
}

# draw square v_s with highlight v_hl (0 none, 1 last move, 2 check)
def draw_sq {
    call sq_xy
    v_light = ((v_s % 8) + floor(v_s / 8)) % 2
    if v_hl == 2 then
        if v_light == 1 then
            v_rc = "crimson"
            v_ri = 75
        else
            v_rc = "red"
            v_ri = 55
        endif
    elseif v_hl == 1 then
        if v_light == 1 then
            v_rc = "gold"
            v_ri = 55
        else
            v_rc = "bronze"
            v_ri = 55
        endif
    else
        if v_light == 1 then
            v_rc = "tan"
            v_ri = 60
        else
            v_rc = "wood_brown"
            v_ri = 45
        endif
    endif
    draw_rectangle(v_qx, v_qy, 7, 7, v_rc, v_ri, true)
}

def draw_board {
    v_hl = 0
    for v_s in (0, 63, 1)
        call draw_sq
    endfor v_s
    draw_text(0, 50, "1", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 43, "2", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 36, "3", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 29, "4", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 22, "5", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 15, "6", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 8, "7", tiny64_font, 8, dark_gray, 70, NORMAL)
    draw_text(0, 1, "8", tiny64_font, 8, dark_gray, 70, NORMAL)
}

# bottom strip text v_txt in colour v_tc
def strip_text {
    draw_rectangle(0, 57, 64, 7, black, 100, true)
    draw_text(32, 58, v_txt, tiny64_font, 8, v_tc, 100, NORMAL, CENTER)
}

def setup_pieces {
    for v_s in (0, 63, 1)
        v_sq[v_s] = -1
    endfor v_s
    for v_i in (0, 7, 1)
        v_ptype[v_i] = v_back[v_i]
        v_ptype[v_i + 8] = 0
        v_ptype[v_i + 16] = v_back[v_i]
        v_ptype[v_i + 24] = 0
        v_sq[v_i] = v_i
        v_sq[v_i + 8] = v_i + 8
        v_sq[v_i + 56] = v_i + 16
        v_sq[v_i + 48] = v_i + 24
    endfor v_i
    for v_i in (0, 31, 1)
        v_pcol[v_i] = 0
        if v_i >= 16 then
            v_pcol[v_i] = 1
        endif
    endfor v_i
}

# ---- captured-piece flyer (one at a time) ----
v_fl_id = -1
def start_flyer {
    if v_fl_id >= 0 then
        hide_sprite(pc, v_fl_id)
    endif
    v_fl_id = v_cid
    v_s = v_capsq
    call sq_xy
    v_flx = v_qx
    v_fly = v_qy
    if v_pcol[v_cid] == 0 then
        v_flvx = -random(1.2, 2.0, 2)
    else
        v_flvx = random(1.2, 2.0, 2)
    endif
    v_flvy = -random(1.8, 2.6, 2)
    v_flk = 0
    set_sprite_z(pc, 8, v_fl_id)
}
def update_flyer {
    if v_fl_id >= 0 then
        v_flk = v_flk + 1
        v_flx = v_flx + v_flvx
        v_fly = v_fly + v_flvy
        v_flvy = v_flvy + 0.16
        move_sprite(pc, v_flx, v_fly, v_fl_id, v_ptype[v_fl_id] * 2 + v_pcol[v_fl_id])
        set_sprite_transform(pc, max(0.3, 1.25 - v_flk * 0.02), v_flk * 24 * v_flvx, v_fl_id)
        if v_flk > 45 or v_fly > 70 or v_flx < -10 or v_flx > 72 then
            hide_sprite(pc, v_fl_id)
            reset_sprite_transform(pc, v_fl_id)
            v_fl_id = -1
        endif
    endif
}

# ---- order of games: play all, then reshuffle ----
create_array(v_order, v_games, numeric)
v_last_game = -1
def shuffle_games {
    for v_i in (0, v_games - 1, 1)
        v_order[v_i] = v_i
    endfor v_i
    for v_i in (v_games - 1, 1, -1)
        v_j = random(0, v_i, 0)
        v_t = v_order[v_i]
        v_order[v_i] = v_order[v_j]
        v_order[v_j] = v_t
    endfor v_i
    if v_order[0] == v_last_game then
        v_t = v_order[0]
        v_order[0] = v_order[v_games - 1]
        v_order[v_games - 1] = v_t
    endif
}

# ---------------- One game ----------------
def play_game {
    # ---- title card ----
    for v_i in (0, 31, 1)
        hide_sprite(pc, v_i)
    endfor v_i
    begin_frame
        draw_text(32, 3, v_g_t1[v_g], tiny64_font, 8, gold, 100, NORMAL, CENTER)
        draw_text(32, 10, v_g_t2[v_g], tiny64_font, 8, gold, 100, NORMAL, CENTER)
        draw_line(12, 18, 51, 18, bronze, 50)
        draw_text(32, 23, v_g_white[v_g], tiny64_font, 8, white, 100, NORMAL, CENTER)
        draw_text(32, 31, "vs", tiny64_font, 8, gray, 70, NORMAL, CENTER)
        draw_text(32, 39, v_g_black[v_g], tiny64_font, 8, silver, 90, NORMAL, CENTER)
        draw_line(12, 48, 51, 48, bronze, 50)
        draw_text(32, 53, v_g_place[v_g], tiny64_font, 8, tan, 80, NORMAL, CENTER)
    end_frame
    rest(v_title_secs)

    # ---- set up: board, then pieces drop in rank by rank ----
    call setup_pieces
    begin_frame
        call draw_board
        v_txt = v_g_white[v_g]
        v_tc = "white"
        call strip_text
    end_frame
    for v_i in (0, 31, 1)
        v_pon[v_i] = 0
    endfor v_i
    for v_k in (0, 39, 1)
        begin_frame(true)
            for v_i in (0, 31, 1)
                v_d = (v_i % 16) * 1.5
                if v_i >= 16 then
                    v_d = ((31 - v_i) % 16) * 1.5 + 4
                endif
                v_u = (v_k - v_d) / 8
                if v_u >= 0 and v_u <= 1.2 then
                    if v_pon[v_i] == 0 then
                        v_pon[v_i] = 1
                        v_s = v_i
                        if v_i >= 24 then
                            v_s = 24 + v_i
                        elseif v_i >= 16 then
                            v_s = 40 + v_i
                        endif
                        call sq_xy
                        set_sprite_scale(pc, 2.6, v_i)
                        show_sprite(pc, v_qx, v_qy, v_i, 1, v_ptype[v_i] * 2 + v_pcol[v_i])
                    endif
                    set_sprite_scale(pc, max(1, 2.6 - 1.6 * min(1, v_u)), v_i)
                endif
            endfor v_i
        end_frame
    endfor v_k
    rest(0.6)

    v_pf = -1
    v_pt = -1
    v_pk = -1
    v_first = v_g_start[v_g]
    v_lastm = v_first + v_g_len[v_g] - 1
    for v_m in (v_first, v_lastm, 1)
        v_f = v_m_from[v_m]
        v_t = v_m_to[v_m]
        v_id = v_sq[v_f]
        v_capsq = v_m_cap[v_m]
        v_cid = -1
        if v_capsq >= 0 then
            v_cid = v_sq[v_capsq]
        endif
        v_rid = -1
        if v_m_rf[v_m] >= 0 then
            v_rid = v_sq[v_m_rf[v_m]]
            v_s = v_m_rf[v_m]
            call sq_xy
            v_rfx = v_qx
            v_rfy = v_qy
            v_s = v_m_rt[v_m]
            call sq_xy
            v_rtx = v_qx
            v_rty = v_qy
        endif
        v_s = v_f
        call sq_xy
        v_fx = v_qx
        v_fy = v_qy
        v_s = v_t
        call sq_xy
        v_tx = v_qx
        v_ty = v_qy
        v_cel = v_ptype[v_id] * 2 + v_pcol[v_id]
        set_sprite_z(pc, 6, v_id)
        v_frames = v_move_frames
        if v_ptype[v_id] == 1 then
            v_frames = v_move_frames + 3
        endif

        for v_k in (1, v_frames, 1)
            v_u = v_k / v_frames
            v_e = v_u * v_u * (3 - 2 * v_u)
            v_lift = sin(v_u * 3.14159)
            begin_frame(true)
                if v_k == 1 then
                    # clear the old highlights, mark the new move
                    v_hl = 0
                    if v_pf >= 0 then
                        v_s = v_pf
                        call draw_sq
                        v_s = v_pt
                        call draw_sq
                    endif
                    if v_pk >= 0 then
                        v_s = v_pk
                        call draw_sq
                    endif
                    v_hl = 1
                    v_s = v_f
                    call draw_sq
                    v_s = v_t
                    call draw_sq
                endif
                move_sprite(pc, v_fx + (v_tx - v_fx) * v_e, v_fy + (v_ty - v_fy) * v_e - v_lift * 2, v_id, v_cel)
                set_sprite_scale(pc, 1 + 0.45 * v_lift, v_id)
                if v_rid >= 0 then
                    move_sprite(pc, v_rfx + (v_rtx - v_rfx) * v_e, v_rfy + (v_rty - v_rfy) * v_e - v_lift * 2, v_rid, v_ptype[v_rid] * 2 + v_pcol[v_rid])
                    set_sprite_scale(pc, 1 + 0.45 * v_lift, v_rid)
                endif
                if v_k == v_frames and v_cid >= 0 then
                    call start_flyer
                endif
                call update_flyer
            end_frame
        endfor v_k

        # ---- update the board ----
        v_sq[v_f] = -1
        if v_capsq >= 0 then
            v_sq[v_capsq] = -1
        endif
        v_sq[v_t] = v_id
        if v_rid >= 0 then
            v_sq[v_m_rf[v_m]] = -1
            v_sq[v_m_rt[v_m]] = v_rid
        endif
        if v_m_promo[v_m] >= 0 then
            v_ptype[v_id] = v_m_promo[v_m]
        endif
        v_cel = v_ptype[v_id] * 2 + v_pcol[v_id]
        v_pf = v_f
        v_pt = v_t
        v_pk = -1
        v_wait = v_pause
        if v_cid >= 0 then
            v_wait = v_wait + 8
        endif
        begin_frame(true)
            move_sprite(pc, v_tx, v_ty, v_id, v_cel)
            set_sprite_scale(pc, 1, v_id)
            set_sprite_z(pc, 1, v_id)
            if v_rid >= 0 then
                set_sprite_scale(pc, 1, v_rid)
            endif
            if v_m_chk[v_m] == 1 then
                v_pk = v_m_ksq[v_m]
                v_s = v_pk
                v_hl = 2
                call draw_sq
                v_wait = v_wait + 12
            endif
            v_txt = v_m_san[v_m]
            if (v_m - v_first) % 2 == 0 then
                v_tc = "white"
            else
                v_tc = "silver"
            endif
            call strip_text
            call update_flyer
        end_frame
        if v_m < v_lastm then
            for v_k in (1, v_wait, 1)
                begin_frame(true)
                    call update_flyer
                end_frame
            endfor v_k
        endif
    endfor v_m

    # ---- finale: checkmate sparks + toppling king, or a resignation ----
    v_white_won = 1
    if (v_lastm - v_first) % 2 == 1 then
        v_white_won = 0
    endif
    v_mate = v_m_mate[v_lastm]
    if v_mate == 1 then
        v_kid = v_sq[v_m_ksq[v_lastm]]
    else
        # resignation: the side that did not move last resigns
        v_kid = 20
        if v_white_won == 0 then
            v_kid = 4
        endif
    endif
    for v_s2 in (0, 63, 1)
        if v_sq[v_s2] == v_kid then
            v_ks = v_s2
        endif
    endfor v_s2
    v_s = v_ks
    call sq_xy
    v_kx = v_qx
    v_ky = v_qy
    v_s = v_m_to[v_lastm]
    call sq_xy
    v_bx = v_qx + 3
    v_by = v_qy + 3
    if v_mate == 1 then
        for v_i in (0, v_ns - 1, 1)
            v_a = random(0, 6.283, 3)
            v_sp = random(0.4, 1.8, 2)
            v_spx[v_i] = v_bx
            v_spy[v_i] = v_by
            v_svx[v_i] = cos(v_a) * v_sp
            v_svy[v_i] = sin(v_a) * v_sp - 0.6
            v_sc[v_i] = random(10, 16, 0)
        endfor v_i
    endif
    v_tip = 1
    if v_pcol[v_kid] == 1 then
        v_tip = -1
    endif
    for v_k in (1, v_end_frames, 1)
        begin_frame(true)
            call update_flyer
            if v_k == 1 then
                if v_mate == 1 then
                    if v_white_won == 1 then
                        v_txt = "CHECKMATE 1-0"
                    else
                        v_txt = "CHECKMATE 0-1"
                    endif
                    v_tc = "gold"
                else
                    if v_white_won == 1 then
                        v_txt = "BLACK RESIGNS"
                    else
                        v_txt = "WHITE RESIGNS"
                    endif
                    v_tc = "gold"
                endif
                call strip_text
            endif
            # king's square pulses red
            if v_k % 12 == 1 and v_k < 100 then
                v_s = v_ks
                v_hl = 2
                if v_k % 24 == 13 then
                    v_hl = 0
                endif
                call draw_sq
            endif
            # the king wobbles, then topples
            if v_k > 20 and v_k <= 70 then
                v_w = (v_k - 20) / 50
                v_ang = sin(v_k * 0.9) * 14 * (1 - v_w)
                if v_k > 50 then
                    v_ang = v_tip * 90 * min(1, (v_k - 50) / 14) * (1 - 0.15 * sin(min(1, (v_k - 50) / 14) * 3.14159))
                endif
                set_sprite_angle(pc, v_ang, v_kid)
            endif
            # sparks
            if v_mate == 1 and v_k <= 70 then
                set_layer(5)
                clear_layer(5)
                for v_i in (0, v_ns - 1, 1)
                    v_spx[v_i] = v_spx[v_i] + v_svx[v_i]
                    v_spy[v_i] = v_spy[v_i] + v_svy[v_i]
                    v_svy[v_i] = v_svy[v_i] + 0.05
                    v_svx[v_i] = v_svx[v_i] * 0.97
                    v_br = 100 - v_k * 1.4
                    if v_br > 5 and v_spy[v_i] < 56 then
                        mplot(v_spx[v_i], v_spy[v_i], v_sc[v_i], v_br)
                    endif
                endfor v_i
                if v_k == 70 then
                    clear_layer(5)
                endif
                set_layer(0)
            endif
        end_frame
    endfor v_k
    if v_fl_id >= 0 then
        hide_sprite(pc, v_fl_id)
        v_fl_id = -1
    endif
    for v_i in (0, 31, 1)
        reset_sprite_transform(pc, v_i)
        hide_sprite(pc, v_i)
    endfor v_i
}

# ---------------- Main loop ----------------
while true then
    call shuffle_games
    for v_gi in (0, v_games - 1, 1)
        v_g = v_order[v_gi]
        call play_game
        v_last_game = v_g
    endfor v_gi
endwhile
