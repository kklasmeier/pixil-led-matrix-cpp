# 3D Dot Matrix - Endless parallax scroll, four directions only (no diagonals)
# Grid shifted down 3 pixels: the lattice is centered on (32, 35) instead of (32, 32).
# v_mode = 0 : scroll forever in v_dir
# v_mode = 1 : hold a direction for a while, ease to a stop, then ease up in a new
#              random direction (left / right / up / down)
fps(30)

# ---- Settings ----
v_mode = 1            # 0 = fixed direction, 1 = random direction changes
v_dir = 0             # 0 = left, 1 = right, 2 = up, 3 = down
v_speed = 0.8         # pixels per frame for the closest layer
v_hold_min = 150      # min frames to hold a direction (30 fps -> 5 s)
v_hold_max = 400      # max frames to hold a direction
v_ease_step = 0.03    # how quickly speed ramps down/up between directions

# Internal state
v_ease = 1
v_timer = random(v_hold_min, v_hold_max, 0)
v_dx = -1
v_dy = 0

# Per-layer positions (float accumulators, wrapped to the tile spacing)
v_p5x = 0
v_p5y = 0
v_p4x = 0
v_p4y = 0
v_p3x = 0
v_p3y = 0
v_p2x = 0
v_p2y = 0
v_p1x = 0
v_p1y = 0

# One-dot tiles. x position = 32 mod spacing (unchanged).
# y position = 35 mod spacing, which moves the whole grid down 3 pixels.

# Layer 5 - Furthest (5 px spacing)
define_sprite(dots5, 5, 5)
    plot(2, 0, white, 10)
endsprite

# Layer 4 (7 px spacing)
define_sprite(dots4, 7, 7)
    plot(4, 0, white, 25)
endsprite

# Layer 3 (10 px spacing)
define_sprite(dots3, 10, 10)
    plot(2, 5, white, 45)
endsprite

# Layer 2 (14 px spacing)
define_sprite(dots2, 14, 14)
    plot(4, 7, white, 70)
endsprite

# Layer 1 - Closest (20 px spacing)
define_sprite(dots1, 20, 20)
    plot(12, 15, white, 90)
endsprite

# Higher layer numbers render on top, so furthest = layer 0
set_background(dots5, 0)
set_background(dots4, 1)
set_background(dots3, 2)
set_background(dots2, 3)
set_background(dots1, 4)

# Animation loop
while 1 then
    # Direction vector from v_dir (always exactly one axis)
    if v_dir == 0 then
        v_dx = -1
        v_dy = 0
    elseif v_dir == 1 then
        v_dx = 1
        v_dy = 0
    elseif v_dir == 2 then
        v_dx = 0
        v_dy = -1
    else
        v_dx = 0
        v_dy = 1
    endif

    # Random mode: hold, ease to a stop, pick a new direction, ease back up
    if v_mode == 1 then
        if v_timer > 0 then
            v_timer = v_timer - 1
            v_ease = min(1, v_ease + v_ease_step)
        else
            v_ease = v_ease - v_ease_step
            if v_ease <= 0 then
                v_ease = 0
                v_new = random(0, 3, 0)
                while v_new == v_dir then
                    v_new = random(0, 3, 0)
                endwhile
                v_dir = v_new
                v_timer = random(v_hold_min, v_hold_max, 0)
            endif
        endif
    endif

    v_vx = v_dx * v_speed * v_ease
    v_vy = v_dy * v_speed * v_ease

    # Farther layers move slower (parallax). Wrap into [0, spacing).
    v_p5x = v_p5x + v_vx * 0.1
    v_p5y = v_p5y + v_vy * 0.1
    v_p5x = v_p5x - 5 * floor(v_p5x / 5)
    v_p5y = v_p5y - 5 * floor(v_p5y / 5)

    v_p4x = v_p4x + v_vx * 0.25
    v_p4y = v_p4y + v_vy * 0.25
    v_p4x = v_p4x - 7 * floor(v_p4x / 7)
    v_p4y = v_p4y - 7 * floor(v_p4y / 7)

    v_p3x = v_p3x + v_vx * 0.45
    v_p3y = v_p3y + v_vy * 0.45
    v_p3x = v_p3x - 10 * floor(v_p3x / 10)
    v_p3y = v_p3y - 10 * floor(v_p3y / 10)

    v_p2x = v_p2x + v_vx * 0.7
    v_p2y = v_p2y + v_vy * 0.7
    v_p2x = v_p2x - 14 * floor(v_p2x / 14)
    v_p2y = v_p2y - 14 * floor(v_p2y / 14)

    v_p1x = v_p1x + v_vx
    v_p1y = v_p1y + v_vy
    v_p1x = v_p1x - 20 * floor(v_p1x / 20)
    v_p1y = v_p1y - 20 * floor(v_p1y / 20)

    begin_frame(true)
        set_background_offset(round(v_p5x), round(v_p5y), 0)
        set_background_offset(round(v_p4x), round(v_p4y), 1)
        set_background_offset(round(v_p3x), round(v_p3y), 2)
        set_background_offset(round(v_p2x), round(v_p2y), 3)
        set_background_offset(round(v_p1x), round(v_p1y), 4)
    end_frame
endwhile
