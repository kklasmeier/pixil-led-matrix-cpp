# Sprite instances. Everything lives on layer 10; z orders fruit < pac < ghosts < eyes.
set_layer(10)
show_sprite(fruit, -20, -20, 0, 1, 0)
hide_sprite(fruit, 0)
show_sprite(pac, -20, -20, 0, 2, 0)
hide_sprite(pac, 0)
show_sprite(pacdie, -20, -20, 0, 2, 0)
hide_sprite(pacdie, 0)
show_sprite(blinkyx, -20, -20, 0, 3, 0)
hide_sprite(blinkyx, 0)
show_sprite(rag, -20, -20, 0, 3, 0)
hide_sprite(rag, 0)
show_sprite(nail, -20, -20, 0, 1, 0)
hide_sprite(nail, 0)
for v_i in (0, 3, 1)
    show_sprite(ghost, -20, -20, v_i, 3, 0)
    hide_sprite(ghost, v_i)
    show_sprite(geyes, -20, -20, v_i, 4, 0)
    hide_sprite(geyes, v_i)
endfor v_i
for v_i in (1, 5, 1)
    show_sprite(pac, -20, -20, v_i, 2, 0)
    hide_sprite(pac, v_i)
endfor v_i

