# ===========================================================================
# PAC-MAN attract demo for the 64x64 matrix (self-playing)
#   ./run interactive -- main/Pacman_Demo.pix
#
# World: the arcade maze, 28x31 tiles at 4px = 112x124 pixels, drawn once into
# a background sprite (thin outlined walls like the arcade). The camera scrolls
# it. Pellets are redrawn from v_map each frame, so eaten dots disappear.
#
# Positions: an actor is centred on tile (c, r) when x = 4c and y = 4r.
# Corridors are 8px between wall lines, so the 8x8 ghosts and 7x7 Pac-Man fit.
#
# Ghosts use the arcade rules: scatter/chase schedule, Blinky/Pinky/Inky/Clyde
# targeting, no reversing except on mode change, red zones, tunnel slowdown,
# frightened random turns, eyes returning to the house, dot-counter release.
# Pac-Man plans with two breadth-first searches each tile: one from the
# dangerous ghosts, one from himself that only walks tiles he reaches first.
# He goes for frightened ghosts, then fruit, then the nearest safe dot, keeps
# power pellets as bait, and runs for the safest tile when boxed in.
# ===========================================================================

fps(30)

create_array(v_dx4, 4)
create_array(v_dy4, 4)
v_dx4[0] = 1
v_dy4[0] = 0
v_dx4[1] = 0
v_dy4[1] = 1
v_dx4[2] = -1
v_dy4[2] = 0
v_dx4[3] = 0
v_dy4[3] = -1

# ---------------------------------------------------------------------------
# Maze. One digit per tile, 14 tiles per number:
#   0 empty  1 wall  2 dot  3 power pellet  4 house door  6 house  8 outside
# ---------------------------------------------------------------------------
create_array(v_map, 868)
create_array(v_orig, 868)

def set_row(v_m, v_r, v_lo, v_hi) {
    for v_k in (0, 13, 1)
        v_d = v_lo % 10
        v_m[v_r * 28 + 13 - v_k] = v_d
        v_lo = (v_lo - v_d) // 10
        v_d = v_hi % 10
        v_m[v_r * 28 + 27 - v_k] = v_d
        v_hi = (v_hi - v_d) // 10
    endfor v_k
}

call set_row(v_map, 0, 11111111111111, 11111111111111)    # ############################
call set_row(v_map, 1, 12222222222221, 12222222222221)    # #............##............#
call set_row(v_map, 2, 12111121111121, 12111112111121)    # #.####.#####.##.#####.####.#
call set_row(v_map, 3, 13111121111121, 12111112111131)    # #o####.#####.##.#####.####o#
call set_row(v_map, 4, 12111121111121, 12111112111121)    # #.####.#####.##.#####.####.#
call set_row(v_map, 5, 12222222222222, 22222222222221)    # #..........................#
call set_row(v_map, 6, 12111121121111, 11112112111121)    # #.####.##.########.##.####.#
call set_row(v_map, 7, 12111121121111, 11112112111121)    # #.####.##.########.##.####.#
call set_row(v_map, 8, 12222221122221, 12222112222221)    # #......##....##....##......#
call set_row(v_map, 9, 11111121111101, 10111112111111)    # ######.##### ## #####.######
call set_row(v_map, 10, 88888121111101, 10111112188888)    # xxxxx#.##### ## #####.#xxxxx
call set_row(v_map, 11, 88888121100000, 112188888)    # xxxxx#.##          ##.#xxxxx
call set_row(v_map, 12, 88888121101114, 41110112188888)    # xxxxx#.## ###--### ##.#xxxxx
call set_row(v_map, 13, 11111121101666, 66610112111111)    # ######.## #hhhhhh# ##.######
call set_row(v_map, 14, 20001666, 66610002000000)    #       .   #hhhhhh#   .      
call set_row(v_map, 15, 11111121101666, 66610112111111)    # ######.## #hhhhhh# ##.######
call set_row(v_map, 16, 88888121101111, 11110112188888)    # xxxxx#.## ######## ##.#xxxxx
call set_row(v_map, 17, 88888121100000, 112188888)    # xxxxx#.##          ##.#xxxxx
call set_row(v_map, 18, 88888121101111, 11110112188888)    # xxxxx#.## ######## ##.#xxxxx
call set_row(v_map, 19, 11111121101111, 11110112111111)    # ######.## ######## ##.######
call set_row(v_map, 20, 12222222222221, 12222222222221)    # #............##............#
call set_row(v_map, 21, 12111121111121, 12111112111121)    # #.####.#####.##.#####.####.#
call set_row(v_map, 22, 12111121111121, 12111112111121)    # #.####.#####.##.#####.####.#
call set_row(v_map, 23, 13221122222220, 2222222112231)    # #o..##.......  .......##..o#
call set_row(v_map, 24, 11121121121111, 11112112112111)    # ###.##.##.########.##.##.###
call set_row(v_map, 25, 11121121121111, 11112112112111)    # ###.##.##.########.##.##.###
call set_row(v_map, 26, 12222221122221, 12222112222221)    # #......##....##....##......#
call set_row(v_map, 27, 12111111111121, 12111111111121)    # #.##########.##.##########.#
call set_row(v_map, 28, 12111111111121, 12111111111121)    # #.##########.##.##########.#
call set_row(v_map, 29, 12222222222222, 22222222222221)    # #..........................#
call set_row(v_map, 30, 11111111111111, 11111111111111)    # ############################

v_dots_total = 0
for v_i in (0, 867, 1)
    v_orig[v_i] = v_map[v_i]
    if v_map[v_i] == 2 or v_map[v_i] == 3 then
        v_dots_total = v_dots_total + 1
    endif
endfor v_i

# Neighbour table: v_nb[tile * 4 + dir] is the next walkable tile or -1.
# Row 14 wraps through the tunnel.
create_array(v_nb, 3472)
for v_r in (0, 30, 1)
    for v_c in (0, 27, 1)
        v_t = v_r * 28 + v_c
        v_code0 = v_map[v_t]
        for v_d in (0, 3, 1)
            v_nb[v_t * 4 + v_d] = -1
            v_nc = (v_c + v_dx4[v_d]) % 28
            v_nr = v_r + v_dy4[v_d]
            if v_nr >= 0 and v_nr <= 30 and v_code0 != 1 and v_code0 != 4 and v_code0 < 6 then
                v_code = v_map[v_nr * 28 + v_nc]
                if v_code == 0 or v_code == 2 or v_code == 3 then
                    v_nb[v_t * 4 + v_d] = v_nr * 28 + v_nc
                endif
            endif
        endfor v_d
    endfor v_c
endfor v_r

# ---------------------------------------------------------------------------
# Wall art. Solid tiles are shrunk 2px away from every corridor; the edge of
# what is left is the wall line. Convex corners lose one pixel so they round.
# ---------------------------------------------------------------------------
create_array(v_ts, 868)
for v_i in (0, 867, 1)
    v_ts[v_i] = 0
    if v_map[v_i] == 1 or v_map[v_i] == 4 or v_map[v_i] >= 6 then
        v_ts[v_i] = 1
    endif
endfor v_i

# v_qc, v_qr -> v_open (1 = corridor). Off the map is solid except the tunnel row.
def tile_open {
    if v_qr < 0 or v_qr > 30 or v_qc < 0 or v_qc > 27 then
        v_open = 0
        if v_qr == 14 then
            v_open = 1
        endif
    else
        v_open = 1 - v_ts[v_qr * 28 + v_qc]
    endif
}

create_array(v_pk, 13888)
for v_r in (0, 30, 1)
    for v_c in (0, 27, 1)
        if v_ts[v_r * 28 + v_c] == 1 then
            v_qc = v_c - 1
            v_qr = v_r
            call tile_open
            v_oL = v_open
            v_qc = v_c + 1
            call tile_open
            v_oR = v_open
            v_qc = v_c
            v_qr = v_r - 1
            call tile_open
            v_oU = v_open
            v_qr = v_r + 1
            call tile_open
            v_oD = v_open
            v_qc = v_c - 1
            v_qr = v_r - 1
            call tile_open
            v_oUL = v_open
            v_qc = v_c + 1
            call tile_open
            v_oUR = v_open
            v_qr = v_r + 1
            call tile_open
            v_oDR = v_open
            v_qc = v_c - 1
            call tile_open
            v_oDL = v_open
            for v_j in (0, 3, 1)
                for v_i in (0, 3, 1)
                    v_k = 1
                    if v_oL == 1 and v_i <= 1 then
                        v_k = 0
                    endif
                    if v_oR == 1 and v_i >= 2 then
                        v_k = 0
                    endif
                    if v_oU == 1 and v_j <= 1 then
                        v_k = 0
                    endif
                    if v_oD == 1 and v_j >= 2 then
                        v_k = 0
                    endif
                    if v_oUL == 1 and v_i + v_j <= 1 then
                        v_k = 0
                    endif
                    if v_oUR == 1 and 3 - v_i + v_j <= 1 then
                        v_k = 0
                    endif
                    if v_oDL == 1 and v_i + 3 - v_j <= 1 then
                        v_k = 0
                    endif
                    if v_oDR == 1 and 6 - v_i - v_j <= 1 then
                        v_k = 0
                    endif
                    v_pk[(v_r * 4 + v_j) * 112 + v_c * 4 + v_i] = v_k
                endfor v_i
            endfor v_j
        endif
    endfor v_c
endfor v_r

# v_qx, v_qy -> v_kv (kept-pixel lookup with the off-map rule)
def pk_at {
    if v_qx < 0 or v_qx > 111 or v_qy < 0 or v_qy > 123 then
        v_kv = 1
        if v_qy // 4 == 14 then
            v_kv = 0
        endif
    else
        v_kv = v_pk[v_qy * 112 + v_qx]
    endif
}

create_array(v_po, 13888)
for v_y in (0, 123, 1)
    for v_x in (0, 111, 1)
        v_po[v_y * 112 + v_x] = 0
        if v_pk[v_y * 112 + v_x] == 1 then
            v_qx = v_x - 1
            v_qy = v_y
            call pk_at
            v_kL = v_kv
            v_qx = v_x + 1
            call pk_at
            v_kR = v_kv
            v_qx = v_x
            v_qy = v_y - 1
            call pk_at
            v_kU = v_kv
            v_qy = v_y + 1
            call pk_at
            v_kD = v_kv
            v_edge = 0
            if v_kL == 0 or v_kR == 0 or v_kU == 0 or v_kD == 0 then
                v_edge = 1
            else
                v_qx = v_x - 1
                v_qy = v_y - 1
                call pk_at
                v_edge = 1 - v_kv
                v_qx = v_x + 1
                call pk_at
                v_edge = v_edge + 1 - v_kv
                v_qy = v_y + 1
                call pk_at
                v_edge = v_edge + 1 - v_kv
                v_qx = v_x - 1
                call pk_at
                v_edge = v_edge + 1 - v_kv
            endif
            if v_edge > 0 then
                v_po[v_y * 112 + v_x] = 1
                if v_kL == 0 and v_kU == 0 then
                    v_po[v_y * 112 + v_x] = 0
                endif
                if v_kR == 0 and v_kU == 0 then
                    v_po[v_y * 112 + v_x] = 0
                endif
                if v_kL == 0 and v_kD == 0 then
                    v_po[v_y * 112 + v_x] = 0
                endif
                if v_kR == 0 and v_kD == 0 then
                    v_po[v_y * 112 + v_x] = 0
                endif
            endif
        endif
    endfor v_x
endfor v_y

# Cel 0: blue walls and the white gate. Cel 1: white walls (level-clear flash).
define_sprite(maze, 112, 124)
    sprite_cel(0)
    for v_y in (0, 123, 1)
        for v_x in (0, 111, 1)
            if v_po[v_y * 112 + v_x] == 1 then
                plot(v_x, v_y, blue, 100)
            endif
        endfor v_x
    endfor v_y
    draw_line(52, 50, 59, 50, white, 100)
    sprite_cel(1)
    for v_y in (0, 123, 1)
        for v_x in (0, 111, 1)
            if v_po[v_y * 112 + v_x] == 1 then
                plot(v_x, v_y, white, 100)
            endif
        endfor v_x
    endfor v_y
endsprite

# ---------------------------------------------------------------------------
# Sprites
# ---------------------------------------------------------------------------
