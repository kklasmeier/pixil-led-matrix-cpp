# ---------------- Current tube ----------------
v_np = 16                       # points on the current tube
create_array(v_wx, 16, numeric)
create_array(v_wy, 16, numeric)
create_array(v_rx, 16, numeric) # projected rim / far points (per frame)
create_array(v_ry, 16, numeric)
create_array(v_fx, 16, numeric)
create_array(v_fy, 16, numeric)
v_S = 27
v_depth = 5
v_cam = 0
v_rot = 0
v_cyr = 32
v_cyf = 29

create_array(v_hues, 8, numeric)
v_hues[0] = 66
v_hues[1] = 0
v_hues[2] = 14
v_hues[3] = 50
v_hues[4] = 83
v_hues[5] = 33
v_hues[6] = 8
v_hues[7] = 60

def load_shape {
    v_shape = (v_level - 1) % v_nshapes
    v_closed = v_shclosed[v_shape]
    if v_closed == 1 then
        v_nl = 16
    else
        v_nl = 15
    endif
    for v_i in (0, 15, 1)
        v_wx[v_i] = v_shx[v_shape * 16 + v_i]
        v_wy[v_i] = v_shy[v_shape * 16 + v_i]
    endfor v_i
    v_cyr = 32
    v_cyf = 32 + v_shfar[v_shape]
    if v_closed == 0 then
        v_cyr = 30
    endif
    v_webh = v_hues[(v_level - 1) % 8]
    v_spin_h = (v_webh + 34) % 100
    v_carr_h = (v_webh + 14) % 100
}

# point v_pp at depth v_pd -> v_ox, v_oy (v_ok = 0 if behind the camera)
def proj {
    v_oz = 1 + v_pd * v_depth - v_cam
    v_ok = 1
    if v_oz < 0.18 then
        v_oz = 0.18
        v_ok = 0
    endif
    v_s = v_S / v_oz
    v_ax = v_wx[v_pp]
    v_ay = v_wy[v_pp]
    if v_rot != 0 then
        v_rt = v_ax * v_rc - v_ay * v_rs
        v_ay = v_ax * v_rs + v_ay * v_rc
        v_ax = v_rt
    endif
    v_ox = 32 + v_ax * v_s
    v_oy = v_cyr + (v_cyf - v_cyr) * (1 - 1 / v_oz) + v_ay * v_s
}

# centre of lane v_ll at depth v_pd -> v_lx, v_ly, and lane width v_lw
def lane_pt {
    v_pp = v_ll
    call proj
    v_l1x = v_ox
    v_l1y = v_oy
    v_pp = (v_ll + 1) % v_np
    call proj
    v_lx = (v_l1x + v_ox) / 2
    v_ly = (v_l1y + v_oy) / 2
    v_lw = abs(v_ox - v_l1x) + abs(v_oy - v_l1y)
}

def draw_web {
    v_rc = cos(v_rot)
    v_rs = sin(v_rot)
    # near edge: the rim, or as close as the camera allows during a warp
    v_dn = max(0, (v_cam - 1 + 0.25) / v_depth)
    for v_p in (0, v_np - 1, 1)
        v_pp = v_p
        v_pd = v_dn
        call proj
        v_rx[v_p] = v_ox
        v_ry[v_p] = v_oy
        v_pd = 1
        call proj
        v_fx[v_p] = v_ox
        v_fy[v_p] = v_oy
        v_fok = v_ok
    endfor v_p
    if v_fok == 1 then
        for v_p in (0, v_np - 1, 1)
            draw_line(v_rx[v_p], v_ry[v_p], v_fx[v_p], v_fy[v_p], v_webh, v_webb * 0.55)
        endfor v_p
        for v_p in (0, v_nl - 1, 1)
            v_q = (v_p + 1) % v_np
            draw_line(v_fx[v_p], v_fy[v_p], v_fx[v_q], v_fy[v_q], v_webh, v_webb * 0.45)
            draw_line(v_rx[v_p], v_ry[v_p], v_rx[v_q], v_ry[v_q], v_webh, v_webb)
        endfor v_p
    endif
}

# ---------------- Big vector logo ----------------
create_array(v_gx1, 40, numeric)
