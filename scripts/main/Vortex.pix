# logo centred at (32, v_ly0), scale v_lsc, hue v_lh
def draw_logo {
    for v_i in (0, v_ng - 1, 1)
        v_c = floor(v_lh + v_i * 1.5) % 100
        draw_line(32 + (v_gx1[v_i] - 29) * v_lsc, v_ly0 + (v_gy1[v_i] - 5) * v_lsc, 32 + (v_gx2[v_i] - 29) * v_lsc, v_ly0 + (v_gy2[v_i] - 5) * v_lsc, v_c, 100)
    endfor v_i
}

