# VORTEX - a vector tube shooter in the spirit of the 1980s arcade classics
#
# An attract-mode game that plays itself, with the full arcade flow:
#   1. Title screen: the VORTEX logo zooms out of a spinning tube, then the
#      high score table, then "PRESS START".
#   2. The game: an AI pilot rides the rim of a glowing vector tube,
#      sliding from lane to lane and firing down into it. Enemies climb up
#      out of the depths:
#        - Spinners (red triangles) climb and hop between lanes. When they
#          reach the rim they crawl along it toward the ship and grab it.
#        - Carriers (violet diamonds) split into two spinners when hit or
#          when they reach the top.
#        - Weavers (green spirals) climb part way, leave a spike in the lane,
#          then sink back down. Shots chip spikes shorter.
#      Spinners also fire up their lane. Once per level the ship can fire a
#      zapper that wipes every enemy on the tube.
#      Clear a level and the ship warps down the tube (don't hit a spike!)
#      into the next shape: circle, square, plus, hourglass, star,
#      triangle, then open shapes - flat, vee, cup and steps. Each level is
#      faster than the last.
#   3. Game over screen: final score, then the high score table with the new
#      entry flashing. Then back to the title.
#
# Original designs throughout; the tubes, ships and enemies are this
# script's own.

fps(30)
throttle(0)

# ---------------- Settings ----------------
v_start_lives = 3
v_title_frames = 300   # length of the title / attract screens
v_ai_skill = 0.9      # 0..1: how sharp the AI pilot is (lower = shorter games)

